---
// Home da CR INTERMEDIAÇÕES IMOBILIÁRIAS — servida em crintermediacao.com.br.
//
// Fica no mesmo projeto do portal de propósito: um deploy só, um lugar só para
// mexer. Quem manda o visitante para cá é o middleware, que reescreve "/" deste
// domínio para esta página. A marca aqui é SÓ a CR — nada de Costa Júnior.
//
// A faixa "Negócios realizados" é automática: puxa os imóveis marcados como
// VENDIDO no módulo Novos Negócios e usa a foto de capa de cada um. Se não
// houver nenhum vendido ainda, a seção simplesmente não aparece.
import { supabaseAdmin } from "../lib/supabase";
import { BUCKET_NEGOCIOS, storageNegocios } from "../lib/negocios";
import { INTERMEDIARIO, CONTATO_TELEFONE } from "../lib/termoVenda";

export const prerender = false;

const WHATS = CONTATO_TELEFONE.replace(/\D/g, "");   // 5511917323082
const LINK_FORM = "/autorizacao";

type Vendido = { titulo: string; local: string; area: string; foto: string | null };
let vendidos: Vendido[] = [];
try {
  const db = supabaseAdmin();
  const { data: itens } = await db.from("negocios_imoveis")
    .select("id, titulo, bairro, cidade, uf, area_total, capa_anexo_id, tipo")
    .in("tipo", ["terreno", "empreendimento"])
    .eq("status", "vendido").eq("ativo", true)
    .order("updated_at", { ascending: false }).limit(12);

  const capas = (itens || []).map((i: any) => i.capa_anexo_id).filter(Boolean);
  const caminho: Record<string, string> = {};
  if (capas.length) {
    const { data: anexos } = await db.from("negocios_anexos").select("id, storage_path").in("id", capas);
    for (const a of anexos || []) caminho[(a as any).id] = (a as any).storage_path;
  }

  // bucket é privado: assina cada capa por 1 hora, na hora de desenhar a página
  for (const i of itens || []) {
    let foto: string | null = null;
    const path = i.capa_anexo_id ? caminho[i.capa_anexo_id] : null;
    if (path) {
      const { data: url } = await storageNegocios().storage.from(BUCKET_NEGOCIOS).createSignedUrl(path, 3600);
      foto = url?.signedUrl || null;
    }
    // só bairro e cidade — endereço exato de imóvel vendido não vai para a rua
    const local = [i.bairro, [i.cidade, i.uf].filter(Boolean).join("/")].filter(Boolean).join(" — ");
    vendidos.push({
      titulo: i.titulo,
      local: local || "",
      area: i.area_total ? `${Number(i.area_total).toLocaleString("pt-BR")} m²` : "",
      foto,
    });
  }
  vendidos = vendidos.filter((v) => v.foto);   // sem foto não entra na vitrine
} catch { vendidos = []; }
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CR Intermediações Imobiliárias — terrenos, empreendimentos e busca de imóveis</title>
  <meta name="description" content="Intermediação de venda de terrenos e empreendimentos e busca de imóveis sob medida. Avaliação sem compromisso e acompanhamento até a escritura." />
  <link rel="canonical" href="https://crintermediacao.com.br/" />
  <link rel="icon" href="/logo-cr.png" />
  <meta property="og:title" content="CR Intermediações Imobiliárias" />
  <meta property="og:description" content="Venda de terrenos e empreendimentos. Busca de imóveis sob medida." />
  <meta property="og:image" content="https://crintermediacao.com.br/logo-cr.png" />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Montserrat:wght@600;700&family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    :root { --ouro:#B8912F; --ouro-esc:#8F6F1F; --ouro-cl:#E0BE63; --lilas:#6F6280; --claro:#F7F5F9; --borda:#E4DEEA; }
    * { box-sizing:border-box; }
    body { margin:0; background:#fff; color:#3B3542; font-family:'Open Sans',Arial,sans-serif; line-height:1.6; }
    a { color:inherit; }
    .wrap { max-width:1040px; margin:0 auto; padding:0 20px; }

    /* ── topo ── */
    .topo { background:linear-gradient(135deg,#8A7C9A 0%,#9C8DAC 45%,#6F6280 100%); color:#fff; text-align:center;
            padding:44px 20px 52px; border-bottom:3px solid var(--ouro); }
    .topo img { height:132px; border-radius:14px; filter:drop-shadow(0 10px 26px rgba(0,0,0,.28)); }
    .topo h1 { font-family:'Cormorant Garamond',Georgia,serif; font-size:2.1rem; margin:16px 0 4px; font-weight:700; letter-spacing:.5px; }
    .topo .tag { font-family:'Montserrat',sans-serif; font-size:.72rem; letter-spacing:3px; text-transform:uppercase; color:#EDE6F3; margin:0; }
    .topo p.lead { max-width:620px; margin:18px auto 0; color:#F4F0F8; font-size:1.02rem; }
    .cta { display:inline-block; margin-top:24px; padding:14px 30px; border-radius:999px; text-decoration:none; font-weight:700;
           font-family:'Montserrat',sans-serif; font-size:.94rem; background:linear-gradient(135deg,#E2C169,#B8912F); color:#3A2E08;
           box-shadow:0 6px 18px rgba(0,0,0,.22); }
    .cta.secundario { background:transparent; color:#fff; border:1.5px solid rgba(255,255,255,.7); box-shadow:none; margin-left:10px; }

    /* ── seções ── */
    section { padding:52px 0; }
    section.cinza { background:var(--claro); }
    h2 { font-family:'Cormorant Garamond',Georgia,serif; font-size:1.8rem; color:var(--ouro-esc); margin:0 0 6px; text-align:center; }
    .sub { text-align:center; color:var(--lilas); margin:0 auto 30px; max-width:620px; }
    .tres { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:20px; }
    .box { background:#fff; border:1px solid var(--borda); border-radius:14px; padding:24px; }
    .box h3 { font-family:'Montserrat',sans-serif; font-size:1rem; color:var(--ouro-esc); margin:0 0 8px; }
    .box p { margin:0; font-size:.93rem; color:#5A5265; }

    /* ── vitrine de vendidos ── */
    .vitrine { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:18px; }
    .imovel { position:relative; border-radius:14px; overflow:hidden; border:1px solid var(--borda); background:#fff; }
    .imovel img { width:100%; height:190px; object-fit:cover; display:block; }
    .imovel .info { padding:14px 16px 16px; }
    .imovel .info strong { display:block; font-size:.95rem; }
    .imovel .info span { font-size:.84rem; color:var(--lilas); }
    /* a tarja: faixa diagonal no canto, como carimbo */
    .tarja { position:absolute; top:16px; right:-42px; transform:rotate(38deg); width:170px; text-align:center;
             background:linear-gradient(135deg,#C9302C,#8E1B18); color:#fff; font-family:'Montserrat',sans-serif;
             font-size:.74rem; font-weight:700; letter-spacing:2.4px; padding:6px 0; box-shadow:0 3px 10px rgba(0,0,0,.3); }

    /* ── passos ── */
    .passos { counter-reset:p; display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:22px; }
    .passo { position:relative; padding-left:52px; }
    .passo::before { counter-increment:p; content:counter(p); position:absolute; left:0; top:0; width:38px; height:38px;
                     border-radius:50%; background:linear-gradient(135deg,#E2C169,#B8912F); color:#3A2E08;
                     font-family:'Montserrat',sans-serif; font-weight:700; display:flex; align-items:center; justify-content:center; }
    .passo h3 { font-family:'Montserrat',sans-serif; font-size:.95rem; margin:6px 0 4px; }
    .passo p { margin:0; font-size:.9rem; color:#5A5265; }

    /* ── contato ── */
    .contato { background:linear-gradient(135deg,#8A7C9A,#6F6280); color:#fff; text-align:center; }
    .contato h2 { color:#F0DFAE; }
    .contato .sub { color:#EDE6F3; }
    .rodape { text-align:center; font-size:.78rem; color:var(--lilas); padding:26px 20px 40px; }

    @media (max-width:640px) { .topo h1 { font-size:1.7rem; } .cta.secundario { margin:10px 0 0; } }
  </style>
</head>
<body>
  <header class="topo">
    <img src="/logo-cr.png" alt="CR Intermediações Imobiliárias" />
    <h1>CR Intermediações Imobiliárias</h1>
    <p class="tag">Terrenos · Empreendimentos · Busca de imóveis</p>
    <p class="lead">
      Intermediamos a venda do seu terreno ou empreendimento e procuramos o imóvel certo
      para quem quer comprar. Avaliação sem compromisso e acompanhamento até a escritura.
    </p>
    <div>
      <a class="cta" href={LINK_FORM}>Quero anunciar meu imóvel</a>
      <a class="cta secundario" href={`https://wa.me/${WHATS}`} target="_blank" rel="noopener">Falar no WhatsApp</a>
    </div>
  </header>

  <section>
    <div class="wrap">
      <h2>O que fazemos</h2>
      <p class="sub">Três frentes, um mesmo cuidado: entender o imóvel, achar o comprador certo e fechar com segurança jurídica.</p>
      <div class="tres">
        <div class="box">
          <h3>Venda de terrenos</h3>
          <p>Avaliação, documentação, anúncio e negociação. Cuidamos da matrícula, do IPTU e das certidões antes de o terreno ir ao mercado — comprador informado decide mais rápido.</p>
        </div>
        <div class="box">
          <h3>Venda de empreendimentos</h3>
          <p>Unidades e empreendimentos inteiros, com material de apresentação, controle do que já foi vendido e acompanhamento de cada proposta até a assinatura.</p>
        </div>
        <div class="box">
          <h3>Busca de imóveis</h3>
          <p>Você diz o perfil, a região e a faixa de valor; nós procuramos, filtramos e apresentamos só o que faz sentido — inclusive imóveis que ainda não estão anunciados.</p>
        </div>
      </div>
    </div>
  </section>

  {vendidos.length > 0 && (
    <section class="cinza">
      <div class="wrap">
        <h2>Negócios realizados</h2>
        <p class="sub">Alguns imóveis que passaram por nós, da captação à escritura.</p>
        <div class="vitrine">
          {vendidos.map((v) => (
            <div class="imovel">
              <span class="tarja">VENDIDO</span>
              <img src={v.foto} alt={v.titulo} loading="lazy" />
              <div class="info">
                <strong>{v.titulo}</strong>
                <span>{[v.local, v.area].filter(Boolean).join(" · ")}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section>
    <div class="wrap">
      <h2>Como funciona</h2>
      <p class="sub">Do primeiro contato até a venda, sem burocracia da sua parte.</p>
      <div class="passos">
        <div class="passo">
          <h3>Você preenche a autorização</h3>
          <p>Um formulário de três minutos com seus dados e os do imóvel. Sem prazo de fidelidade: vale até você pedir o cancelamento.</p>
        </div>
        <div class="passo">
          <h3>Avaliamos e anunciamos</h3>
          <p>Visitamos, tiramos fotos, organizamos a documentação e colocamos o imóvel nos canais certos.</p>
        </div>
        <div class="passo">
          <h3>Levamos as propostas a você</h3>
          <p>Fazemos a triagem dos interessados e conduzimos as tratativas. Nenhum valor é fechado sem a sua aprovação.</p>
        </div>
        <div class="passo">
          <h3>Acompanhamos até o fim</h3>
          <p>Contrato, certidões, financiamento e escritura, com você informado em cada etapa.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="contato">
    <div class="wrap">
      <h2>Vamos conversar sobre o seu imóvel</h2>
      <p class="sub">Avaliação sem compromisso. Responda em minutos pelo WhatsApp ou preencha a autorização de venda.</p>
      <a class="cta" href={`https://wa.me/${WHATS}`} target="_blank" rel="noopener">WhatsApp {CONTATO_TELEFONE}</a>
      <a class="cta secundario" href={LINK_FORM}>Autorização de venda</a>
    </div>
  </section>

  <p class="rodape">{INTERMEDIARIO} · {CONTATO_TELEFONE}</p>
</body>
</html>
