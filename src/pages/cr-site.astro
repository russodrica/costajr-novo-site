    /* ── frentes de negócio ── */
    .grid-neg { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:20px; }
    .neg { border-radius:var(--raio); overflow:hidden; background:var(--papel);
           border:1px solid var(--linha); display:flex; flex-direction:column;
           transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
    .neg:hover { transform:translateY(-5px); border-color:var(--ouro-cl); box-shadow:0 22px 50px rgba(30,24,38,.13); }
    .neg-foto { position:relative; height:180px; overflow:hidden;
                background:linear-gradient(135deg,#F3EBD8 0%,#E9E2EE 60%,#F7F1E4 100%); }
    .neg-foto img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .6s ease; }
    .neg:hover .neg-foto img { transform:scale(1.06); }
