    /* ── faixa de imagem larga ── */
    .faixa-foto { position:relative; padding:0; min-height:420px; display:flex; align-items:center;
                  overflow:hidden; background:linear-gradient(135deg,#2A2333,#463C55); }
    .faixa-foto > img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
    .faixa-foto.sem-img > img { display:none; }
    .faixa-foto::after { content:""; position:absolute; inset:0;
      background:linear-gradient(90deg, rgba(16,13,20,.92) 0%, rgba(16,13,20,.74) 45%, rgba(16,13,20,.34) 100%); }
    .faixa-txt { position:relative; z-index:1; max-width:600px;
                 margin-left:max(24px,calc((100vw - 1080px)/2 + 24px)); padding:70px 24px 70px 0; color:#fff; }
    .faixa-txt h2 { color:#fff; font-size:clamp(1.8rem,3.6vw,2.7rem); }
    .faixa-txt .lead { color:rgba(255,255,255,.82) !important; margin-top:16px; }

    /* ── método ── */
    .metodo { background:linear-gradient(160deg,#282232,#17141D); color:rgba(255,255,255,.8); }
    .grid-met { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:26px; }
    .met { position:relative; }
