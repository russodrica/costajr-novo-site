    .ic { display:inline-flex; align-items:center; justify-content:center; width:44px; height:44px;
          border-radius:12px; background:var(--ouro-pale); color:var(--ouro); margin-bottom:14px; }
    .ic svg { width:22px; height:22px; }
    .ic-claro { background:rgba(232,206,132,.12); color:#E8CE84; }
