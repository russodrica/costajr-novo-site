    .met p { font-size:.91rem; margin:0; color:rgba(255,255,255,.68); }

    /* ── vitrine ── */
    .vitrine { display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:18px; }
    .imovel { position:relative; margin:0; border:1px solid var(--linha); border-radius:var(--raio); overflow:hidden; background:var(--papel); }
    .imovel img { width:100%; height:180px; object-fit:cover; display:block; }
