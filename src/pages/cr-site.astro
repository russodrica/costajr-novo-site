---
// Home da CR — servida em crintermediacao.com.br (o middleware reescreve "/").
//
// Três portas de entrada, que é como o negócio funciona de verdade:
//   1. quem TEM imóvel para vender      → /cr        (autorização de venda)
//   2. quem QUER INVESTIR               → /investidor
//   3. quem PROCURA imóvel              → /procuro
//
// A faixa "Negócios realizados" é automática: puxa os imóveis marcados como
// VENDIDO no módulo Novos Negócios. Sem nenhum vendido, a seção não aparece.
import CR from "../layouts/CR.astro";
import { supabaseAdmin } from "../lib/supabase";
import { BUCKET_NEGOCIOS, storageNegocios } from "../lib/negocios";
import { CONTATO_TELEFONE } from "../lib/termoVenda";

export const prerender = false;
const WHATS = CONTATO_TELEFONE.replace(/\D/g, "");

type Vendido = { titulo: string; local: string; area: string; foto: string };
let vendidos: Vendido[] = [];
try {
  const db = supabaseAdmin();
  const { data: itens } = await db.from("negocios_imoveis")
    .select("id, titulo, bairro, cidade, uf, area_total, capa_anexo_id")
    .in("tipo", ["terreno", "empreendimento"])
    .eq("status", "vendido").eq("ativo", true)
    .order("updated_at", { ascending: false }).limit(8);

  const capas = (itens || []).map((i: any) => i.capa_anexo_id).filter(Boolean);
  const caminho: Record<string, string> = {};
  if (capas.length) {
    const { data: anexos } = await db.from("negocios_anexos").select("id, storage_path").in("id", capas);
    for (const a of anexos || []) caminho[(a as any).id] = (a as any).storage_path;
  }
  for (const i of itens || []) {
    const path = i.capa_anexo_id ? caminho[i.capa_anexo_id] : null;
    if (!path) continue;
    const { data: url } = await storageNegocios().storage.from(BUCKET_NEGOCIOS).createSignedUrl(path, 3600);
    if (!url?.signedUrl) continue;
    // só bairro e cidade — endereço exato de imóvel vendido não vai para a rua
    vendidos.push({
      titulo: i.titulo,
      local: [i.bairro, [i.cidade, i.uf].filter(Boolean).join("/")].filter(Boolean).join(" — "),
      area: i.area_total ? `${Number(i.area_total).toLocaleString("pt-BR")} m²` : "",
      foto: url.signedUrl,
    });
  }
} catch { vendidos = []; }

const LINHAS = [
  {
    n: "01", titulo: "Tenho um imóvel para vender",
    texto: "Terreno, área ou empreendimento. Avaliamos, organizamos a documentação, anunciamos e conduzimos a negociação até a escritura. Sem prazo de fidelidade: a autorização vale até você pedir o cancelamento.",
    cta: "Cadastrar meu imóvel", href: "/cr",
  },
  {
    n: "02", titulo: "Quero investir em imóveis",
    texto: "Diga seu perfil — tipo de operação, região, faixa de investimento e prazo — e passamos a te apresentar as oportunidades que batem com ele, muitas antes de irem ao mercado.",
    cta: "Quero receber oportunidades", href: "/investidor",
  },
  {
    n: "03", titulo: "Procuro um imóvel",
    texto: "Você descreve o que precisa e nós procuramos, filtramos e apresentamos só o que faz sentido — inclusive imóveis que ainda não estão anunciados em lugar nenhum.",
    cta: "Descrever o que procuro", href: "/procuro",
  },
];

const PASSOS = [
  ["Conversa inicial", "Entendemos o imóvel ou o objetivo. Sem compromisso e sem custo."],
  ["Análise e documentação", "Matrícula, IPTU, certidões e zoneamento conferidos antes de qualquer anúncio."],
  ["Apresentação ao mercado certo", "O imóvel vai para quem tem perfil de compra, não para uma vitrine genérica."],
  ["Negociação e escritura", "Conduzimos as propostas. Nenhum valor é fechado sem a sua aprovação."],
];
---
<CR titulo="CR Intermediações Imobiliárias — terrenos, empreendimentos e investimento imobiliário" capa={true}>

  <!-- ── capa ───────────────────────────────────────────────────────────── -->
  <header class="capa">
    <div class="capa-arte" aria-hidden="true">
      <!-- desenho de lotes: geometria original em SVG, nada de foto de banco de
           imagens. Fica leve, nítido em qualquer tela e é nosso. -->
      <svg viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="g1" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#F7EFE0" /><stop offset="100%" stop-color="#EFE9F2" />
          </linearGradient>
          <pattern id="grade" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M40 0H0V40" fill="none" stroke="#D9B95F" stroke-width=".5" opacity=".22" />
          </pattern>
        </defs>
        <rect width="1200" height="700" fill="url(#g1)" />
        <rect width="1200" height="700" fill="url(#grade)" />
        <g fill="none" stroke="#A8842A" stroke-width="1.1" opacity=".3">
          <path d="M120 620 L300 470 L560 520 L720 400 L980 440 L1120 330" />
          <path d="M60 540 L260 400 L520 450 L700 320 L960 360 L1160 250" />
          <path d="M300 470 L260 400 M560 520 L520 450 M720 400 L700 320 M980 440 L960 360" />
        </g>
        <g fill="none" stroke="#A8842A" opacity=".5">
          <rect x="150" y="150" width="150" height="110" stroke-width=".9" />
          <rect x="310" y="150" width="110" height="110" stroke-width=".9" />
          <rect x="150" y="270" width="270" height="90" stroke-width=".9" />
          <rect x="800" y="180" width="130" height="130" stroke-width=".9" />
          <rect x="940" y="180" width="180" height="130" stroke-width=".9" />
          <rect x="800" y="320" width="320" height="80" stroke-width=".9" />
        </g>
        <g fill="#A8842A" opacity=".55">
          <circle cx="150" cy="150" r="3" /><circle cx="420" cy="360" r="3" />
          <circle cx="1120" cy="180" r="3" /><circle cx="800" cy="400" r="3" />
        </g>
      </svg>
    </div>

    <div class="capa-conteudo">
      <img class="medalha" src="/logo-cr-transp.png" alt="CR Intermediações Imobiliárias" />
      <p class="rotulo" style="margin-top:22px">CR Intermediações Imobiliárias</p>
      <h1>O imóvel certo<br />encontra quem sabe o que procura.</h1>
      <p class="lead" style="max-width:620px;margin:18px auto 0">
        Intermediação de terrenos e empreendimentos, busca sob medida e oportunidades
        para investidores — com documentação conferida antes de qualquer conversa de preço.
      </p>
      <div class="capa-botoes">
        <a class="btn btn-ouro" href="#linhas">Como podemos ajudar</a>
        <a class="btn btn-linha" href={`https://wa.me/${WHATS}`} target="_blank" rel="noopener">Falar no WhatsApp</a>
      </div>
    </div>
    <a class="rolar" href="#linhas" aria-label="Ver mais">⌄</a>
  </header>

  <!-- ── três linhas ────────────────────────────────────────────────────── -->
  <section id="linhas">
    <div class="wrap">
      <div class="centro rev">
        <p class="rotulo">Por onde você começa</p>
        <h2>Três caminhos, um mesmo cuidado</h2>
        <div class="filete"></div>
      </div>
      <div class="grid3">
        {LINHAS.map((l) => (
          <article class="cartao linha rev">
            <span class="num">{l.n}</span>
            <h3>{l.titulo}</h3>
            <p style="color:var(--tinta-md);font-size:.95rem">{l.texto}</p>
            <a class="seta" href={l.href}>{l.cta} <span>→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── negócios realizados ────────────────────────────────────────────── -->
  {vendidos.length > 0 && (
    <section style="background:var(--papel);border-top:1px solid var(--linha);border-bottom:1px solid var(--linha)">
      <div class="wrap">
        <div class="centro rev">
          <p class="rotulo">Portfólio</p>
          <h2>Negócios realizados</h2>
          <div class="filete"></div>
        </div>
        <div class="vitrine">
          {vendidos.map((v) => (
            <figure class="imovel rev">
              <span class="tarja">Vendido</span>
              <img src={v.foto} alt={v.titulo} loading="lazy" />
              <figcaption>
                <strong>{v.titulo}</strong>
                <span>{[v.local, v.area].filter(Boolean).join(" · ")}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── como funciona ──────────────────────────────────────────────────── -->
  <section>
    <div class="wrap">
      <div class="centro rev">
        <p class="rotulo">Método</p>
        <h2>Como funciona</h2>
        <div class="filete"></div>
      </div>
      <ol class="passos">
        {PASSOS.map(([t, d], i) => (
          <li class="rev">
            <span class="passo-n">{String(i + 1).padStart(2, "0")}</span>
            <h3>{t}</h3>
            <p style="color:var(--tinta-md);font-size:.93rem;margin:0">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── chamada final ──────────────────────────────────────────────────── -->
  <section class="final">
    <div class="estreito centro rev">
      <p class="rotulo">Vamos conversar</p>
      <h2>Uma avaliação sincera, sem compromisso</h2>
      <p class="lead" style="margin:14px 0 26px">
        Conte o que você tem em mãos ou o que procura. Se não for um bom negócio,
        a gente diz isso também.
      </p>
      <div class="capa-botoes" style="justify-content:center">
        <a class="btn btn-ouro" href={`https://wa.me/${WHATS}`} target="_blank" rel="noopener">WhatsApp {CONTATO_TELEFONE}</a>
        <a class="btn btn-linha" href="/cr">Cadastrar meu imóvel</a>
      </div>
    </div>
  </section>

  <style is:global>
    /* ── capa ── */
    .capa { position:relative; min-height:92vh; display:flex; align-items:center; justify-content:center;
            text-align:center; overflow:hidden; padding:70px 24px 90px; }
    .capa-arte { position:absolute; inset:0; z-index:0; }
    .capa-arte svg { width:100%; height:100%; display:block; }
    .capa-arte::after { content:""; position:absolute; inset:0;
      background:radial-gradient(ellipse at 50% 45%, rgba(251,249,247,.92) 0%, rgba(251,249,247,.7) 45%, rgba(251,249,247,.95) 100%); }
    .capa-conteudo { position:relative; z-index:1; max-width:820px; }
    .medalha { width:176px; height:176px; filter:drop-shadow(0 14px 34px rgba(111,98,128,.28)); }
    .capa-botoes { display:flex; gap:12px; flex-wrap:wrap; justify-content:center; margin-top:30px; }
    .rolar { position:absolute; bottom:26px; left:50%; transform:translateX(-50%); z-index:1;
             font-size:1.5rem; color:var(--ouro); text-decoration:none; opacity:.7; }

    /* ── três linhas ── */
    .grid3 { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:20px; }
    .linha { display:flex; flex-direction:column; position:relative; padding-top:34px;
             transition:border-color .2s ease, transform .2s ease, box-shadow .2s ease; }
    .linha:hover { border-color:var(--ouro-cl); transform:translateY(-3px); box-shadow:0 14px 34px rgba(111,98,128,.09); }
    .linha .num { position:absolute; top:22px; right:26px; font-family:var(--serif); font-size:2.2rem;
                  color:var(--ouro-pale); line-height:1; }
    .linha h3 { margin-bottom:10px; max-width:80%; }
    .seta { margin-top:auto; padding-top:16px; text-decoration:none; color:var(--ouro);
            font-size:.9rem; font-weight:500; }
    .seta span { transition:margin .2s ease; display:inline-block; }
    .linha:hover .seta span { margin-left:5px; }

    /* ── vitrine ── */
    .vitrine { display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:18px; }
    .imovel { position:relative; margin:0; border:1px solid var(--linha); border-radius:var(--raio);
              overflow:hidden; background:var(--papel); }
    .imovel img { width:100%; height:180px; object-fit:cover; display:block; }
    .imovel figcaption { padding:14px 16px 16px; }
    .imovel figcaption strong { display:block; font-size:.95rem; }
    .imovel figcaption span { font-size:.82rem; color:var(--tinta-cl); }
    .tarja { position:absolute; top:14px; left:14px; background:rgba(38,34,43,.86); color:#F0DFAE;
             font-size:.66rem; font-weight:600; letter-spacing:.18em; text-transform:uppercase;
             padding:6px 12px; border-radius:999px; backdrop-filter:blur(4px); }

    /* ── passos ── */
    .passos { list-style:none; margin:0; padding:0; display:grid;
              grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:28px; }
    .passos li { border-top:1px solid var(--linha); padding-top:18px; }
    .passo-n { font-family:var(--serif); font-size:1.5rem; color:var(--ouro-cl); display:block; margin-bottom:6px; }
    .passos h3 { font-size:1.05rem; margin-bottom:6px; }

    .final { background:linear-gradient(180deg,var(--areia),#F4EFE6); border-top:1px solid var(--linha); }
  </style>
</CR>
