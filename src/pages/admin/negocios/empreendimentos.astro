---
import Admin from "../../../layouts/Admin.astro";
import NegociosCatalogo from "../../../components/NegociosCatalogo.astro";
import { verifyToken, type AdminClaims } from "../../../lib/auth";
import { supabaseAdmin } from "../../../lib/supabase";

const token = Astro.cookies.get("admin_token")?.value;
if (!token) return Astro.redirect("/admin/login");
let claims: AdminClaims;
try { claims = await verifyToken<AdminClaims>(token); if (claims.tipo !== "admin") throw new Error(); }
catch { Astro.cookies.delete("admin_token", { path: "/" }); return Astro.redirect("/admin/login"); }

const TIPO = "empreendimento" as const;
const filtroStatus = Astro.url.searchParams.get("status") || "todos";
const busca = Astro.url.searchParams.get("busca") || "";

const db = supabaseAdmin();
const { data: itens } = await db.from("negocios_imoveis").select("*").eq("tipo", TIPO).order("created_at", { ascending: false }).limit(500);
const ids = (itens || []).map((i: any) => i.id);
const { data: anexos } = ids.length
  ? await db.from("negocios_anexos").select("*").in("imovel_id", ids).order("created_at")
  : { data: [] as any[] };
const { data: oportunidades } = ids.length
  ? await db.from("negocios_oportunidades").select("*").in("imovel_id", ids).order("created_at", { ascending: false })
  : { data: [] as any[] };
const { data: conversas } = ids.length
  ? await db.from("negocios_conversas").select("*").in("imovel_id", ids).order("data", { ascending: false })
  : { data: [] as any[] };
const { data: proprietarios } = await db.from("negocios_proprietarios")
  .select("id, nome, cpf, telefone, email").neq("status", "arquivado").order("nome");
// nome de quem está logado — só para MOSTRAR no formulário; quem carimba o autor
// de verdade é o servidor, ao gravar a anotação
let usuario = claims.email || "";
try {
  const { data: prof } = await db.from("portal_profiles").select("display_name, full_name").eq("id", claims.sub).maybeSingle();
  usuario = prof?.display_name || prof?.full_name || usuario;
} catch { /* fica o e-mail */ }
---
<Admin title="Venda de Empreendimentos" current="negocios-empreendimentos">
  <NegociosCatalogo tipo={TIPO} itens={itens || []} anexos={anexos || []} oportunidades={oportunidades || []} conversas={conversas || []} proprietarios={proprietarios || []} usuario={usuario} filtroStatus={filtroStatus} busca={busca} />
</Admin>
