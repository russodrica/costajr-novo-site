---
// Situação Financeira v2 (grupo Diretoria, só admin por padrão) — 14/10/2026.
// Tela enxuta e de ESTÍMULO: painel com o que já foi eliminado, dívidas por tipo com proposta de quitação
// editável e "✓ Quitei", A reaver, plano de ação novo (v2) e protestos com contador de cancelados.
// Tabelas fin_sf_* (migrations 118, 119 e 120) + leitura AO VIVO da Vobi (receita média e fornecedores em aberto)
// pela API /api/admin/situacao-financeira/aovivo, com cache de 1 h no servidor; "Atualizar da Vobi" também chama
// /sincronizar (grava vencido / a vencer das dívidas ligadas a um fornecedor da Vobi).
// Regra da Adriana (14/10/2026): dívida = só o VENCIDO (com ou sem cobrança); o que vence depois é despesa
// COMPROMETIDA, mostrada à parte em cada aba (fora da dívida e da meta) e que ela pode cortar.
// Todo o desenho fica em src/scripts/situacaoFinanceira.ts (módulo próprio: <script> grande
// direto na página some do SSR). Os dados do banco chegam ao cliente por um island JSON.
import Admin from "../../layouts/Admin.astro";
import { verifyToken, assertSessaoValida, type AdminClaims } from "../../lib/auth";
import { nivelModuloUsuario } from "../../lib/permissoes";
import {
  carregarSituacao, STATUS_ACAO, ROTULO_STATUS, TIPOS_REAVER, ROTULO_TIPO_REAVER, CHANCES, ROTULO_CHANCE,
  COBRANCAS, ROTULO_COBRANCA, SITUACOES_COM_COBRANCA,
} from "../../lib/situacaoFinanceira";

const token = Astro.cookies.get("admin_token")?.value;
if (!token) return Astro.redirect("/admin/login");
let claims: AdminClaims;
try { claims = await verifyToken<AdminClaims>(token); if (claims.tipo !== "admin") throw new Error(); await assertSessaoValida(claims); }
catch { Astro.cookies.delete("admin_token", { path: "/" }); return Astro.redirect("/admin/login"); }
// perfis + overrides FRESCOS do banco (multi-perfil); o redirect SÓ funciona na página, nunca no layout
const nivel = await nivelModuloUsuario(claims, "situacao-financeira");
if (nivel === "nenhum") return Astro.redirect("/admin");

type Situacao = Awaited<ReturnType<typeof carregarSituacao>>;
let sit: Situacao;
try {
  sit = await carregarSituacao();
} catch (e: any) {
  sit = { faltaMigration: false, erro: String(e?.message || e), dividas: [], protestos: [], acoes: [], reaver: [], painel: {} };
}

const pn = sit.painel || {};
const dataRef: string = String(pn.resumo_dividas?.data_ref || "");
// Ilha enxuta: o plano antigo (v1, 44 ideias com textos longos) vai só com o título; do painel, só os números da conta.
const acoesV2 = sit.acoes.filter((a) => a.plano === "v2");
const acoesV1 = sit.acoes.filter((a) => a.plano !== "v2")
  .map((a) => ({ id: a.id, codigo: a.codigo, titulo: a.titulo, onda: a.onda, descartada: a.descartada }));
const ilha = JSON.stringify({
  faltaMigration: sit.faltaMigration,
  erro: sit.faltaMigration ? null : (sit.erro || null),
  dividas: sit.dividas,
  protestos: sit.protestos,
  acoes: acoesV2,
  acoesV1,
  reaver: sit.reaver,
  painel: {
    meta: { margem: pn.meta?.margem ?? null, tributo: pn.meta?.tributo ?? null, fixo_mensal: pn.meta?.fixo_mensal ?? null },
    despesas_fixas: { total_mensal: pn.despesas_fixas?.total_mensal ?? null, data_ref: pn.despesas_fixas?.data_ref ?? null },
    data_ref: dataRef || null,
  },
  statusAcao: STATUS_ACAO,
  rotuloStatus: ROTULO_STATUS,
  tiposReaver: TIPOS_REAVER,
  rotuloTipoReaver: ROTULO_TIPO_REAVER,
  chances: CHANCES,
  rotuloChance: ROTULO_CHANCE,
  cobrancas: COBRANCAS,
  rotuloCobranca: ROTULO_COBRANCA,
  situacoesComCobranca: SITUACOES_COM_COBRANCA,
  podeEditar: nivel === "editar",
}).replace(/</g, "\\u003c"); // nunca deixar "</script>" vindo do banco fechar a tag
---
<Admin title="Situação Financeira" current="situacao-financeira">
  <div class="sf-head">
    <div class="sf-head-txt">
      <h2 class="sf-title">Situação Financeira</h2>
      <p class="sf-sub">
        {dataRef ? <span>Levantamento de <strong id="sfDataRef">{dataRef}</strong> · atualizado com o que você marca aqui</span> : <span id="sfDataRef">Atualizado com o que você marca aqui</span>}
      </p>
    </div>
    <div class="sf-head-live">
      <span id="sfLiveStatus" class="sf-live-st sf-live-loading"><span class="spinner"></span> Vobi: carregando…</span>
      <button type="button" class="btn btn-secondary btn-sm" id="sfBtnVobi" onclick="sfAtualizarVobi()">
        <i class="ti ti-refresh" aria-hidden="true"></i> Atualizar da Vobi
      </button>
    </div>
  </div>
  <div id="sfAviso"></div>

  {sit.faltaMigration && (
    <div class="sf-box sf-box-amarelo">
      <strong>As tabelas ainda não foram criadas (migrations 118 e 119).</strong>
      A parte ao vivo da Vobi continua funcionando; o resto aparece quando as migrations rodarem.
    </div>
  )}
  {!sit.faltaMigration && sit.erro && (
    <div class="sf-box sf-box-vermelho">
      <strong>Não consegui ler os dados salvos.</strong> {sit.erro}
    </div>
  )}

  <div class="pills sf-pills" id="sfPills" role="tablist">
    <button type="button" class="pill active" data-tab="painel" onclick="sfTab(this)">Painel</button>
    <button type="button" class="pill" data-tab="impostos" onclick="sfTab(this)">Impostos</button>
    <button type="button" class="pill" data-tab="bancos" onclick="sfTab(this)">Bancos</button>
    <button type="button" class="pill" data-tab="fornecedores" onclick="sfTab(this)">Fornecedores</button>
    <button type="button" class="pill" data-tab="outras" onclick="sfTab(this)">Outras</button>
    <button type="button" class="pill" data-tab="reaver" onclick="sfTab(this)">A reaver</button>
    <button type="button" class="pill" data-tab="plano" onclick="sfTab(this)">Plano<span class="sf-pill-x"> de ação</span></button>
    <button type="button" class="pill" data-tab="protestos" onclick="sfTab(this)">Protestos</button>
  </div>

  <section class="sf-sec" data-sec="painel" id="sfSecPainel">
    <div class="loading"><span class="spinner"></span> Montando o painel…</div>
  </section>
  <section class="sf-sec" data-sec="impostos" id="sfSecImpostos" style="display:none"></section>
  <section class="sf-sec" data-sec="bancos" id="sfSecBancos" style="display:none"></section>
  <section class="sf-sec" data-sec="fornecedores" id="sfSecFornecedores" style="display:none"></section>
  <section class="sf-sec" data-sec="outras" id="sfSecOutras" style="display:none"></section>
  <section class="sf-sec" data-sec="reaver" id="sfSecReaver" style="display:none"></section>
  <section class="sf-sec" data-sec="plano" id="sfSecPlano" style="display:none"></section>
  <section class="sf-sec" data-sec="protestos" id="sfSecProtestos" style="display:none"></section>

  <!-- Detalhes / editar uma dívida -->
  <div class="modal-overlay" id="sfModalDivida" onclick="if(event.target===this)sfFecharDivida()">
    <div class="modal-box sf-modal" role="dialog" aria-labelledby="sfMdTitulo">
      <div class="modal-header">
        <h2 id="sfMdTitulo">Dívida</h2>
        <button type="button" class="modal-close" onclick="sfFecharDivida()" aria-label="Fechar">✕</button>
      </div>
      <form id="sfFormDivida" onsubmit="event.preventDefault();sfSalvarDivida()">
        <input type="hidden" id="sfMdId" />
        <p class="sf-md-credor" id="sfMdCredor"></p>
        <div class="sf-md-body">
          <div class="sf-md-grid">
            <div class="form-group">
              <label for="sfMdProposta">Proposta de quitação (R$)</label>
              <input id="sfMdProposta" type="text" inputmode="decimal" placeholder="valor para quitar" />
            </div>
            <div class="form-group">
              <label for="sfMdSituacao">Situação</label>
              <select id="sfMdSituacao"></select>
            </div>
          </div>
          <div class="form-group">
            <label for="sfMdPropObs">Sobre a proposta (quem propôs, quando, condições)</label>
            <textarea id="sfMdPropObs" maxlength="1000" rows="2"></textarea>
          </div>
          <div class="sf-md-quit" id="sfMdQuitBox">
            <div class="sf-md-quit-t" id="sfMdQuitTit">✓ Quitada</div>
            <div class="sf-md-grid">
              <div class="form-group">
                <label for="sfMdPago">Valor pago (R$)</label>
                <input id="sfMdPago" type="text" inputmode="decimal" />
              </div>
              <div class="form-group">
                <label for="sfMdQuitEm">Quitada em</label>
                <input id="sfMdQuitEm" type="date" />
              </div>
            </div>
          </div>
          <p class="sf-md-aviso" id="sfMdAviso"></p>
          <div class="sf-md-grid">
            <div class="form-group">
              <label for="sfMdValor">Vencido hoje — é a dívida (R$)</label>
              <input id="sfMdValor" type="text" inputmode="decimal" placeholder="ex.: 10.000,00" />
            </div>
            <div class="form-group">
              <label for="sfMdTeto">Valor máximo, se incerto (R$)</label>
              <input id="sfMdTeto" type="text" inputmode="decimal" placeholder="vazio se não houver" />
            </div>
          </div>
          <div class="sf-md-grid">
            <div class="form-group">
              <label for="sfMdAVencer">A vencer — comprometido (R$)</label>
              <input id="sfMdAVencer" type="text" inputmode="decimal" placeholder="parcelas futuras" />
            </div>
            <div class="form-group">
              <label for="sfMdProxVenc">Próximo vencimento</label>
              <input id="sfMdProxVenc" type="date" />
            </div>
          </div>
          <div class="sf-md-grid">
            <div class="form-group">
              <label for="sfMdCobranca">Cobrança do vencido</label>
              <select id="sfMdCobranca"></select>
            </div>
            <div class="form-group">
              <label for="sfMdParcela">Parcela por mês (R$)</label>
              <input id="sfMdParcela" type="text" inputmode="decimal" placeholder="ex.: 1.234,56" />
            </div>
          </div>
          <div class="form-group">
            <label for="sfMdRisco">Risco (CPF, bloqueio…)</label>
            <input id="sfMdRisco" type="text" maxlength="1000" />
          </div>
          <div class="form-group">
            <label for="sfMdVobiId">Fornecedor na Vobi (nº do cadastro)</label>
            <input id="sfMdVobiId" type="text" inputmode="numeric" maxlength="9" placeholder="vazio = não ligada" />
          </div>
          <p class="sf-md-vobi" id="sfMdVobi"></p>
          <div class="form-group">
            <label for="sfMdObs">Observação</label>
            <textarea id="sfMdObs" maxlength="4000" rows="3"></textarea>
          </div>
        </div>
        <p class="sf-msg" id="sfMdMsg"></p>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline" onclick="sfFecharDivida()">Fechar</button>
          <button type="submit" class="btn btn-primary" id="sfMdSalvar" data-requer-edicao>Salvar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Confirmar "Quitei" (dívida) ou "Recebi" (a reaver) -->
  <div class="modal-overlay" id="sfModalQuitar" onclick="if(event.target===this)sfFecharQuitar()">
    <div class="modal-box sf-modal sf-modal-p" role="dialog" aria-labelledby="sfMqTitulo">
      <div class="modal-header">
        <h2 id="sfMqTitulo">Quitei</h2>
        <button type="button" class="modal-close" onclick="sfFecharQuitar()" aria-label="Fechar">✕</button>
      </div>
      <form onsubmit="event.preventDefault();sfConfirmarQuitar()">
        <p class="sf-md-credor" id="sfMqTexto"></p>
        <p class="sf-md-aviso" id="sfMqNota"></p>
        <div class="sf-md-body">
          <div class="sf-md-grid">
            <div class="form-group">
              <label for="sfMqValor" id="sfMqValorRot">Quanto pagou? (R$)</label>
              <input id="sfMqValor" type="text" inputmode="decimal" />
            </div>
            <div class="form-group">
              <label for="sfMqData">Quando?</label>
              <input id="sfMqData" type="date" />
            </div>
          </div>
        </div>
        <p class="sf-msg" id="sfMqMsg"></p>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline" onclick="sfFecharQuitar()">Cancelar</button>
          <button type="submit" class="btn btn-success" id="sfMqOk" data-requer-edicao>✓ Confirmar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Adicionar / editar um item de "A reaver" -->
  <div class="modal-overlay" id="sfModalReaver" onclick="if(event.target===this)sfFecharReaver()">
    <div class="modal-box sf-modal" role="dialog" aria-labelledby="sfMrTitulo">
      <div class="modal-header">
        <h2 id="sfMrTitulo">A reaver</h2>
        <button type="button" class="modal-close" onclick="sfFecharReaver()" aria-label="Fechar">✕</button>
      </div>
      <form onsubmit="event.preventDefault();sfSalvarReaver()">
        <input type="hidden" id="sfMrId" />
        <div class="sf-md-body">
          <div class="sf-md-grid">
            <div class="form-group">
              <label for="sfMrTipo">Tipo</label>
              <select id="sfMrTipo"></select>
            </div>
            <div class="form-group">
              <label for="sfMrChance">Chance de voltar</label>
              <select id="sfMrChance"></select>
            </div>
          </div>
          <div class="form-group">
            <label for="sfMrTitulo2">Título *</label>
            <input id="sfMrTitulo2" type="text" maxlength="200" placeholder="ex.: Processo contra a seguradora" />
          </div>
          <div class="sf-md-grid">
            <div class="form-group">
              <label for="sfMrContra">Contra quem</label>
              <input id="sfMrContra" type="text" maxlength="200" />
            </div>
            <div class="form-group">
              <label for="sfMrValor">Valor estimado (R$)</label>
              <input id="sfMrValor" type="text" inputmode="decimal" />
            </div>
          </div>
          <div class="form-group">
            <label for="sfMrPrev">Quando deve entrar</label>
            <input id="sfMrPrev" type="text" maxlength="200" placeholder="ex.: 2027, após a sentença" />
          </div>
          <div class="sf-mr-extra">
            <div class="form-group">
              <label for="sfMrSit">Situação</label>
              <textarea id="sfMrSit" maxlength="1000" rows="2"></textarea>
            </div>
            <div class="sf-md-quit" id="sfMrRecBox">
              <div class="sf-md-quit-t">✓ Recebido</div>
              <div class="sf-md-grid">
                <div class="form-group">
                  <label for="sfMrValRec">Valor recebido (R$)</label>
                  <input id="sfMrValRec" type="text" inputmode="decimal" />
                </div>
                <div class="form-group">
                  <label for="sfMrRecEm">Recebido em</label>
                  <input id="sfMrRecEm" type="date" />
                </div>
              </div>
            </div>
            <div class="form-group">
              <label for="sfMrFonte">Fonte</label>
              <input id="sfMrFonte" type="text" maxlength="1000" />
            </div>
            <div class="form-group">
              <label for="sfMrObs">Observação</label>
              <textarea id="sfMrObs" maxlength="4000" rows="3"></textarea>
            </div>
          </div>
        </div>
        <p class="sf-msg" id="sfMrMsg"></p>
        <div class="modal-footer sf-mr-footer">
          <button type="button" class="btn btn-outline sf-btn-remover" id="sfMrRemover" onclick="sfRemoverReaver()" data-requer-edicao>Remover</button>
          <span class="sf-espaco"></span>
          <button type="button" class="btn btn-outline" onclick="sfFecharReaver()">Fechar</button>
          <button type="submit" class="btn btn-primary" id="sfMrSalvar" data-requer-edicao>Salvar</button>
        </div>
      </form>
    </div>
  </div>

  <script id="sfData" type="application/json" is:inline set:html={ilha}></script>
  <script>import "../../scripts/situacaoFinanceira.ts";</script>

  <style is:global>
    /* Situação Financeira v2 — classes com prefixo sf- (global: o HTML é montado por innerHTML) */
    .sf-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 14px; }
    .sf-title { font-family: 'Montserrat', sans-serif; font-size: 1.35rem; font-weight: 800; color: var(--ink); letter-spacing: -.01em; }
    .sf-sub { color: var(--ink-mid); font-size: .86rem; margin-top: 3px; }
    .sf-head-live { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .sf-live-st { display: inline-flex; align-items: center; gap: 7px; font-size: .78rem; font-weight: 700; padding: 5px 11px; border-radius: 99px; background: var(--gray-100); color: var(--ink-mid); }
    .sf-live-st .spinner { width: 13px; height: 13px; border-width: 2px; }
    .sf-live-ok { background: var(--success-bg); color: var(--success-fg); }
    .sf-live-cache { background: var(--info-bg); color: var(--info-fg); }
    .sf-live-erro { background: var(--warning-bg); color: var(--warning-fg); }
    /* contain: a faixa de abas (sem quebra no celular) não pode impor a largura mínima da página:
       sem isso o .main-wrap (flex) crescia até 704px e o celular abria a tela cortada */
    .sf-pills { margin-bottom: 16px; contain: inline-size; width: 100%; }
    /* o layout das seções segue a largura do CONTEÚDO (com a barra lateral de 252px aberta, um celular deitado
       ou tablet sobra ~540px), não a da janela: as regras de tela estreita ficam em @container sfsec */
    .sf-sec { min-width: 0; container: sfsec / inline-size; }

    .sf-box { border-radius: var(--radius-md); padding: 10px 14px; margin-bottom: 12px; font-size: .88rem; line-height: 1.5; border: 1px solid transparent; }
    .sf-box strong { margin-right: 4px; }
    .sf-box-amarelo { background: var(--warning-bg); color: var(--warning-fg); border-color: #FDE68A; }
    .sf-box-vermelho { background: var(--danger-bg); color: var(--danger-fg); border-color: #FECACA; }
    .sf-box-azul { background: var(--info-bg); color: var(--info-fg); border-color: #BFDBFE; }
    .sf-box-verde { background: var(--success-bg); color: var(--success-fg); border-color: #BBF7D0; }

    .sf-blk { margin-bottom: 20px; }
    .sf-blk-title { display: flex; align-items: center; gap: 8px; font-family: 'Montserrat', sans-serif; font-size: .78rem; font-weight: 800; color: var(--ink-mid); margin: 0 0 10px; text-transform: uppercase; letter-spacing: .06em; }
    .sf-blk-title i { font-size: 16px; color: var(--brand); }
    .sf-muted { color: var(--ink-light); font-size: .8rem; }
    .sf-small { font-size: .8rem; color: var(--ink-mid); }
    .sf-num { font-variant-numeric: tabular-nums; white-space: nowrap; text-align: right; }
    th.sf-num { text-align: right; }
    .sf-neg { color: var(--danger); font-weight: 700; }
    .sf-pos { color: var(--success); font-weight: 700; }
    .sf-card-t { font-family: 'Montserrat', sans-serif; font-size: .95rem; font-weight: 800; margin-bottom: 8px; color: var(--ink); }
    .sf-link { background: none; border: 0; padding: 0; color: var(--info); font-size: .82rem; cursor: pointer; text-decoration: underline; }

    /* Recolhíveis */
    .sf-det { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); margin-bottom: 8px; min-width: 0; }
    .sf-det > summary { cursor: pointer; padding: 10px 14px; font-weight: 700; font-size: .88rem; list-style: none; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .sf-det > summary::-webkit-details-marker { display: none; }
    .sf-det > summary::before { content: "▸"; color: var(--ink-light); transition: transform .15s; display: inline-block; }
    .sf-det[open] > summary::before { transform: rotate(90deg); }
    .sf-det-body { padding: 0 14px 12px; font-size: .86rem; color: var(--ink-mid); line-height: 1.55; }

    /* Barras de progresso */
    .sf-prog { height: 12px; background: rgba(21,132,59,.13); border-radius: 99px; overflow: hidden; }
    .sf-prog-bar { height: 100%; background: var(--success); border-radius: 99px; transition: width .7s ease; }
    .sf-mini { display: block; height: 6px; background: var(--gray-100); border-radius: 99px; overflow: hidden; }
    .sf-mini > span { display: block; height: 100%; background: var(--success); border-radius: 99px; }

    /* Painel: herói */
    .sf-hero { background: linear-gradient(135deg, #ECFDF3 0%, #F7FEF9 100%); border: 1px solid #BBF7D0; border-radius: var(--radius-lg); padding: 16px 18px; margin-bottom: 14px; }
    .sf-hero-top { display: flex; justify-content: space-between; align-items: flex-end; gap: 6px 14px; flex-wrap: wrap; margin-bottom: 10px; }
    .sf-hero-l { font-size: .74rem; font-weight: 800; color: var(--success-fg); text-transform: uppercase; letter-spacing: .06em; }
    .sf-hero-v { font-family: 'Montserrat', sans-serif; font-size: 2rem; font-weight: 800; color: var(--success-fg); line-height: 1.1; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
    .sf-hero-cont { font-size: .9rem; color: var(--success-fg); }
    .sf-hero-cont strong { font-family: 'Montserrat', sans-serif; font-size: 1.25rem; }
    .sf-hero-frase { margin-top: 9px; font-size: .88rem; color: #14532D; line-height: 1.45; }

    /* Painel: 4 números */
    .sf-cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-bottom: 14px; }
    .sf-c { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 11px 13px; min-width: 0; }
    .sf-c-l { font-size: .7rem; font-weight: 800; color: var(--ink-mid); text-transform: uppercase; letter-spacing: .05em; }
    .sf-c-v { font-family: 'Montserrat', sans-serif; font-size: 1.3rem; font-weight: 800; margin-top: 3px; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-variant-numeric: tabular-nums; }
    .sf-c-s { font-size: .74rem; color: var(--ink-mid); margin-top: 2px; line-height: 1.35; }
    .sf-c-verde .sf-c-v { color: var(--success-fg); }
    .sf-c-azul .sf-c-v { color: var(--info-fg); }

    /* Painel: comprometido (a vencer) — fora da dívida: borda tracejada, tom neutro */
    .sf-comp { background: var(--surface); border: 1px dashed var(--border-strong); border-radius: var(--radius-md); padding: 10px 13px; margin-bottom: 14px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; min-width: 0; }
    .sf-comp-h { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .sf-comp-v { font-family: 'Montserrat', sans-serif; font-size: 1.15rem; font-weight: 800; color: var(--ink-mid); white-space: nowrap; font-variant-numeric: tabular-nums; }
    .sf-comp-s { flex: 1 1 220px; min-width: 0; font-size: .78rem; color: var(--ink-mid); line-height: 1.4; }
    .sf-comp-s strong { color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .sf-comp-t { flex-basis: 100%; font-size: .74rem; color: var(--ink-light); overflow-wrap: anywhere; }

    /* Painel: meta de receita */
    .sf-meta { margin-bottom: 14px; }
    .sf-meta-l { display: flex; justify-content: space-between; align-items: center; gap: 4px 10px; padding: 7px 0; border-bottom: 1px dashed var(--border); font-size: .88rem; flex-wrap: wrap; }
    .sf-meta-l:last-of-type { border-bottom: 0; }
    .sf-meta-l strong { font-family: 'Montserrat', sans-serif; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .sf-meta-l select { padding: 3px 6px; border: 1px solid var(--border-strong); border-radius: 6px; font-size: .86rem; background: #fff; margin: 0 3px; }
    .sf-meta-nota { font-size: .74rem; color: var(--ink-light); margin-top: -2px; }
    .sf-trilho { position: relative; height: 14px; background: var(--gray-100); border-radius: 99px; margin: 12px 0 5px; }
    .sf-trilho-fill { height: 100%; border-radius: 99px; background: var(--info); min-width: 3px; }
    .sf-trilho-marca { position: absolute; top: -4px; bottom: -4px; width: 3px; background: var(--ink); border-radius: 2px; transform: translateX(-1px); }
    .sf-trilho-leg { display: flex; justify-content: space-between; gap: 4px 10px; flex-wrap: wrap; font-size: .74rem; color: var(--ink-mid); }
    .sf-alavanca { font-size: .84rem; background: var(--success-bg); color: var(--success-fg); border-radius: var(--radius-sm); padding: 7px 10px; margin-top: 10px; line-height: 1.4; }
    .sf-meta .sf-det { margin: 10px 0 0; }
    .sf-meta .sf-det-body ul { padding-left: 18px; }

    /* Painel: por tipo */
    .sf-tipos { display: flex; flex-direction: column; gap: 8px; }
    .sf-tipo { display: flex; gap: 12px; align-items: center; width: 100%; text-align: left; background: var(--surface); border: 1px solid var(--border); border-left: 5px solid var(--c, var(--brand)); border-radius: var(--radius-md); padding: 10px 12px; cursor: pointer; font: inherit; color: inherit; transition: var(--transition); }
    .sf-tipo:hover { box-shadow: var(--shadow-sm); border-color: var(--c); }
    .sf-tipo-ic { width: 34px; height: 34px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; font-size: 18px; color: var(--c); background: color-mix(in srgb, var(--c) 13%, #fff); flex: none; }
    .sf-tipo-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
    .sf-tipo-top { display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
    .sf-tipo-top strong { font-family: 'Montserrat', sans-serif; }
    .sf-tipo-v { font-family: 'Montserrat', sans-serif; font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .sf-tipo-sub { font-size: .74rem; color: var(--ink-mid); line-height: 1.35; }

    /* Painel: próximas vitórias e conquistas */
    .sf-vits { display: flex; flex-direction: column; gap: 8px; }
    .sf-vit { display: flex; align-items: center; gap: 8px 12px; padding: 9px 12px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); flex-wrap: wrap; }
    .sf-vit-info { flex: 1 1 180px; min-width: 0; }
    .sf-vit-info strong { display: block; font-size: .9rem; overflow-wrap: anywhere; }
    .sf-vit-id { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sf-vit-v { font-family: 'Montserrat', sans-serif; font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .sf-conq { list-style: none; display: flex; flex-direction: column; gap: 6px; padding: 0; }
    .sf-conq li { display: flex; gap: 9px; align-items: flex-start; background: #F3FDF6; border: 1px solid #BBF7D0; border-radius: var(--radius-md); padding: 8px 11px; font-size: .86rem; color: #14532D; }
    .sf-conq-ic { width: 22px; height: 22px; border-radius: 50%; background: var(--success); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: .75rem; font-weight: 800; flex: none; }
    .sf-conq-txt { flex: 1; min-width: 0; overflow-wrap: anywhere; }
    .sf-conq-dt { font-size: .74rem; color: var(--success-fg); white-space: nowrap; }

    /* Abas de tipo: cabeçalho */
    .sf-thead { background: var(--surface); border: 1px solid var(--border); border-top: 4px solid var(--c, var(--brand)); border-radius: var(--radius-md); padding: 12px 14px; margin-bottom: 12px; }
    .sf-thead-nums { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px 12px; margin-bottom: 10px; }
    .sf-thead-nums > div { min-width: 0; }
    .sf-thead-nums span { display: block; font-size: .7rem; font-weight: 700; color: var(--ink-mid); text-transform: uppercase; letter-spacing: .04em; }
    .sf-thead-nums strong { font-family: 'Montserrat', sans-serif; font-size: 1.05rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .sf-thead-nums em { display: block; font-style: normal; font-size: .72rem; color: var(--success-fg); font-weight: 700; }
    .sf-thead-nums em.sf-em-cinza { color: var(--ink-light); font-weight: 600; }
    .sf-alerta { background: var(--danger-bg); color: var(--danger-fg); border: 1px solid #FECACA; border-radius: var(--radius-md); padding: 8px 12px; font-size: .86rem; font-weight: 600; margin-bottom: 12px; }
    .sf-ref { background: var(--info-bg); color: var(--info-fg); border-radius: var(--radius-md); padding: 8px 12px; font-size: .86rem; margin-bottom: 12px; }

    /* Abas de tipo: lista */
    .sf-grupo { padding: 0; overflow: hidden; }
    .sf-grupo > summary .sf-grupo-tot { margin-left: auto; font-size: .8rem; color: var(--ink-mid); font-weight: 600; white-space: nowrap; }
    .sf-linha { display: grid; grid-template-columns: minmax(0, 1fr) 128px 168px auto; gap: 8px 12px; align-items: center; padding: 9px 14px; border-top: 1px solid var(--border); }
    .sf-l-cred { font-weight: 700; font-size: .88rem; color: var(--ink); overflow-wrap: anywhere; }
    .sf-l-id { font-size: .76rem; color: var(--ink-light); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sf-l-motivo { font-size: .76rem; color: var(--ink-light); margin-top: 1px; overflow-wrap: anywhere; }
    .sf-l-selos { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 3px; }
    .sf-l-selos .badge { font-size: .66rem; padding: 1px 7px; }
    .sf-l-rot { display: block; font-size: .66rem; font-weight: 700; color: var(--ink-light); text-transform: uppercase; letter-spacing: .04em; margin-bottom: 2px; }
    .sf-l-devido strong { font-variant-numeric: tabular-nums; font-size: .9rem; white-space: nowrap; }
    .sf-l-devido .sf-muted { display: block; font-size: .72rem; }
    .sf-l-acoes { display: flex; gap: 6px; justify-content: flex-end; align-items: center; }
    .sf-in { width: 100%; padding: 6px 8px; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); font-size: .88rem; font-family: 'Open Sans', sans-serif; background: #fff; font-variant-numeric: tabular-nums; transition: border-color .2s, background .2s; }
    .sf-in:focus { outline: none; border-color: var(--brand); box-shadow: var(--shadow-focus); }
    .sf-in:disabled { background: var(--gray-50); color: var(--ink-mid); }
    .sf-in.sf-salvando { opacity: .6; }
    .sf-in.sf-ok { border-color: var(--success); background: #F0FDF4; }
    .sf-in.sf-erro { border-color: var(--danger); background: #FFF5F5; }
    .sf-econ { display: block; font-size: .72rem; color: var(--success-fg); font-weight: 700; margin-top: 2px; min-height: 1em; }
    .sf-quitei { background: var(--success); color: #fff; border: 0; border-radius: 8px; padding: 6px 10px; font-weight: 700; font-size: .78rem; cursor: pointer; white-space: nowrap; font-family: inherit; }
    .sf-quitei:hover { filter: brightness(.93); }
    .sf-ed { background: none; border: 1px solid var(--border); border-radius: 6px; color: var(--ink-mid); cursor: pointer; padding: 4px 8px; font-size: .8rem; font-family: inherit; }
    .sf-ed:hover { color: var(--brand); border-color: var(--brand); }
    .sf-linha-ok { grid-template-columns: minmax(0, 1fr) auto auto; background: #F7FEF9; }
    .sf-linha-ok .sf-l-cred { text-decoration: line-through; text-decoration-color: rgba(21,132,59,.45); color: var(--success-fg); }
    .sf-linha-fora { grid-template-columns: minmax(0, 1fr) 128px auto; background: var(--gray-50); color: var(--ink-mid); }
    .sf-linha-fora .sf-l-cred { color: var(--ink-mid); }
    .sf-quitadas > summary { color: var(--success-fg); }
    .sf-fora > summary { color: var(--ink-mid); }

    /* Abas de tipo: blocos "Vencidas — com cobrança" / "Vencidas — sem cobrança" */
    .sf-bloco { margin-bottom: 14px; min-width: 0; }
    .sf-bloco-t { display: flex; align-items: baseline; flex-wrap: wrap; gap: 2px 10px; margin: 2px 0 8px; padding: 2px 0 2px 10px; border-left: 4px solid var(--bc, var(--ink-light)); font-family: 'Montserrat', sans-serif; font-size: .8rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--bfg, var(--ink-mid)); }
    .sf-bloco-t i { font-size: 15px; vertical-align: -2px; }
    .sf-bloco-n { font-weight: 600; color: var(--ink-light); }
    .sf-bloco-tot { margin-left: auto; font-family: 'Open Sans', sans-serif; font-size: .84rem; font-weight: 700; text-transform: none; letter-spacing: 0; color: var(--ink); white-space: nowrap; font-variant-numeric: tabular-nums; }
    .sf-bloco-sub { flex-basis: 100%; font-family: 'Open Sans', sans-serif; font-size: .72rem; font-weight: 600; text-transform: none; letter-spacing: 0; color: var(--ink-light); }
    .sf-bloco-com { --bc: var(--danger); --bfg: var(--danger-fg); }
    .sf-bloco-sem { --bc: #F59E0B; --bfg: var(--warning-fg); }

    /* Abas de tipo: despesas comprometidas (a vencer — fora da dívida) */
    .sf-comp-det > summary { color: var(--ink-mid); }
    .sf-linha-comp { grid-template-columns: minmax(0, 1fr) 120px 112px auto; }
    .sf-linha-cortada { background: var(--gray-50); }
    .sf-linha-cortada .sf-l-cred, .sf-linha-cortada .sf-l-devido strong { text-decoration: line-through; text-decoration-color: rgba(0,0,0,.35); color: var(--ink-light); }
    .sf-cortar { background: #fff; border: 1px solid var(--border-strong); color: var(--ink-mid); border-radius: 8px; padding: 6px 10px; font-weight: 700; font-size: .76rem; cursor: pointer; white-space: nowrap; font-family: inherit; }
    .sf-cortar:hover { border-color: var(--danger); color: var(--danger); }
    .sf-vazio { padding: 12px 14px; color: var(--ink-light); font-size: .86rem; }

    /* A reaver */
    .sf-rv-lista { display: flex; flex-direction: column; gap: 8px; padding: 0 10px 10px; }
    .sf-rv { border: 1px solid var(--border); border-radius: var(--radius-md); padding: 10px 12px; background: var(--surface); min-width: 0; }
    .sf-rv-top { display: flex; justify-content: space-between; gap: 6px 10px; flex-wrap: wrap; align-items: baseline; }
    .sf-rv-top strong { font-size: .9rem; overflow-wrap: anywhere; }
    .sf-rv-top .badge { font-size: .66rem; padding: 1px 7px; }
    .sf-rv-fora { background: var(--gray-50); color: var(--ink-mid); }
    .sf-rv-sit { font-size: .8rem; color: var(--ink-mid); margin-top: 3px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .sf-rv-linha { display: flex; gap: 8px; align-items: flex-end; flex-wrap: wrap; margin-top: 8px; }
    .sf-rv-linha .sf-rv-campo { flex: 0 1 150px; min-width: 120px; }
    .sf-rv-prev { font-size: .76rem; color: var(--ink-mid); flex: 1 1 140px; min-width: 0; padding-bottom: 6px; }
    .sf-chance { padding: 6px 8px; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); font-size: .84rem; font-weight: 700; background: #fff; font-family: inherit; }
    .sf-chance-alta { background: var(--success-bg); color: var(--success-fg); border-color: #86EFAC; }
    .sf-chance-media { background: var(--warning-bg); color: var(--warning-fg); border-color: #FCD34D; }
    .sf-chance-baixa { background: var(--danger-bg); color: var(--danger-fg); border-color: #FCA5A5; }
    .sf-chance-nao_sei { background: var(--gray-100); color: var(--ink-mid); }
    .sf-rv-ok { padding: 8px 12px; border-top: 1px solid var(--border); display: flex; gap: 8px 12px; align-items: center; flex-wrap: wrap; font-size: .86rem; color: var(--success-fg); background: #F7FEF9; }
    .sf-rv-ok strong { flex: 1 1 160px; min-width: 0; overflow-wrap: anywhere; }
    .sf-topo { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
    .sf-topo-nums { display: flex; gap: 6px 18px; flex-wrap: wrap; font-size: .88rem; color: var(--ink-mid); }
    .sf-topo-nums strong { font-family: 'Montserrat', sans-serif; font-size: 1.1rem; color: var(--ink); font-variant-numeric: tabular-nums; }
    .sf-topo-nums .sf-verde strong { color: var(--success-fg); }

    /* Plano de ação v2 */
    .sf-pl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
    .sf-pl { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 13px 15px; box-shadow: var(--shadow-sm); min-width: 0; display: flex; flex-direction: column; gap: 7px; }
    .sf-pl-feito { border-color: #86EFAC; background: #F7FEF9; }
    .sf-pl-descartado { opacity: .65; }
    .sf-pl-h { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
    .sf-pl-h strong { font-family: 'Montserrat', sans-serif; font-size: .95rem; line-height: 1.3; }
    .sf-pl-mais > summary { cursor: pointer; font-size: .76rem; color: var(--info); list-style: none; display: inline-block; }
    .sf-pl-mais > summary::-webkit-details-marker { display: none; }
    .sf-pl-mais > summary::before { content: "▸ "; }
    .sf-pl-mais[open] > summary::before { content: "▾ "; }
    .sf-pl-desc { font-size: .8rem; color: var(--ink-mid); line-height: 1.45; margin-top: 4px; }
    .sf-pl-meta { display: flex; flex-direction: column; gap: 2px; font-size: .8rem; color: var(--ink); }
    .sf-pl-meta b { color: var(--ink-mid); font-weight: 700; }
    .sf-pl-cuidado { font-size: .78rem; background: #FFFBEB; color: #92400E; border: 1px solid #FDE68A; border-radius: var(--radius-sm); padding: 6px 9px; line-height: 1.4; }
    .sf-pl-passos { padding-left: 18px; font-size: .82rem; line-height: 1.45; color: var(--ink); }
    .sf-pl-passos li + li { margin-top: 2px; }
    .sf-pl-form { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: auto; padding-top: 8px; border-top: 1px dashed var(--border); }
    .sf-pl-form .sf-l-rot { margin-bottom: 3px; }
    .sf-pl-form select { width: 100%; padding: 6px 8px; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); font-size: .86rem; background: #fff; font-family: inherit; }
    .sf-cpf { font-size: .78rem; color: var(--ink-mid); margin: -4px 0 10px; }
    .sf-v1 { padding-left: 18px; font-size: .82rem; color: var(--ink-mid); line-height: 1.5; columns: 2 280px; margin-top: 8px; }

    /* Protestos */
    .sf-kpis { display: grid; grid-template-columns: repeat(auto-fill, minmax(165px, 1fr)); gap: 10px; margin-bottom: 12px; }
    .sf-kpi { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 10px 12px; min-width: 0; }
    .sf-kpi-v { font-family: 'Montserrat', sans-serif; font-size: 1.02rem; font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .sf-kpi-l { font-size: .74rem; color: var(--ink-mid); margin-top: 3px; }
    .sf-prot-hero { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 14px; margin-bottom: 12px; }
    .sf-prot-hero-t { display: flex; justify-content: space-between; gap: 6px 12px; flex-wrap: wrap; align-items: baseline; margin-bottom: 8px; font-size: .9rem; }
    .sf-prot-hero-t strong { font-family: 'Montserrat', sans-serif; font-size: 1.2rem; color: var(--success-fg); }
    .sf-toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 4px 0 12px; }
    .sf-toolbar .search-input { flex: 1; min-width: 180px; }
    .sf-prot-body { padding: 0 10px 10px; min-width: 0; }
    .sf-table td { vertical-align: top; }
    .sf-table tfoot td { font-weight: 800; background: var(--gray-50); border-top: 2px solid var(--border); }
    .sf-table .sf-obs { max-width: 340px; font-size: .8rem; color: var(--ink-mid); line-height: 1.45; }
    .sf-prot .sf-prot-cred { min-width: 190px; }
    .sf-prot tr.sf-prot-l1 td { border-bottom: 0; padding-bottom: 6px; }
    .sf-prot tr.sf-prot-l2 td { padding-top: 0; }
    .sf-prot tbody tr.sf-prot-l2:hover td, .sf-prot tbody tr.sf-prot-l1:hover td { background: transparent; }
    .sf-prot tr.sf-prot-canc td { background: #F7FEF9; }
    .sf-prot tr.sf-prot-canc .sf-prot-cred > strong { text-decoration: line-through; text-decoration-color: rgba(21,132,59,.5); }
    .sf-resp-rot { font-size: .72rem; font-weight: 700; color: var(--ink-mid); margin-bottom: 3px; }
    /* a resposta fica presa à área visível da tabela (que rola de lado no celular): textarea e Salvar sempre à vista */
    .sf-resp-box { position: sticky; left: 0; max-width: 760px; max-width: min(760px, calc(100cqw - 44px)); }
    .sf-resp { display: flex; gap: 6px; align-items: flex-start; }
    .sf-resp textarea { flex: 1; min-width: 0; min-height: 38px; padding: 6px 8px; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); font-size: .82rem; font-family: 'Open Sans', sans-serif; resize: vertical; }
    .sf-resp textarea:focus { outline: none; border-color: var(--brand); box-shadow: var(--shadow-focus); }
    .sf-selo-pago, .sf-selo-cpf, .sf-selo-canc { display: inline-block; font-size: .66rem; font-weight: 800; padding: 1px 7px; border-radius: 99px; margin: 4px 6px 0 0; white-space: nowrap; }
    .sf-selo-pago, .sf-selo-canc { background: var(--success-bg); color: var(--success-fg); border: 1px solid #BBF7D0; }
    .sf-selo-cpf { background: var(--info-bg); color: var(--info-fg); border: 1px solid #BFDBFE; }
    .sf-btn-canc { margin-top: 6px; background: #fff; border: 1px solid #86EFAC; color: var(--success-fg); border-radius: 6px; padding: 3px 8px; font-size: .74rem; font-weight: 700; cursor: pointer; font-family: inherit; }
    .sf-btn-canc:hover { background: var(--success-bg); }
    .sf-msg { font-size: .8rem; font-weight: 700; min-height: 1em; }
    .sf-msg.ok { color: var(--success); }
    .sf-msg.erro { color: var(--danger); }

    /* Modais */
    .sf-md-credor { padding: 12px 24px 0; font-weight: 700; color: var(--ink); overflow-wrap: anywhere; }
    .sf-modal { max-width: 560px; }
    .sf-modal-p { max-width: 420px; }
    .modal-box.sf-modal .sf-md-body { padding: 14px 24px 0; }
    .modal-box.sf-modal .form-group { padding: 0; }
    .sf-md-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 12px; }
    .modal-box.sf-modal .sf-msg { padding: 0 24px; }
    .sf-md-quit { background: #F3FDF6; border: 1px solid #BBF7D0; border-radius: var(--radius-md); padding: 8px 10px 0; margin-bottom: 14px; }
    .sf-md-quit-t { font-size: .78rem; font-weight: 800; color: var(--success-fg); margin-bottom: 6px; }
    .sf-md-vobi { font-size: .76rem; color: var(--info-fg); margin: -4px 0 10px; line-height: 1.4; }
    .sf-md-vobi:empty { display: none; }
    .sf-md-aviso { font-size: .8rem; color: var(--warning-fg, #92400E); background: var(--warning-bg, #FFFBEB); border-radius: 8px; padding: 8px 10px; margin: 0 0 10px; line-height: 1.4; }
    .sf-md-aviso:empty { display: none; }
    .sf-l-pago { color: var(--success-fg, var(--success)); }
    .sf-mr-footer { align-items: center; }
    .sf-espaco { flex: 1; }
    .sf-btn-remover { color: var(--danger); border-color: #FECACA; }
