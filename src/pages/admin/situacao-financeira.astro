---
// Situação Financeira (grupo Diretoria, só admin por padrão).
// Dívidas por grupo, plano de ação de receita e protestos (tabelas fin_sf_*, migration 118)
// + leitura AO VIVO da Vobi (fluxo mensal e contas a pagar em aberto) pela API
// /api/admin/situacao-financeira/aovivo, com cache de 1 h no servidor.
// Todo o desenho fica em src/scripts/situacaoFinanceira.ts (módulo próprio: <script> grande
// direto na página some do SSR). Os dados do banco chegam ao cliente por um island JSON.
import Admin from "../../layouts/Admin.astro";
import { verifyToken, assertSessaoValida, type AdminClaims } from "../../lib/auth";
import { nivelModuloUsuario } from "../../lib/permissoes";
import { carregarSituacao, STATUS_ACAO, ROTULO_STATUS, ROTULO_GRUPO_ABERTO } from "../../lib/situacaoFinanceira";

const token = Astro.cookies.get("admin_token")?.value;
if (!token) return Astro.redirect("/admin/login");
let claims: AdminClaims;
try { claims = await verifyToken<AdminClaims>(token); if (claims.tipo !== "admin") throw new Error(); await assertSessaoValida(claims); }
catch { Astro.cookies.delete("admin_token", { path: "/" }); return Astro.redirect("/admin/login"); }
// perfis + overrides FRESCOS do banco (multi-perfil); o redirect SÓ funciona na página, nunca no layout
const nivel = await nivelModuloUsuario(claims, "situacao-financeira");
if (nivel === "nenhum") return Astro.redirect("/admin");

type Situacao = Awaited<ReturnType<typeof carregarSituacao>>;
let sit: Situacao;
try {
  sit = await carregarSituacao();
} catch (e: any) {
  sit = { faltaMigration: false, erro: String(e?.message || e), dividas: [], protestos: [], acoes: [], painel: {} };
}

const dataRef: string = String(sit.painel?.resumo_dividas?.data_ref || "");
const ilha = JSON.stringify({
  faltaMigration: sit.faltaMigration,
  erro: sit.faltaMigration ? null : (sit.erro || null),
  dividas: sit.dividas,
  protestos: sit.protestos,
  acoes: sit.acoes,
  painel: sit.painel,
  statusAcao: STATUS_ACAO,
  rotuloStatus: ROTULO_STATUS,
  rotuloGrupoAberto: ROTULO_GRUPO_ABERTO,
  podeEditar: nivel === "editar",
}).replace(/</g, "\\u003c"); // nunca deixar "</script>" vindo do banco fechar a tag
---
<Admin title="Situação Financeira" current="situacao-financeira">
  <div class="sf-head">
    <div class="sf-head-txt">
      <h2 class="sf-title">Situação Financeira</h2>
      <p class="sf-sub">
        {dataRef ? <span>Dados de referência: <strong id="sfDataRef">{dataRef}</strong></span> : <span id="sfDataRef">Sem data de referência</span>}
      </p>
    </div>
    <div class="sf-head-live">
      <span id="sfLiveStatus" class="sf-live-st sf-live-loading"><span class="spinner"></span> Vobi: carregando…</span>
      <button type="button" class="btn btn-secondary btn-sm" id="sfBtnVobi" onclick="sfAtualizarVobi()">
        <i class="ti ti-refresh" aria-hidden="true"></i> Atualizar da Vobi
      </button>
    </div>
  </div>
  <div id="sfAviso"></div>

  {sit.faltaMigration && (
    <div class="sf-box sf-box-amarelo">
      <strong>As tabelas ainda não foram criadas (migration 118).</strong>
      A parte ao vivo da Vobi continua funcionando; dívidas, protestos e plano de ação aparecem quando a migration rodar.
    </div>
  )}
  {!sit.faltaMigration && sit.erro && (
    <div class="sf-box sf-box-vermelho">
      <strong>Não consegui ler os dados salvos.</strong> {sit.erro}
    </div>
  )}

  <div class="pills sf-pills" id="sfPills" role="tablist">
    <button type="button" class="pill active" data-tab="visao" onclick="sfTab(this)">Visão geral</button>
    <button type="button" class="pill" data-tab="impostos" onclick="sfTab(this)">Impostos</button>
    <button type="button" class="pill" data-tab="bancos" onclick="sfTab(this)">Bancos</button>
    <button type="button" class="pill" data-tab="fornecedores" onclick="sfTab(this)">Fornecedores</button>
    <button type="button" class="pill" data-tab="fixas" onclick="sfTab(this)">Despesas fixas</button>
    <button type="button" class="pill" data-tab="plano" onclick="sfTab(this)">Plano de ação</button>
    <button type="button" class="pill" data-tab="protestos" onclick="sfTab(this)">Protestos</button>
  </div>

  <section class="sf-sec" data-sec="visao" id="sfSecVisao">
    <div class="loading"><span class="spinner"></span> Montando a visão geral…</div>
  </section>
  <section class="sf-sec" data-sec="impostos" id="sfSecImpostos" style="display:none"></section>
  <section class="sf-sec" data-sec="bancos" id="sfSecBancos" style="display:none"></section>
  <section class="sf-sec" data-sec="fornecedores" id="sfSecFornecedores" style="display:none"></section>
  <section class="sf-sec" data-sec="fixas" id="sfSecFixas" style="display:none"></section>
  <section class="sf-sec" data-sec="plano" id="sfSecPlano" style="display:none"></section>
  <section class="sf-sec" data-sec="protestos" id="sfSecProtestos" style="display:none"></section>

  <!-- Editar uma dívida (impostos, bancos, fornecedores) -->
  <div class="modal-overlay" id="sfModalDivida" onclick="if(event.target===this)sfFecharDivida()">
    <div class="modal-box sf-modal" role="dialog" aria-labelledby="sfMdTitulo">
      <div class="modal-header">
        <h2 id="sfMdTitulo">Atualizar dívida</h2>
        <button type="button" class="modal-close" onclick="sfFecharDivida()" aria-label="Fechar">✕</button>
      </div>
      <form id="sfFormDivida" onsubmit="event.preventDefault();sfSalvarDivida()">
        <input type="hidden" id="sfMdId" />
        <p class="sf-md-credor" id="sfMdCredor"></p>
        <div class="sf-md-body">
        <div class="sf-md-grid">
          <div class="form-group">
            <label for="sfMdSituacao">Situação</label>
            <select id="sfMdSituacao"></select>
          </div>
          <div class="form-group">
            <label for="sfMdParcela">Parcela por mês (R$)</label>
            <input id="sfMdParcela" type="text" inputmode="decimal" placeholder="ex.: 1.234,56" />
          </div>
        </div>
        <div class="sf-md-grid">
          <div class="form-group">
            <label for="sfMdValor">Valor de hoje (R$)</label>
            <input id="sfMdValor" type="text" inputmode="decimal" placeholder="ex.: 10.000,00" />
          </div>
          <div class="form-group">
            <label for="sfMdTeto">Valor máximo, se incerto (R$)</label>
            <input id="sfMdTeto" type="text" inputmode="decimal" placeholder="deixe vazio se não houver" />
          </div>
        </div>
        <div class="form-group">
          <label for="sfMdRisco">Risco (empresa, CPF, bloqueio…)</label>
          <input id="sfMdRisco" type="text" maxlength="300" />
        </div>
        <div class="form-group">
          <label for="sfMdObs">Observação</label>
          <textarea id="sfMdObs" maxlength="4000"></textarea>
        </div>
        </div>
        <p class="sf-msg" id="sfMdMsg"></p>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline" onclick="sfFecharDivida()">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="sfMdSalvar" data-requer-edicao>Salvar</button>
        </div>
      </form>
    </div>
  </div>

  <script id="sfData" type="application/json" is:inline set:html={ilha}></script>
  <script>import "../../scripts/situacaoFinanceira.ts";</script>

  <style is:global>
    /* Situação Financeira — classes com prefixo sf- (global: o HTML é montado por innerHTML) */
    .sf-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 14px; }
    .sf-title { font-family: 'Montserrat', sans-serif; font-size: 1.35rem; font-weight: 800; color: var(--ink); letter-spacing: -.01em; }
    .sf-sub { color: var(--ink-mid); font-size: .88rem; margin-top: 3px; }
    .sf-head-live { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .sf-live-st { display: inline-flex; align-items: center; gap: 7px; font-size: .8rem; font-weight: 700; padding: 5px 11px; border-radius: 99px; background: var(--gray-100); color: var(--ink-mid); }
    .sf-live-st .spinner { width: 13px; height: 13px; border-width: 2px; }
    .sf-live-ok { background: var(--success-bg); color: var(--success-fg); }
    .sf-live-cache { background: var(--info-bg); color: var(--info-fg); }
    .sf-live-erro { background: var(--warning-bg); color: var(--warning-fg); }
    .sf-pills { margin-bottom: 18px; }
    .sf-sec { min-width: 0; }

    .sf-box { border-radius: var(--radius-md); padding: 12px 16px; margin-bottom: 14px; font-size: .9rem; line-height: 1.5; border: 1px solid transparent; }
    .sf-box strong { margin-right: 4px; }
    .sf-box-amarelo { background: var(--warning-bg); color: var(--warning-fg); border-color: #FDE68A; }
    .sf-box-vermelho { background: var(--danger-bg); color: var(--danger-fg); border-color: #FECACA; }
    .sf-box-azul { background: var(--info-bg); color: var(--info-fg); border-color: #BFDBFE; }
    .sf-box-verde { background: var(--success-bg); color: var(--success-fg); border-color: #BBF7D0; }

    .sf-blk { margin-bottom: 22px; }
    .sf-blk-title { display: flex; align-items: center; gap: 8px; font-family: 'Montserrat', sans-serif; font-size: .8rem; font-weight: 800; color: var(--ink-mid); margin: 0 0 11px; text-transform: uppercase; letter-spacing: .06em; }
    .sf-blk-title i { font-size: 16px; color: var(--brand); }
    .sf-tag-vivo { background: var(--success-bg); color: var(--success-fg); font-size: .62rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; padding: 2px 8px; border-radius: 99px; }
    .sf-tag-salvo { background: var(--gray-100); color: var(--ink-mid); font-size: .62rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; padding: 2px 8px; border-radius: 99px; }
    .sf-muted { color: var(--ink-light); font-size: .8rem; }
    .sf-small { font-size: .78rem; color: var(--ink-mid); }
    .sf-nota { font-size: .8rem; color: var(--ink-mid); line-height: 1.5; margin-top: 10px; }
    .sf-num { font-variant-numeric: tabular-nums; white-space: nowrap; text-align: right; }
    th.sf-num { text-align: right; }
    .sf-neg { color: var(--danger); font-weight: 700; }
    .sf-pos { color: var(--success); font-weight: 700; }

    /* Cartões grandes por grupo */
    .sf-grupos { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
    .sf-gcard { background: var(--surface); border: 1px solid var(--border); border-top: 5px solid var(--c, var(--brand)); border-radius: var(--radius-lg); padding: 16px 18px; box-shadow: var(--shadow-sm); cursor: pointer; transition: var(--transition); min-width: 0; }
    .sf-gcard:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
    .sf-gcard-head { display: flex; align-items: center; gap: 9px; margin-bottom: 10px; }
    .sf-gcard-ic { width: 34px; height: 34px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; font-size: 18px; color: var(--c); background: color-mix(in srgb, var(--c) 13%, #fff); flex: none; }
    .sf-gcard-nome { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: .98rem; flex: 1; }
    .sf-gcard-v { font-family: 'Montserrat', sans-serif; font-size: 1.45rem; font-weight: 800; color: var(--ink); line-height: 1.15; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .sf-gcard-v2 { font-size: .86rem; color: var(--ink-mid); margin-top: 4px; font-weight: 600; }
    .sf-gcard-txt { font-size: .82rem; color: var(--ink-mid); line-height: 1.45; margin-top: 8px; }
    .sf-gcard-ref { font-size: .72rem; color: var(--ink-light); margin-top: 6px; }
    .sf-gcard-vivo { font-size: .84rem; color: var(--ink); margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--border); display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; }
    .sf-gcard-edit { font-size: .8rem; color: var(--info-fg); background: var(--info-bg); border-radius: var(--radius-sm); padding: 6px 8px; margin-top: 8px; line-height: 1.4; }

    /* Barra empilhada da composição */
    .sf-stack { display: flex; height: 34px; border-radius: 8px; overflow: hidden; background: var(--gray-100); }
    .sf-stack-seg { height: 100%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: .75rem; font-weight: 800; min-width: 2px; white-space: nowrap; overflow: hidden; }
    .sf-leg { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 11px; font-size: .82rem; color: var(--ink-mid); }
    .sf-leg-i { display: inline-flex; align-items: center; gap: 6px; }
    .sf-dot { display: inline-block; width: 11px; height: 11px; border-radius: 3px; flex: none; }

    /* Escada do faturamento necessário */
    .sf-meta-v { font-family: 'Montserrat', sans-serif; font-size: 1.6rem; font-weight: 800; color: var(--brand); font-variant-numeric: tabular-nums; }
    .sf-escada { display: flex; flex-direction: column; gap: 12px; margin-top: 14px; }
    .sf-degrau-top { display: flex; justify-content: space-between; gap: 10px; font-size: .84rem; margin-bottom: 4px; }
    .sf-degrau-top strong { font-variant-numeric: tabular-nums; white-space: nowrap; }
    .sf-degrau-quando { font-size: .74rem; color: var(--ink-light); margin-top: 2px; }
    .sf-trilho { position: relative; height: 20px; background: var(--gray-100); border-radius: 6px; }
    .sf-trilho-bar { height: 100%; border-radius: 6px; }
    .sf-marca { position: absolute; top: -4px; bottom: -4px; width: 3px; border-radius: 2px; transform: translateX(-1px); }
    .sf-marca-3 { background: #0F766E; }
    .sf-marca-6 { background: #7C3AED; }
    .sf-degrau-conta { font-size: .74rem; color: var(--ink-light); margin-top: 4px; }
    .sf-degrau-inviavel { border: 1px dashed var(--border-strong); border-radius: var(--radius-md); padding: 9px 11px; background: var(--gray-50); }

    /* Números que decidem */
    .sf-nums { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
    .sf-numc { border-radius: var(--radius-md); padding: 13px 15px; border: 1px solid var(--border); background: var(--surface); border-left: 5px solid var(--gray-300); min-width: 0; }
    .sf-numc-t { font-size: .78rem; font-weight: 700; color: var(--ink-mid); text-transform: uppercase; letter-spacing: .03em; }
    .sf-numc-v { font-family: 'Montserrat', sans-serif; font-size: 1.22rem; font-weight: 800; margin-top: 4px; overflow-wrap: break-word; }
    .sf-numc-d { font-size: .8rem; color: var(--ink-mid); margin-top: 5px; line-height: 1.45; }
    .sf-tom-vermelho { border-left-color: var(--danger); background: #FFF7F7; }
    .sf-tom-vermelho .sf-numc-v { color: var(--danger-fg); }
    .sf-tom-amarelo { border-left-color: #D97706; background: #FFFBEB; }
    .sf-tom-amarelo .sf-numc-v { color: var(--warning-fg); }
    .sf-tom-verde { border-left-color: var(--success); background: #F3FDF6; }
    .sf-tom-verde .sf-numc-v { color: var(--success-fg); }

    /* Recolhíveis */
    .sf-det { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); margin-bottom: 8px; }
    .sf-det > summary { cursor: pointer; padding: 11px 14px; font-weight: 700; font-size: .9rem; list-style: none; display: flex; align-items: center; gap: 8px; }
    .sf-det > summary::-webkit-details-marker { display: none; }
    .sf-det > summary::before { content: "▸"; color: var(--ink-light); transition: transform .15s; display: inline-block; }
    .sf-det[open] > summary::before { transform: rotate(90deg); }
    .sf-det-body { padding: 0 14px 13px 30px; font-size: .88rem; color: var(--ink-mid); line-height: 1.55; white-space: pre-line; }
    .sf-det-alerta > summary { color: var(--danger-fg); }

    /* Tabelas */
    .sf-table td { vertical-align: top; }
    .sf-table .sf-sub-head td { background: var(--gray-50); font-weight: 800; color: var(--ink); font-family: 'Montserrat', sans-serif; font-size: .86rem; }
    .sf-table .sf-sub-tot td { background: #FAFBFC; font-weight: 700; color: var(--ink-mid); font-size: .86rem; }
    .sf-table tfoot td { font-weight: 800; background: var(--gray-50); border-top: 2px solid var(--border); }
    .sf-table .sf-obs { max-width: 340px; font-size: .82rem; color: var(--ink-mid); line-height: 1.45; }
    .sf-selo-retido { display: inline-block; background: var(--danger); color: #fff; font-size: .68rem; font-weight: 800; padding: 2px 8px; border-radius: 99px; margin-top: 4px; white-space: nowrap; }
    .sf-selo-prot { display: inline-block; background: var(--danger-bg); color: var(--danger-fg); border: 1px solid #FECACA; font-size: .68rem; font-weight: 800; padding: 1px 7px; border-radius: 99px; margin-left: 6px; white-space: nowrap; vertical-align: middle; }
    .sf-selo-pago, .sf-selo-cpf { display: inline-block; font-size: .68rem; font-weight: 800; padding: 1px 7px; border-radius: 99px; margin: 4px 6px 0 0; white-space: nowrap; }
    .sf-selo-pago { background: var(--success-bg); color: var(--success-fg); border: 1px solid #BBF7D0; }
    .sf-selo-cpf { background: var(--info-bg); color: var(--info-fg); border: 1px solid #BFDBFE; }
    .sf-ed { background: none; border: 1px solid var(--border); border-radius: 6px; color: var(--ink-mid); cursor: pointer; padding: 3px 7px; font-size: .8rem; }
    .sf-ed:hover { color: var(--brand); border-color: var(--brand); }

    .sf-fazer { background: #F0F9FF; border: 1px solid #BAE6FD; border-radius: var(--radius-md); padding: 14px 16px; }
    .sf-fazer h4 { font-family: 'Montserrat', sans-serif; font-size: .92rem; color: #075985; margin-bottom: 8px; }
    .sf-fazer ol { padding-left: 20px; font-size: .88rem; line-height: 1.55; color: #0C4A6E; }
    .sf-fazer li + li { margin-top: 4px; }

    .sf-kpis { display: grid; grid-template-columns: repeat(auto-fill, minmax(175px, 1fr)); gap: 10px; margin-bottom: 14px; }
    .sf-kpi { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 11px 13px; min-width: 0; }
    .sf-kpi-v { font-family: 'Montserrat', sans-serif; font-size: 1.05rem; font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .sf-kpi-l { font-size: .76rem; color: var(--ink-mid); margin-top: 3px; }

    .sf-toolbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 12px; }
    .sf-toolbar .search-input { flex: 1; min-width: 180px; }
    .sf-toolbar label.sf-chk { display: inline-flex; align-items: center; gap: 6px; font-size: .86rem; color: var(--ink-mid); cursor: pointer; }

    /* Gráfico mensal (receita x despesas) */
    .sf-chart-wrap { overflow-x: auto; }
    .sf-chart { display: flex; align-items: flex-end; gap: 8px; height: 210px; min-width: 560px; padding-top: 10px; border-bottom: 2px solid var(--border); background: repeating-linear-gradient(to top, transparent 0, transparent 41px, var(--gray-100) 41px, var(--gray-100) 42px); }
    .sf-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 6px; min-width: 0; }
    .sf-pair { display: flex; align-items: flex-end; gap: 3px; height: 180px; }
    .sf-bar { width: 16px; border-radius: 3px 3px 0 0; }
    .sf-stackv { width: 16px; display: flex; flex-direction: column-reverse; border-radius: 3px 3px 0 0; overflow: hidden; }
    .sf-stackv > div { width: 100%; }
    .sf-col-l { font-size: 10.5px; color: var(--ink-light); white-space: nowrap; }

    /* Plano de ação */
    .sf-top10 { list-style: none; counter-reset: top; display: flex; flex-direction: column; gap: 8px; }
    .sf-top10 li { counter-increment: top; display: flex; gap: 12px; align-items: flex-start; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 11px 14px; }
    .sf-top10 li::before { content: counter(top); flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--brand); color: #fff; font-weight: 800; font-family: 'Montserrat', sans-serif; display: inline-flex; align-items: center; justify-content: center; font-size: .86rem; }
    .sf-top10 a { color: var(--ink); font-weight: 700; text-decoration: none; }
    .sf-top10 a:hover { color: var(--brand); text-decoration: underline; }
    .sf-top10 p { font-size: .84rem; color: var(--ink-mid); margin-top: 3px; line-height: 1.45; }
    .sf-cont { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
    .sf-ideias { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 14px; }
    .sf-ideia { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 16px 18px; box-shadow: var(--shadow-sm); min-width: 0; scroll-margin-top: 80px; }
    .sf-ideia.sf-alvo { box-shadow: 0 0 0 3px var(--brand-ring); }
    .sf-ideia-descartada { opacity: .78; border-style: dashed; }
    .sf-ideia-h { font-family: 'Montserrat', sans-serif; font-size: 1rem; font-weight: 800; color: var(--ink); line-height: 1.3; }
    .sf-ideia-cod { color: var(--ink-light); font-weight: 700; margin-right: 4px; }
    .sf-selos { display: flex; flex-wrap: wrap; gap: 5px; margin: 8px 0; }
    .sf-selos .badge { white-space: normal; text-align: left; line-height: 1.35; max-width: 100%; }
    .sf-pot { font-size: .86rem; color: var(--ink); background: var(--success-bg); border-radius: var(--radius-sm); padding: 8px 10px; margin: 6px 0 10px; line-height: 1.45; }
    .sf-campo { margin-top: 9px; font-size: .86rem; line-height: 1.5; color: var(--ink-mid); }
