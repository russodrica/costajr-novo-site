---
// Pedidos dos marketplaces — a ponte que o Bling fazia.
//
// O que aconteceu (11/08/2026): a Adriana saiu do Bling em 21/06 e ninguém
// percebeu que a esteira de pedidos tinha parado junto. A tela
// `/pedidos-marketplaces` da TrazPraCa só se alimenta pelo Bling — o último
// pedido que chegou lá é justamente de 21/06. Resultado: a venda de 08/08
// (luminária Millennium Falcon) ficou com etiqueta impressa e nenhum pedido
// ao fornecedor, e a de 11/08 (kit vinho) foi cancelada pelo comprador por
// falta de estoque.
//
// Esta tela é a ponta de baixo da ponte. O robô (src/pedidos_main.py) lê as
// vendas no Mercado Livre e grava aqui tudo que o formulário
// `/pedidos-cadastro` da TrazPraCa pede. Aqui a Adriana copia e cadastra.
//
// A compra NÃO é automática, e isso é decisão, não limitação: cadastrar e
// pagar o pedido no fornecedor é dinheiro saindo da carteira dela. O portal
// prepara tudo; o clique final é dela — a mesma regra da aprovação de
// anúncios.
import Admin from "../../../layouts/Admin.astro";
import { verifyToken, type AdminClaims } from "../../../lib/auth";
import { temPerfilFresco } from "../../../lib/permissoes";
import { supabaseAdmin } from "../../../lib/supabase";

const token = Astro.cookies.get("admin_token")?.value;
if (!token) return Astro.redirect("/admin/login");
let claims: AdminClaims;
try { claims = await verifyToken<AdminClaims>(token); if (claims.tipo !== "admin") throw new Error(); }
catch { Astro.cookies.delete("admin_token", { path: "/" }); return Astro.redirect("/admin/login"); }
if (!(await temPerfilFresco(claims, ["admin"]))) return Astro.redirect("/admin");

const db = supabaseAdmin();
const [ped, exec] = await Promise.all([
  db.from("vendas_pedidos").select("*").order("vendido_em", { ascending: false }).limit(300),
  db.from("vendas_sync_log").select("*").eq("tipo", "pedidos").order("executado_em", { ascending: false }).limit(1),
]);

// A tela precisa abrir mesmo antes da migration 088 rodar — erro 500 sem
// explicação é a pior forma de descobrir que falta rodar uma migration.
const faltaMigration = !!ped.error;
const pedidos: any[] = ped.data || [];
const ultimaExec: any = (exec.data || [])[0] || null;

const fdt = (s: any) => (s ? new Date(s).toLocaleString("pt-BR", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" }) : "—");
const fdata = (s: any) => (s ? new Date(s).toLocaleDateString("pt-BR") : "—");
const fmt$ = (n: any) => (n == null ? "—" : Number(n).toLocaleString("pt-BR", { style: "currency", currency: "BRL" }));

// Vendas canceladas e compras já feitas saem da fila; o que sobra é trabalho.
const aComprar = pedidos.filter((p) => p.fornecedor_status === "a_comprar" && p.status_canal !== "cancelled");
const feitos = pedidos.filter((p) => p.fornecedor_status === "comprado");
const foraDeJogo = pedidos.filter((p) => p.fornecedor_status === "nao_aplicavel" || p.status_canal === "cancelled");

// Atraso = o ML já pediu o despacho e a compra no fornecedor ainda não foi
// feita. É exatamente o buraco em que a venda de 08/08 caiu.
const hoje = new Date();
const atrasado = (p: any) => p.prazo_despacho && new Date(p.prazo_despacho) < hoje;
const atrasados = aComprar.filter(atrasado);

const totalAComprar = aComprar.reduce((s, p) => s + Number(p.custo_fornecedor || 0), 0);

// ---------------------------------------------------------------------------
// Resultado das vendas — "total vendido e o lucro, total e por mês"
// (Adriana, 16/08/2026). Venda cancelada não conta como vendida. O lucro usa
// a tarifa e o frete REAIS que o ML cobrou (colunas desta tabela), menos o
// custo do fornecedor; venda sem custo conhecido entra no total vendido mas
// fica de fora do lucro — e a tela diz quantas são, em vez de fingir zero.
// ---------------------------------------------------------------------------
const vendidas = pedidos.filter((p) => !["cancelled", "invalid"].includes(String(p.status_canal || "").toLowerCase()));
const comLucro = vendidas.filter((p) => p.liquido != null && p.custo_fornecedor != null);
const semCusto = vendidas.length - comLucro.length;
const totalVendido = vendidas.reduce((s, p) => s + Number(p.valor_total || 0), 0);
const lucroTotal = comLucro.reduce((s, p) => s + (Number(p.liquido) - Number(p.custo_fornecedor)), 0);
const receitaComLucro = comLucro.reduce((s, p) => s + Number(p.valor_total || 0), 0);
const margemGeral = receitaComLucro > 0 ? (lucroTotal / receitaComLucro) * 100 : null;
const totalCancelado = pedidos
  .filter((p) => String(p.status_canal || "").toLowerCase() === "cancelled")
  .reduce((s, p) => s + Number(p.valor_total || 0), 0);

const MESES = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];
const porMes: Record<string, { rotulo: string; vendas: number; vendido: number; lucro: number; semCusto: number; cancelado: number }> = {};
for (const p of pedidos) {
  if (!p.vendido_em) continue;
  const d = new Date(p.vendido_em);
  const chave = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
  const m = (porMes[chave] ||= { rotulo: `${MESES[d.getMonth()]}/${d.getFullYear()}`, vendas: 0, vendido: 0, lucro: 0, semCusto: 0, cancelado: 0 });
  if (["cancelled", "invalid"].includes(String(p.status_canal || "").toLowerCase())) {
    m.cancelado += Number(p.valor_total || 0);
    continue;
  }
  m.vendas += 1;
  m.vendido += Number(p.valor_total || 0);
  if (p.liquido != null && p.custo_fornecedor != null) m.lucro += Number(p.liquido) - Number(p.custo_fornecedor);
  else m.semCusto += 1;
}
const mesesOrdenados = Object.keys(porMes).sort().reverse().map((k) => porMes[k]);

const CANAL_LABEL: Record<string, string> = {
  mercadolivre: "Mercado Livre", shopee: "Shopee",
};

// Texto pronto para colar no formulário deles, campo a campo, na ordem do
// assistente de 5 passos (Cliente → Endereço → Marketplace → Produtos).
const blocoDe = (p: any) => {
  const itens = (p.itens || []).map((i: any) =>
    `${i.quantidade || 1}x  SKU ${i.sku || "?"}  —  ${i.nome || ""}`).join("\n");
  return [
    `Nome: ${p.comprador_nome || ""}`,
    `CPF/CNPJ: ${p.comprador_documento || ""}`,
    `Celular: ${p.comprador_celular || ""}`,
    `CEP: ${p.entrega_cep || ""}`,
    `Rua: ${p.entrega_rua || ""}`,
    `Número: ${p.entrega_numero || ""}`,
    `Complemento: ${p.entrega_complemento || ""}`,
    `Bairro: ${p.entrega_bairro || ""}`,
    `Cidade: ${p.entrega_cidade || ""}`,
    `Estado: ${p.entrega_estado || ""}`,
    `Marketplace: ${p.canal || ""}`,
    `Produtos:`,
    itens,
  ].join("\n");
};

const linhas = pedidos.map((p) => ({ ...p, bloco: blocoDe(p), atrasado: atrasado(p) }));
---

<Admin title="Pedidos dos marketplaces" current="vendas-pedidos">
  <div style="max-width:1100px">
    <h1 style="margin:0 0 4px">Pedidos dos marketplaces</h1>
    <p style="color:#6B7280;margin:0 0 18px">
      As vendas do Mercado Livre, prontas para cadastrar na TrazPraCa em
      <a href="https://app.trazpracaclub.com.br/pedidos-cadastro" target="_blank" rel="noopener">Pedidos → Cadastrar Pedido</a>.
      Última leitura: {ultimaExec ? fdt(ultimaExec.executado_em) : "nunca"}.
      <br />
      A cada 2 horas o robô confere a tela do fornecedor e marca sozinho o que já foi
      <strong> comprado</strong> e o que já foi <strong>despachado</strong> (com o código de rastreio).
      Os botões abaixo continuam valendo para corrigir na mão.
    </p>

    {/*
      O botão que ela pediu (21/08/2026): "assim que eu receba mensagem de que
      algo foi vendido, eu consiga apertar e esse botão trazer as informações
      pro meu painel. Pois, preciso saber os custos do produto para não pagar
      errado."

      Antes disso a leitura só existia dentro do robô no GitHub Actions — e
      quando o orçamento do Actions estourou, em 20/08, TODA venda parou de
      chegar. Este botão lê o Mercado Livre aqui mesmo, na Vercel: não gasta
      minuto de Actions e funciona mesmo com o robô bloqueado.

      Ele só LÊ. Não compra e não paga nada — e não desfaz o que já foi
      marcado como comprado nesta tela.
    */}
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:18px">
      <button
        type="button"
        id="btn-buscar"
        style="padding:12px 20px;border:0;border-radius:8px;background:#1D4ED8;color:#fff;font-size:15px;font-weight:600;cursor:pointer"
      >
        Buscar vendas agora
      </button>
      <span style="color:#6B7280;font-size:13px">
        Puxa direto do Mercado Livre as vendas dos últimos 7 dias, com o custo real de cada produto.
      </span>
    </div>

    {faltaMigration && (
      <div style="background:#FEF3C7;border:1px solid #F59E0B;border-radius:8px;padding:14px;margin-bottom:18px">
        <strong>Falta rodar a migration 088.</strong> A tabela <code>vendas_pedidos</code> ainda não existe no banco.
        Rode <code>db/migrations/088_vendas_pedidos.sql</code> no Supabase e recarregue esta página.
      </div>
    )}

    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:20px">
      <div style="flex:1;min-width:170px;background:#FEE2E2;border-radius:8px;padding:14px">
        <div style="font-size:26px;font-weight:700;color:#B91C1C">{aComprar.length}</div>
        <div style="color:#7F1D1D;font-size:13px">a comprar na TrazPraCa</div>
      </div>
      <div style="flex:1;min-width:170px;background:#FEF3C7;border-radius:8px;padding:14px">
        <div style="font-size:26px;font-weight:700;color:#B45309">{atrasados.length}</div>
        <div style="color:#78350F;font-size:13px">com prazo de despacho vencido</div>
      </div>
      <div style="flex:1;min-width:170px;background:#DCFCE7;border-radius:8px;padding:14px">
        <div style="font-size:26px;font-weight:700;color:#15803D">{feitos.length}</div>
        <div style="color:#14532D;font-size:13px">já comprados</div>
      </div>
      <div style="flex:1;min-width:170px;background:#F3F4F6;border-radius:8px;padding:14px">
        <div style="font-size:26px;font-weight:700">{fmt$(totalAComprar)}</div>
        <div style="color:#6B7280;font-size:13px">custo estimado do que falta</div>
      </div>
    </div>

    <div style="border:1px solid #E5E7EB;border-radius:10px;padding:16px;margin-bottom:20px;background:#fff">
      <h2 style="margin:0 0 10px;font-size:16px">Resultado das vendas</h2>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:12px">
        <div style="flex:1;min-width:150px;background:#EFF6FF;border-radius:8px;padding:12px">
          <div style="font-size:22px;font-weight:700;color:#1D4ED8">{fmt$(totalVendido)}</div>
          <div style="color:#1E40AF;font-size:13px">total vendido ({vendidas.length} venda{vendidas.length === 1 ? "" : "s"})</div>
        </div>
        <div style="flex:1;min-width:150px;background:#DCFCE7;border-radius:8px;padding:12px">
          <div style="font-size:22px;font-weight:700;color:#15803D">{fmt$(lucroTotal)}</div>
          <div style="color:#14532D;font-size:13px">
            lucro real{margemGeral != null ? ` (${margemGeral.toFixed(1).replace(".", ",")}% da receita medida)` : ""}
          </div>
        </div>
        <div style="flex:1;min-width:150px;background:#F3F4F6;border-radius:8px;padding:12px">
          <div style="font-size:22px;font-weight:700;color:#6B7280">{fmt$(totalCancelado)}</div>
          <div style="color:#6B7280;font-size:13px">cancelado (não conta como vendido)</div>
        </div>
      </div>
      {semCusto > 0 && (
        <p style="color:#B45309;font-size:13px;margin:0 0 10px">
          {semCusto} venda{semCusto === 1 ? "" : "s"} sem custo do fornecedor identificado — entra{semCusto === 1 ? "" : "m"} no total vendido, mas fica{semCusto === 1 ? "" : "m"} fora do lucro.
        </p>
      )}
      {mesesOrdenados.length > 0 && (
        <table style="width:100%;border-collapse:collapse;font-size:14px">
          <thead>
            <tr style="text-align:left;color:#6B7280;border-bottom:1px solid #E5E7EB">
              <th style="padding:6px 8px">Mês</th>
              <th style="padding:6px 8px">Vendas</th>
              <th style="padding:6px 8px">Total vendido</th>
              <th style="padding:6px 8px">Lucro real</th>
              <th style="padding:6px 8px">Cancelado</th>
            </tr>
          </thead>
          <tbody>
            {mesesOrdenados.map((m) => (
              <tr style="border-bottom:1px solid #F3F4F6">
                <td style="padding:6px 8px;font-weight:600">{m.rotulo}</td>
                <td style="padding:6px 8px">{m.vendas}</td>
                <td style="padding:6px 8px">{fmt$(m.vendido)}</td>
                <td style="padding:6px 8px;color:#15803D">{fmt$(m.lucro)}{m.semCusto > 0 ? ` (+${m.semCusto} sem custo)` : ""}</td>
                <td style="padding:6px 8px;color:#B91C1C">{m.cancelado > 0 ? fmt$(m.cancelado) : "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
      <p style="color:#9CA3AF;font-size:12px;margin:10px 0 0">
        Tarifa e frete reais do Mercado Livre, venda a venda. Enquanto a permissão de Pedidos
        do DevCenter não sai, as vendas entram por registro manual/retroativo; depois, o robô
        de 2 em 2 horas atualiza sozinho.
      </p>
    </div>

    <div id="aviso" style="display:none;border-radius:8px;padding:12px;margin-bottom:16px"></div>

    {linhas.length === 0 && !faltaMigration && (
      <p style="color:#6B7280">
        Nenhuma venda lida ainda. Rode o workflow <strong>“Vendas - Pedidos dos marketplaces”</strong> no GitHub.
      </p>
    )}

    {linhas.map((p) => (
      <div data-pedido={p.id} style={`border:1px solid ${p.atrasado && p.fornecedor_status === "a_comprar" ? "#DC2626" : "#E5E7EB"};border-radius:10px;padding:16px;margin-bottom:14px;background:${p.fornecedor_status === "comprado" ? "#F8FDF9" : p.fornecedor_status === "nao_aplicavel" ? "#FAFAFA" : "#fff"}`}>
        <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:flex-start">
          <div>
            <div style="font-weight:600">
              {CANAL_LABEL[p.canal] || p.canal} · #{p.pedido_canal}
              {p.status_canal === "cancelled" && <span style="margin-left:8px;background:#F3F4F6;color:#6B7280;border-radius:99px;padding:2px 10px;font-size:12px">venda cancelada</span>}
              {p.fornecedor_status === "comprado" && <span style="margin-left:8px;background:#DCFCE7;color:#15803D;border-radius:99px;padding:2px 10px;font-size:12px">comprado</span>}
              {p.fornecedor_status === "a_comprar" && p.status_canal !== "cancelled" && <span style="margin-left:8px;background:#FEE2E2;color:#B91C1C;border-radius:99px;padding:2px 10px;font-size:12px">a comprar</span>}
              {/* Situação lida sozinha na tela da TrazPraCa (migration 109). */}
              {p.fornecedor_situacao && (
                <span style={`margin-left:8px;border-radius:99px;padding:2px 10px;font-size:12px;${
                  ["ATENDIDO", "ENVIADO", "ENTREGUE"].includes(p.fornecedor_situacao)
                    ? "background:#DBEAFE;color:#1D4ED8"
                    : p.fornecedor_situacao === "DELETADO" || p.fornecedor_situacao === "CANCELADO"
                    ? "background:#F3F4F6;color:#6B7280"
                    : "background:#FEF3C7;color:#B45309"}`}>
                  fornecedor: {p.fornecedor_situacao.toLowerCase()}
                </span>
              )}
            </div>
            <div style="color:#6B7280;font-size:13px;margin-top:2px">
              Vendido em {fdt(p.vendido_em)}
              {p.prazo_despacho && ` · despachar até ${fdata(p.prazo_despacho)}`}
              {p.comprado_em && ` · comprado em ${fdt(p.comprado_em)}`}
              {p.comprado_por === "trazpraca_automatico" && " (detectado automaticamente)"}
            </div>
            {(p.fornecedor_rastreio || p.fornecedor_enviado_em) && (
              <div style="color:#1D4ED8;font-size:13px;margin-top:4px">
                📦 Despachado pelo fornecedor
                {p.fornecedor_enviado_em && ` em ${fdt(p.fornecedor_enviado_em)}`}
                {p.fornecedor_rastreio && <> · rastreio <strong>{p.fornecedor_rastreio}</strong></>}
              </div>
            )}
            {/* O vigia da declaração (18/08): envio em invoice_pending = o
                botão da Declaração de Conteúdo está LIBERADO no painel do ML
                — emitir destrava a etiqueta, que aí desce para a TrazPraCa. */}
            {p.etiqueta_status === "declaracao_pendente_no_ml" && p.status_canal !== "cancelled" && (
              <div style="background:#FFF7ED;border:1px solid #FED7AA;border-radius:8px;padding:8px 12px;margin-top:6px;color:#9A3412;font-size:13px">
                📋 <strong>Declaração de Conteúdo liberada no Mercado Livre</strong> — emita no
                painel do ML (Vendas → esta venda) para destravar a etiqueta.
                {" "}<a href="https://www.mercadolivre.com.br/vendas/omni/listing" target="_blank" rel="noopener">Abrir minhas vendas</a>
              </div>
            )}
          </div>
          <div style="text-align:right">
            <div style="font-size:18px;font-weight:700">{fmt$(p.valor_total)}</div>
            {/* Os TRES custos de cada venda, abertos (pedido da Adriana,
                17/08): produto (TrazPraCa) + frete + tarifa do ML. */}
            <div style="color:#6B7280;font-size:12px;line-height:1.6">
              tarifa ML −{fmt$(p.tarifa_canal)} · frete ML −{fmt$(p.frete_canal)}<br />
              produto −{fmt$(p.custo_fornecedor)} ·{" "}
              {p.liquido != null && p.custo_fornecedor != null ? (
                <strong style={`color:${Number(p.liquido) - Number(p.custo_fornecedor) >= 0 ? "#059669" : "#DC2626"}`}>
                  resultado {fmt$(Number(p.liquido) - Number(p.custo_fornecedor))}
                </strong>
              ) : (
                <span>resultado — falta custo</span>
              )}
            </div>
          </div>
        </div>

        <ul style="margin:10px 0 12px;padding-left:18px;color:#374151">
          {(p.itens || []).map((i: any) => (
            <li>{i.quantidade || 1}× <strong>SKU {i.sku || "sem SKU"}</strong> — {i.nome}</li>
          ))}
        </ul>

        {/* A cobranca do fornecedor conferida: o robo grava o que ela PAGOU
            (fornecedor_pago) e compara com o custo do produto. */}
        {p.fornecedor_pago != null && p.custo_fornecedor != null &&
          Math.abs(Number(p.fornecedor_pago) - Number(p.custo_fornecedor)) > 0.05 && (
          <div style="background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;padding:8px 12px;margin:0 0 12px;color:#991B1B;font-size:13px">
            ⚠ A TrazPraCa cobrou <strong>{fmt$(p.fornecedor_pago)}</strong> neste pedido, mas o custo do
            produto é <strong>{fmt$(p.custo_fornecedor)}</strong> (diferença de{" "}
            {fmt$(Number(p.fornecedor_pago) - Number(p.custo_fornecedor))}). A cobrança certa é só o
            custo do produto — conteste pelo Chamado deles.
          </div>
        )}

        {/* A TrazPraCa confirmou (17/08): o pagamento do pedido la e SO o
            custo do produto. A automacao deles ja cobrou frete embutido por
            engano (pedido #26622148877: R$ 50,02 por um produto de R$ 26,72)
            — por isso o valor certo fica aqui, na cara, antes de pagar. */}
        {p.fornecedor_status !== "comprado" && p.status_canal !== "cancelled" && p.custo_fornecedor != null && (
          <div style="background:#FFFBEB;border:1px solid #FDE68A;border-radius:8px;padding:8px 12px;margin:0 0 12px;color:#92400E;font-size:13px">
            💰 Ao pagar na TrazPraCa, o valor certo é <strong>{fmt$(p.custo_fornecedor)}</strong> — só o
            custo do produto. Se vier mais que isso, é erro deles: conteste pelo Chamado antes de pagar.
          </div>
        )}

        <details>
          <summary style="cursor:pointer;color:#2563EB;font-size:14px">Dados para cadastrar na TrazPraCa</summary>
          <pre data-bloco style="background:#F9FAFB;border:1px solid #E5E7EB;border-radius:8px;padding:12px;margin-top:8px;white-space:pre-wrap;font-size:13px">{p.bloco}</pre>
          {!p.comprador_documento && (
            <p style="color:#B45309;font-size:13px;margin:4px 0">
              O Mercado Livre não devolveu o CPF desta venda — pegue no detalhe da venda e complete no formulário.
            </p>
          )}
          <button type="button" data-copiar style="margin-top:6px;padding:8px 14px;border:1px solid #D1D5DB;border-radius:6px;background:#fff;cursor:pointer">Copiar tudo</button>
        </details>

        {p.fornecedor_status !== "comprado" && p.status_canal !== "cancelled" && (
          <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:12px">
            <input data-numero placeholder="nº do pedido na TrazPraCa (opcional)" style="padding:8px 10px;border:1px solid #D1D5DB;border-radius:6px;min-width:260px" />
            <button type="button" data-comprado style="padding:8px 14px;border:0;border-radius:6px;background:#15803D;color:#fff;cursor:pointer">Já comprei na TrazPraCa</button>
            <button type="button" data-naoaplica style="padding:8px 14px;border:1px solid #D1D5DB;border-radius:6px;background:#fff;cursor:pointer">Não se aplica</button>
          </div>
        )}
        {p.fornecedor_status === "comprado" && (
          <div style="margin-top:10px;font-size:13px;color:#15803D">
            Pedido {p.fornecedor_pedido ? `nº ${p.fornecedor_pedido} ` : ""}registrado por {p.comprado_por || "—"}.
            <button type="button" data-desfazer style="margin-left:8px;padding:4px 10px;border:1px solid #D1D5DB;border-radius:6px;background:#fff;cursor:pointer;font-size:12px">desfazer</button>
          </div>
        )}
      </div>
    ))}
  </div>
</Admin>

<script is:inline>
  // Sem confirm() e sem alert(): a Adriana já apertou um botão que não deu
  // sinal de vida (05/08) e ficou sem saber se tinha funcionado. Toda
  // resposta aparece na própria página.
  function aviso(texto, tipo) {
    const el = document.getElementById("aviso");
    const cores = {
      ok:   ["#DCFCE7", "#15803D"],
      erro: ["#FEE2E2", "#B91C1C"],
      info: ["#EFF6FF", "#1D4ED8"],
    }[tipo] || ["#F3F4F6", "#374151"];
    el.style.background = cores[0];
    el.style.color = cores[1];
    el.textContent = texto;
    el.style.display = "block";
    el.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  async function marcar(cartao, estado) {
    const id = cartao.getAttribute("data-pedido");
    const numero = (cartao.querySelector("[data-numero]") || {}).value || "";
    aviso("Salvando…", "info");
    try {
      const r = await fetch("/api/admin/vendas/pedidos", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id, fornecedor_status: estado, fornecedor_pedido: numero }),
      });
      const j = await r.json().catch(() => ({}));
      if (!r.ok) { aviso(j.error || j.message || `Erro ${r.status}`, "erro"); return; }
      aviso(estado === "comprado" ? "Marcado como comprado. Recarregando…" : "Atualizado. Recarregando…", "ok");
      setTimeout(() => location.reload(), 700);
    } catch (e) {
      aviso("Falha de rede: " + e.message, "erro");
    }
  }

  // Buscar vendas agora — a leitura do ML feita pelo próprio portal.
  //
  // Trava o botão enquanto roda: dois cliques seguidos não duplicam pedido
  // (a chave única canal+numero impede), mas duplicam a espera e confundem.
  // Enquanto espera, o texto muda — botão que não dá sinal de vida é o erro
  // que já aconteceu aqui em 05/08.
  const btn = document.getElementById("btn-buscar");
  if (btn) {
    btn.addEventListener("click", async () => {
      const original = btn.textContent;
      btn.disabled = true;
      btn.style.opacity = "0.6";
      btn.style.cursor = "wait";
      btn.textContent = "Buscando no Mercado Livre…";
      aviso("Lendo as vendas no Mercado Livre e cruzando com o custo da ficha. Pode levar até um minuto.", "info");
      try {
        const r = await fetch("/api/admin/vendas/pedidos/sincronizar", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ dias: 7 }),
        });
        const j = await r.json().catch(() => ({}));
        if (!r.ok) {
          aviso(j.error || j.message || `Erro ${r.status}`, "erro");
          return;
        }
        const s = j.resumo || j.data?.resumo || {};
        const partes = [
          `${s.lidas ?? 0} venda(s) lida(s)`,
          `${s.novas ?? 0} nova(s)`,
          `${s.atualizadas ?? 0} atualizada(s)`,
        ];
        // Pedido sem custo é o caso que ela precisa ver ANTES de pagar —
        // aparece com destaque em vez de sumir no meio do resumo.
        const semCusto = (s.semCusto || []).length;
        if (semCusto) {
          partes.push(`⚠️ ${semCusto} sem custo na ficha — confira antes de pagar`);
        }
        if (s.erros) partes.push(`${s.erros} com erro`);
        aviso(partes.join(" · ") + ". Recarregando…", semCusto || s.erros ? "erro" : "ok");
        setTimeout(() => location.reload(), semCusto || s.erros ? 2600 : 900);
      } catch (e) {
        aviso("Falha de rede: " + e.message, "erro");
      } finally {
        btn.disabled = false;
        btn.style.opacity = "";
        btn.style.cursor = "pointer";
        btn.textContent = original;
      }
    });
  }

  document.addEventListener("click", (ev) => {
    const cartao = ev.target.closest("[data-pedido]");
    if (!cartao) return;
    if (ev.target.matches("[data-comprado]"))  marcar(cartao, "comprado");
    if (ev.target.matches("[data-naoaplica]")) marcar(cartao, "nao_aplicavel");
    if (ev.target.matches("[data-desfazer]"))  marcar(cartao, "a_comprar");
    if (ev.target.matches("[data-copiar]")) {
      const texto = cartao.querySelector("[data-bloco]").textContent;
      navigator.clipboard.writeText(texto)
        .then(() => aviso("Dados copiados. Cole em Pedidos → Cadastrar Pedido na TrazPraCa.", "ok"))
        .catch(() => aviso("O navegador bloqueou a cópia — selecione o texto e copie na mão.", "erro"));
    }
  });
</script>
