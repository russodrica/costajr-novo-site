---
import Admin from "../../layouts/Admin.astro";
import { verifyToken, type AdminClaims } from "../../lib/auth";
import { temPerfilFresco } from "../../lib/permissoes";
import { supabaseAdmin } from "../../lib/supabase";
import { BANCOS } from "../../lib/bancos";
import { acessoFornecedor, resumoAcesso } from "../../lib/fornecedorAcesso";

const token = Astro.cookies.get("admin_token")?.value;
if (!token) return Astro.redirect("/admin/login");
let claims: AdminClaims;
try { claims = await verifyToken<AdminClaims>(token); if (claims.tipo !== "admin") throw new Error(); }
catch { Astro.cookies.delete("admin_token", { path: "/" }); return Astro.redirect("/admin/login"); }
if (!(await temPerfilFresco(claims, ["admin"]))) return Astro.redirect("/admin");

const db = supabaseAdmin();
const { data: fornecedores } = await db.from("portal_profiles")
  .select("id, display_name, empresa, email, approval_status, last_login_at, created_at")
  .eq("role", "fornecedor")
  .order("created_at", { ascending: false });
const lista: any[] = fornecedores || [];
// Resumo do que CADA um enxerga hoje — some direto na linha da tabela, para não
// depender de alguém abrir um modal para descobrir que um acesso ficou amplo.
const db2 = supabaseAdmin();
const acessos: Record<string, string> = {};
for (const f of lista) acessos[String(f.id)] = resumoAcesso(await acessoFornecedor(db2, String(f.id)));
const bancosJson = JSON.stringify(BANCOS).replace(/</g, "\\u003c");
const fdt = (s: any) => (s ? new Date(s).toLocaleString("pt-BR", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" }) : "—");
---
<Admin title="Fornecedores (acesso externo)" current="fornecedores">
  <div class="toolbar">
    <span class="toolbar-title">🚚 Fornecedores — acesso externo</span>
    <span style="flex:1"></span>
    <button class="btn btn-primary" onclick="abrirNovoForn()">+ Novo fornecedor</button>
  </div>

  <div class="card" style="padding:12px 16px;margin-bottom:14px;background:#FFFBEB;border:1px solid #FCD34D">
    <strong>Como funciona o acesso externo:</strong> no máximo <b>Documentos da Empresa</b> (certidões, cadastrais, contábeis…) e <b>Extratos Bancários</b>, sempre em modo <b>visualizar e baixar</b> — nunca inserir, editar ou excluir. Dentro desse teto, <b>você escolhe na criação</b> quais módulos e quais bancos cada pessoa vê; o que não for marcado fica bloqueado, inclusive por link direto. Contratos, seguros, faturas de cartão, empréstimos, RH, financeiro e todo o resto do painel ficam sempre fora. Cada download é registrado na auditoria.
  </div>

  <div class="card" style="padding:0;overflow:hidden">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Nome</th><th>Empresa</th><th>E-mail (login)</th><th>Acesso liberado</th><th>Status</th><th>Último acesso</th><th></th></tr></thead>
        <tbody>
          {lista.length === 0 && (
            <tr><td colspan="7" style="text-align:center;color:#9CA3AF;padding:28px">Nenhum fornecedor cadastrado ainda. Use <strong>+ Novo fornecedor</strong>.</td></tr>
          )}
          {lista.map((f: any) => (
            <tr>
              <td><strong>{f.display_name}</strong></td>
              <td>{f.empresa || "—"}</td>
              <td style="font-size:13px">{f.email}</td>
              <td style="font-size:12.5px;max-width:230px">
                {acessos[String(f.id)] === "nenhum acesso liberado"
                  ? <span class="badge badge-red">⛔ nada liberado</span>
                  : <span style="color:#374151">{acessos[String(f.id)]}</span>}
              </td>
              <td>{f.approval_status === "approved"
                ? <span class="badge badge-green">✓ Ativo</span>
                : <span class="badge badge-red">⛔ Bloqueado</span>}</td>
              <td style="font-size:12.5px;color:#6B7280">{fdt(f.last_login_at)}</td>
              <td style="white-space:nowrap;text-align:right">
                {f.approval_status === "approved"
                  ? <button class="btn btn-outline btn-sm" onclick={`acaoForn('${f.id}','bloquear', this)`}>Bloquear</button>
                  : <button class="btn btn-success btn-sm" onclick={`acaoForn('${f.id}','aprovar', this)`}>Aprovar</button>}
                <button class="btn btn-outline btn-sm" onclick={`verAtividade('${f.id}', ${JSON.stringify(f.display_name || "")})`}>📋 Atividade</button>
                <button class="btn btn-outline btn-sm" onclick={`abrirAcesso('${f.id}', ${JSON.stringify(f.display_name || "")})`} title="Mudar os módulos e bancos que esta pessoa enxerga">🔑 Acesso</button>
                <button class="btn btn-outline btn-sm" onclick={`verBloqueados('${f.id}', ${JSON.stringify(f.display_name || "")})`} title="Conferir, documento a documento, o que esta pessoa vê e o que não vê">🔍 Conferir</button>
                <button class="btn btn-secondary btn-sm" onclick={`acaoForn('${f.id}','reset_senha', this)`}>Nova senha</button>
                <button class="btn btn-danger btn-sm" onclick={`excluirForn('${f.id}', ${JSON.stringify(f.display_name || "")}, this)`}>Excluir</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div id="fornMsg" style="margin-top:12px"></div>

  <!-- Modal: novo fornecedor -->
  <div class="modal-overlay" id="modalForn">
    <div class="modal-box" style="max-width:480px">
      <div class="modal-header"><h2>+ Novo fornecedor</h2><button class="modal-close" onclick="fecharForn()">✕</button></div>
      <form id="formForn" style="padding:16px 24px">
        <div class="form-group"><label>Nome da pessoa *</label><input name="nome" required placeholder="Ex: João da Silva" /></div>
        <div class="form-group"><label>Empresa fornecedora</label><input name="empresa" placeholder="Ex: Fornecedora XYZ Ltda" /></div>
        <div class="form-group"><label>E-mail (será o login) *</label><input name="email" type="email" required placeholder="pessoa@fornecedora.com.br" /></div>
        <div style="border:1.5px solid #BFDBFE;background:#EFF6FF;border-radius:10px;padding:12px 14px;margin:14px 0 10px">
          <div style="font-weight:800;color:#1E3A8A;margin-bottom:4px">🔑 O que esta pessoa vai enxergar</div>
          <p style="font-size:12px;color:#1E40AF;margin:0 0 10px">Marque agora. O que ficar desmarcado não abre nem por link direto — e pode ser mudado depois no botão <b>Acesso</b>.</p>

          <label style="display:flex;gap:9px;align-items:flex-start;margin-bottom:8px;cursor:pointer">
            <input type="checkbox" name="docEmpresa" id="chkDocEmpresa" style="width:auto;margin-top:3px" />
            <span><b>Documentos da Empresa</b><br/><span style="font-size:12px;color:#475569">Certidões, cadastrais, contábeis e fiscais. Contratos, clientes, consórcios e seguros ficam fora sempre.</span></span>
          </label>

          <label style="display:flex;gap:9px;align-items:flex-start;cursor:pointer">
            <input type="checkbox" name="docBancarios" id="chkDocBanc" style="width:auto;margin-top:3px" onchange="toggleBancos()" />
            <span><b>Documentos Bancários</b><br/><span style="font-size:12px;color:#475569">Só extratos — faturas de cartão e empréstimos nunca aparecem para quem é de fora.</span></span>
          </label>

          <div id="boxBancos" style="display:none;margin:10px 0 0;padding:10px 12px;background:#fff;border:1px solid #DBEAFE;border-radius:8px">
            <div style="font-size:12.5px;font-weight:700;color:#1E3A8A;margin-bottom:6px">Quais bancos?</div>
            <label style="display:flex;gap:8px;align-items:center;margin-bottom:5px;cursor:pointer">
              <input type="radio" name="bancosModo" value="todos" checked style="width:auto" onchange="toggleBancos()" />
              <span style="font-size:13px">Todos os bancos <span style="color:#9CA3AF">(inclusive os cadastrados no futuro)</span></span>
            </label>
            <label style="display:flex;gap:8px;align-items:center;cursor:pointer">
              <input type="radio" name="bancosModo" value="lista" style="width:auto" onchange="toggleBancos()" />
              <span style="font-size:13px">Somente os bancos que eu marcar</span>
            </label>
            <div id="listaBancos" style="display:none;margin-top:8px;padding-top:8px;border-top:1px dashed #DBEAFE"></div>
          </div>
        </div>

        <p style="font-size:12.5px;color:#6B7280;margin:4px 0 10px">Uma <b>senha provisória</b> é gerada e <b>enviada por e-mail</b> ao fornecedor, com o link da intranet e as instruções. No primeiro acesso ele cria a própria senha.</p>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="fecharForn()">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="btnCriarForn">Criar acesso</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: editar liberações de um fornecedor já criado -->
  <div class="modal-overlay" id="modalAcesso">
    <div class="modal-box" style="max-width:520px">
      <div class="modal-header"><h2 id="acTitulo">🔑 Acesso</h2><button class="modal-close" onclick="fecharAcesso()">✕</button></div>
      <div style="padding:16px 24px;max-height:78vh;overflow:auto" id="acBody"><p style="color:#9CA3AF">Carregando…</p></div>
    </div>
  </div>

  <!-- Modal: atividade (acessos + downloads) -->
  <div class="modal-overlay" id="modalBloq">
    <div class="modal-box" style="max-width:640px">
      <div class="modal-header"><h2 id="bloqTitulo">🔒 O que está bloqueado</h2><button class="modal-close" onclick="fecharBloq()">✕</button></div>
      <div style="padding:16px 24px;max-height:78vh;overflow:auto" id="bloqBody">
        <p style="color:#9CA3AF">Carregando…</p>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="modalAtiv">
    <div class="modal-box" style="max-width:640px">
      <div class="modal-header"><h2 id="ativTitulo">📋 Atividade</h2><button class="modal-close" onclick="fecharAtiv()">✕</button></div>
      <div style="padding:16px 24px;max-height:78vh;overflow:auto" id="ativBody">
        <p style="color:#9CA3AF">Carregando…</p>
      </div>
    </div>
  </div>

  <script type="application/json" id="bancos-cat" set:html={bancosJson}></script>

  <script>
    const overlayF = (id: string) => document.getElementById(id)!;
    const BANCOS_CAT: string[] = JSON.parse(document.getElementById("bancos-cat")!.textContent || "[]");
    const escB = (t: any) => String(t == null ? "" : t).replace(/</g, "&lt;");

    /** Caixinhas de banco (usadas na criação e na edição). */
    function caixasBancos(alvo: HTMLElement, marcados: string[], prefixo: string) {
      alvo.innerHTML = BANCOS_CAT.map((b, i) => `
        <label style="display:flex;gap:7px;align-items:center;padding:3px 0;cursor:pointer">
          <input type="checkbox" data-${prefixo}-banco="${escB(b)}" ${marcados.includes(b) ? "checked" : ""} style="width:auto" />
          <span style="font-size:13px">🏦 ${escB(b)}</span>
        </label>`).join("");
    }
    function bancosMarcados(prefixo: string, raiz: HTMLElement | Document = document): string[] {
      return Array.from(raiz.querySelectorAll(`[data-${prefixo}-banco]`))
        .filter((el) => (el as HTMLInputElement).checked)
        .map((el) => (el as HTMLElement).getAttribute(`data-${prefixo}-banco`) || "");
    }
    /** Mostra/esconde o bloco de bancos conforme os cliques do formulário de criação. */
    function toggleBancos() {
      const lig = (document.getElementById("chkDocBanc") as HTMLInputElement).checked;
      const box = document.getElementById("boxBancos") as HTMLElement;
      box.style.display = lig ? "block" : "none";
      const modo = (document.querySelector('#formForn input[name="bancosModo"]:checked') as HTMLInputElement)?.value || "todos";
      const lista = document.getElementById("listaBancos") as HTMLElement;
      const mostrarLista = lig && modo === "lista";
      lista.style.display = mostrarLista ? "block" : "none";
      if (mostrarLista && !lista.innerHTML.trim()) caixasBancos(lista, [], "novo");
    }
    function abrirNovoForn() {
      (document.getElementById("formForn") as HTMLFormElement).reset();
      (document.getElementById("listaBancos") as HTMLElement).innerHTML = "";
      toggleBancos();
      overlayF("modalForn").classList.add("open");
    }
    function fecharForn() { overlayF("modalForn").classList.remove("open"); }
    function msgBox() { return document.getElementById("fornMsg") as HTMLElement; }
    function mostrarResultado(titulo: string, email: string, senha: string, emailEnviado: boolean, emailErro?: string) {
      const emailEsc = email.replace(/</g, "&lt;");
      if (emailEnviado) {
        msgBox().innerHTML = `<div class="card" style="border:1.5px solid #6EE7B7;background:#ECFDF5;padding:14px 18px">
          <div style="font-weight:800;color:#065F46;margin-bottom:6px">${titulo}</div>
          <div style="font-size:13.5px;color:#065F46">📧 Senha provisória <b>enviada por e-mail</b> para <b>${emailEsc}</b>, com o link da intranet e as instruções de acesso.</div>
          <p style="font-size:12px;color:#047857;margin:8px 0 0">Caso o e-mail não chegue (verifique o spam), a senha provisória é <code style="background:#fff;padding:1px 6px;border-radius:5px;border:1px solid #6EE7B7">${senha}</code> — o fornecedor troca no primeiro acesso.</p>
        </div>`;
      } else {
        msgBox().innerHTML = `<div class="card" style="border:1.5px solid #FCA5A5;background:#FEF2F2;padding:14px 18px">
          <div style="font-weight:800;color:#7F1D1D;margin-bottom:6px">${titulo} — mas o e-mail NÃO foi enviado</div>
          <div style="font-size:12.5px;color:#991B1B;margin-bottom:8px">${(emailErro || "Falha no envio").replace(/</g, "&lt;")}. Repasse manualmente por canal seguro:</div>
          <div style="font-size:13.5px">Login: <b>${emailEsc}</b></div>
          <div style="font-size:13.5px">Senha provisória: <code style="font-size:15px;font-weight:800;background:#fff;padding:2px 8px;border-radius:6px;border:1px solid #FCA5A5">${senha}</code></div>
          <p style="font-size:12px;color:#991B1B;margin:8px 0 0">Acesso: <b>https://www.costajr.com.br/intranet</b> → Portal do Fornecedor. Troca de senha no primeiro acesso.</p>
        </div>`;
      }
    }
    document.getElementById("formForn")!.addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = e.target as HTMLFormElement;
      const btn = document.getElementById("btnCriarForn") as HTMLButtonElement;
      btn.disabled = true; btn.textContent = "Criando…";
      try {
        const dados = Object.fromEntries(new FormData(f).entries());
        const docEmpresa = (document.getElementById("chkDocEmpresa") as HTMLInputElement).checked;
        const docBancarios = (document.getElementById("chkDocBanc") as HTMLInputElement).checked;
        const bancosModo = (document.querySelector('#formForn input[name="bancosModo"]:checked') as HTMLInputElement)?.value || "todos";
        const bancos = bancosMarcados("novo");
        if (!docEmpresa && !docBancarios) { alert("Marque ao menos um módulo que esta pessoa poderá acessar."); btn.disabled = false; btn.textContent = "Criar acesso"; return; }
        if (docBancarios && bancosModo === "lista" && !bancos.length) { alert("Você escolheu bancos específicos, mas não marcou nenhum."); btn.disabled = false; btn.textContent = "Criar acesso"; return; }
        const body = { ...dados, docEmpresa, docBancarios, bancosModo, bancos };
        const res = await fetch("/api/admin/fornecedores", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
        const d = await res.json();
        if (res.ok) {
          fecharForn();
          mostrarResultado(`✓ Acesso criado para ${String(body.nome)} — ${String(d.acesso || "")}`, String(body.email), d.senha, d.emailEnviado, d.emailErro);
          setTimeout(() => location.reload(), 60000); // recarrega depois (dá tempo de ler a mensagem)
        } else { alert(d.error || "Erro ao criar."); }
      } catch { alert("Falha de rede."); }
      btn.disabled = false; btn.textContent = "Criar acesso";
    });
    async function acaoForn(id: string, acao: string, btn: HTMLButtonElement) {
      const rotulos: Record<string, string> = { aprovar: "Aprovar o acesso deste fornecedor?", bloquear: "Bloquear o acesso deste fornecedor? As sessões ativas caem na hora.", reset_senha: "Gerar uma NOVA senha provisória e ENVIAR por e-mail ao fornecedor? A antiga deixa de funcionar." };
      if (!confirm(rotulos[acao] || "Confirmar?")) return;
      btn.disabled = true;
      const res = await fetch(`/api/admin/fornecedores/${id}`, { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ acao }) });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) { alert(d.error || "Erro"); btn.disabled = false; return; }
      if (acao === "reset_senha" && d.senha) {
        const linha = btn.closest("tr");
        const email = linha ? (linha.children[2] as HTMLElement).textContent || "" : "";
        mostrarResultado("🔑 Nova senha provisória gerada", email.trim(), d.senha, d.emailEnviado, d.emailErro);
        btn.disabled = false;
      } else { location.reload(); }
    }
    async function excluirForn(id: string, nome: string, btn: HTMLButtonElement) {
      if (!confirm(`Excluir o fornecedor "${nome}"? O acesso morre na hora (recuperável na Lixeira por 30 dias).`)) return;
      btn.disabled = true;
      const res = await fetch(`/api/admin/fornecedores/${id}`, { method: "DELETE", headers: { "content-type": "application/json" } });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) { alert(d.error || "Erro"); btn.disabled = false; return; }
      if (d.aviso) alert(d.aviso);
      location.reload();
    }
    // ── Atividade do fornecedor: acessos (logins) + downloads ──
    const fdt2 = (s: string) => (s ? new Date(s).toLocaleString("pt-BR", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" }) : "—");
    function fecharAtiv() { overlayF("modalAtiv").classList.remove("open"); }
    async function verAtividade(id: string, nome: string) {
      (document.getElementById("ativTitulo") as HTMLElement).textContent = `📋 Atividade — ${nome}`;
      const body = document.getElementById("ativBody") as HTMLElement;
      body.innerHTML = `<p style="color:#9CA3AF">Carregando…</p>`;
      overlayF("modalAtiv").classList.add("open");
      try {
        const res = await fetch(`/api/admin/fornecedores/${id}/atividade`);
        const d = await res.json();
        if (!res.ok) { body.innerHTML = `<div class="alert alert-error">${(d.error || "Erro").replace(/</g, "&lt;")}</div>`; return; }
        const esc = (s: any) => String(s == null ? "" : s).replace(/</g, "&lt;");
        const acessosHtml = (d.acessos || []).length
          ? `<div style="border:1px solid var(--border);border-radius:8px;overflow:auto;max-height:26vh"><table style="width:100%"><thead><tr><th style="text-align:left;padding:6px 10px">Quando</th><th style="text-align:left;padding:6px 10px">IP</th></tr></thead><tbody>${(d.acessos).map((a: any) => `<tr><td style="padding:5px 10px;font-size:13px">${fdt2(a.ts)}</td><td style="padding:5px 10px;font-size:12.5px;color:#6B7280">${esc(a.ip) || "—"}</td></tr>`).join("")}</tbody></table></div>`
          : `<p style="color:#9CA3AF;font-size:13px;margin:4px 0">Nenhum acesso registrado ainda.</p>`;
        const downloadsHtml = (d.downloads || []).length
          ? `<div style="border:1px solid var(--border);border-radius:8px;overflow:auto;max-height:34vh"><table style="width:100%"><thead><tr><th style="text-align:left;padding:6px 10px">Quando</th><th style="text-align:left;padding:6px 10px">Documento baixado</th></tr></thead><tbody>${(d.downloads).map((x: any) => { const doc = String(x.descricao || "").replace(/^Fornecedor[^"]*baixou\s*"?/, "").replace(/"$/, ""); return `<tr><td style="padding:5px 10px;font-size:12.5px;white-space:nowrap;color:#6B7280">${fdt2(x.ts)}</td><td style="padding:5px 10px;font-size:13px">📄 ${esc(doc)}</td></tr>`; }).join("")}</tbody></table></div>`
          : `<p style="color:#9CA3AF;font-size:13px;margin:4px 0">Nenhum download registrado ainda.</p>`;
        body.innerHTML = `
          <div style="display:flex;gap:10px;margin-bottom:12px">
            <div class="card" style="flex:1;padding:10px 14px;text-align:center"><div style="font-size:1.6rem;font-weight:800;color:var(--brand)">${d.totalAcessos || 0}</div><div style="font-size:12px;color:#6B7280">acessos</div></div>
            <div class="card" style="flex:1;padding:10px 14px;text-align:center"><div style="font-size:1.6rem;font-weight:800;color:var(--brand)">${d.totalDownloads || 0}</div><div style="font-size:12px;color:#6B7280">downloads</div></div>
          </div>
          <div style="font-weight:700;margin:6px 0 6px">🔑 Acessos (logins)</div>${acessosHtml}
          <div style="font-weight:700;margin:14px 0 6px">⬇️ Documentos baixados</div>${downloadsHtml}`;
      } catch { body.innerHTML = `<div class="alert alert-error">Falha de rede.</div>`; }
    }
    // 🔑 Editar as liberações de quem já existe.
    function fecharAcesso() { overlayF("modalAcesso").classList.remove("open"); }
    async function abrirAcesso(id: string, nome: string) {
      (document.getElementById("acTitulo") as HTMLElement).textContent = `🔑 Acesso — ${nome}`;
      const body = document.getElementById("acBody") as HTMLElement;
      body.innerHTML = `<p style="color:#9CA3AF">Carregando…</p>`;
      overlayF("modalAcesso").classList.add("open");
      try {
        const r = await fetch(`/api/admin/fornecedores/${id}/acesso`);
        const d = await r.json();
        if (!r.ok) throw new Error(d.error || "Não deu para carregar");
        const a = d.acesso || {};
        body.innerHTML = `
          <p style="font-size:12.5px;color:#6B7280;margin:0 0 12px">O que ficar desmarcado deixa de abrir na hora — inclusive por link direto. A mudança fica registrada na auditoria.</p>
          <label style="display:flex;gap:9px;align-items:flex-start;margin-bottom:9px;cursor:pointer">
            <input type="checkbox" id="acEmp" ${a.docEmpresa ? "checked" : ""} style="width:auto;margin-top:3px" />
            <span><b>Documentos da Empresa</b><br/><span style="font-size:12px;color:#475569">Certidões, cadastrais, contábeis e fiscais.</span></span>
          </label>
          <label style="display:flex;gap:9px;align-items:flex-start;cursor:pointer">
            <input type="checkbox" id="acBanc" ${a.docBancarios ? "checked" : ""} style="width:auto;margin-top:3px" />
            <span><b>Documentos Bancários</b><br/><span style="font-size:12px;color:#475569">Somente extratos.</span></span>
          </label>
          <div id="acBox" style="margin:10px 0 0;padding:10px 12px;background:#F8FAFC;border:1px solid var(--border);border-radius:8px">
            <div style="font-size:12.5px;font-weight:700;margin-bottom:6px">Quais bancos?</div>
            <label style="display:flex;gap:8px;align-items:center;margin-bottom:5px;cursor:pointer"><input type="radio" name="acModo" value="todos" ${a.bancosModo !== "lista" ? "checked" : ""} style="width:auto" /><span style="font-size:13px">Todos os bancos</span></label>
            <label style="display:flex;gap:8px;align-items:center;cursor:pointer"><input type="radio" name="acModo" value="lista" ${a.bancosModo === "lista" ? "checked" : ""} style="width:auto" /><span style="font-size:13px">Somente os que eu marcar</span></label>
            <div id="acLista" style="margin-top:8px;padding-top:8px;border-top:1px dashed var(--border)"></div>
          </div>
          <div id="acMsg" style="margin-top:10px"></div>
          <div class="modal-footer" style="padding-left:0;padding-right:0">
            <button type="button" class="btn btn-secondary" onclick="fecharAcesso()">Cancelar</button>
            <button type="button" class="btn btn-primary" id="acSalvar" onclick="salvarAcesso('${id}')">Salvar acesso</button>
          </div>`;
        caixasBancos(document.getElementById("acLista") as HTMLElement, a.bancos || [], "ed");
        const sincroniza = () => {
          const lig = (document.getElementById("acBanc") as HTMLInputElement).checked;
          (document.getElementById("acBox") as HTMLElement).style.display = lig ? "block" : "none";
          const modo = (document.querySelector('input[name="acModo"]:checked') as HTMLInputElement)?.value || "todos";
          (document.getElementById("acLista") as HTMLElement).style.display = lig && modo === "lista" ? "block" : "none";
        };
        (document.getElementById("acBanc") as HTMLElement).addEventListener("change", sincroniza);
        Array.from(document.querySelectorAll('input[name="acModo"]')).forEach((el) => el.addEventListener("change", sincroniza));
        sincroniza();
      } catch (e: any) {
        body.innerHTML = `<div class="alert alert-error">${escB(e?.message || "Erro")}</div>`;
      }
    }
    async function salvarAcesso(id: string) {
      const btn = document.getElementById("acSalvar") as HTMLButtonElement;
      const msg = document.getElementById("acMsg") as HTMLElement;
      const docEmpresa = (document.getElementById("acEmp") as HTMLInputElement).checked;
      const docBancarios = (document.getElementById("acBanc") as HTMLInputElement).checked;
      const bancosModo = (document.querySelector('input[name="acModo"]:checked') as HTMLInputElement)?.value || "todos";
      const bancos = bancosMarcados("ed");
      if (docBancarios && bancosModo === "lista" && !bancos.length) {
        msg.innerHTML = `<div class="alert alert-error">Você escolheu bancos específicos, mas não marcou nenhum.</div>`; return;
      }
      if (!docEmpresa && !docBancarios && !confirm("Sem nenhum módulo marcado esta pessoa entra no portal e não vê documento algum. Confirmar?")) return;
      btn.disabled = true; btn.textContent = "Salvando…";
      try {
        const r = await fetch(`/api/admin/fornecedores/${id}/acesso`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ docEmpresa, docBancarios, bancosModo, bancos }) });
        const d = await r.json();
        if (!r.ok) throw new Error(d.error || "Erro ao salvar");
        msg.innerHTML = `<div style="background:#ECFDF5;border:1px solid #6EE7B7;border-radius:8px;padding:8px 11px;color:#065F46;font-size:12.5px">✓ Salvo: ${escB(d.resumo)}</div>`;
        setTimeout(() => location.reload(), 900);
      } catch (e: any) {
        msg.innerHTML = `<div class="alert alert-error">${escB(e?.message || "Erro")}</div>`;
        btn.disabled = false; btn.textContent = "Salvar acesso";
      }
    }

    // 🔒 Conferência: o que ESTA pessoa de fora não enxerga (e o que ainda vê).
    // Usa a mesma regra da tela e do download (src/lib/sigilo.ts) — se aparece aqui
    // como bloqueado, está bloqueado de verdade, inclusive por link direto.
    function fecharBloq() { overlayF("modalBloq").classList.remove("open"); }
    async function verBloqueados(id: string, nome: string) {
      (document.getElementById("bloqTitulo") as HTMLElement).textContent = `🔍 Conferência de acesso — ${nome}`;
      (document.getElementById("bloqBody") as HTMLElement).innerHTML = `<p style="color:#9CA3AF">Conferindo documento a documento…</p>`;
      overlayF("modalBloq").classList.add("open");
      try {
        const r = await fetch(`/api/admin/fornecedores/${id}/bloqueados`);
        const d = await r.json();
        if (!r.ok) throw new Error(d.error || "Não deu para carregar");
        const c = d.contagem || {};
        const MOTIVOS: Record<string, string> = {
          modulo: "módulo não liberado", escopo: "banco fora da lista dele",
          banco: "banco escondido de todo mundo de fora", documento: "documento escondido",
          categoria: "categoria vedada a quem é de fora",
        };
        const listaDocs = (arr: any[], vazio: string, comMotivo: boolean) => arr.length
          ? `<ul style="margin:6px 0 0;padding-left:20px;font-size:13px;color:#374151;max-height:22vh;overflow:auto">${arr.map((x: any) => `<li style="margin:2px 0">${escB(x.label)}${comMotivo && x.motivo ? ` <span style="color:#9CA3AF;font-size:11.5px">(${MOTIVOS[x.motivo] || x.motivo})</span>` : ""}</li>`).join("")}</ul>`
          : `<p style="margin:6px 0 0;color:#9CA3AF;font-size:13px">${vazio}</p>`;

        let html = `<div style="background:#F0F9FF;border:1px solid #BAE6FD;border-radius:8px;padding:11px 13px;margin-bottom:12px">
            <div style="font-size:13px;color:#075985"><b>Liberação configurada:</b> ${escB(d.resumo)}</div>
            <div style="font-size:13px;color:#075985;margin-top:5px">Hoje ela enxerga <b>${c.extratosVisiveis ?? 0}</b> de <b>${c.extratosTotal ?? 0}</b> extratos e <b>${c.arquivosVisiveis ?? 0}</b> de <b>${c.arquivosTotal ?? 0}</b> arquivos da empresa.</div>
          </div>`;
        for (const al of (d.alertas || [])) {
          html += `<div style="background:#FFFBEB;border:1px solid #FCD34D;border-radius:8px;padding:9px 12px;margin-bottom:10px;font-size:12.5px;color:#78350F">⚠️ ${escB(al)}</div>`;
        }
        if ((d.bancosQueEleVe || []).length) {
          html += `<div style="margin-bottom:12px"><b style="font-size:13.5px">🏦 Bancos que ela realmente vê</b>
            <p style="margin:4px 0 0;font-size:13px;color:#374151">${(d.bancosQueEleVe || []).map(escB).join(", ")}</p></div>`;
        }
        html += `<div style="margin-bottom:12px"><b style="font-size:13.5px;color:#065F46">✅ Documentos que ela VÊ (${(d.ve?.extratos || []).length + (d.ve?.arquivos || []).length})</b>
          <div style="margin-top:4px;font-size:12.5px;color:#6B7280">Extratos</div>${listaDocs(d.ve?.extratos || [], "Nenhum extrato visível.", false)}
          <div style="margin-top:8px;font-size:12.5px;color:#6B7280">Arquivos da empresa</div>${listaDocs(d.ve?.arquivos || [], "Nenhum arquivo visível.", false)}</div>`;
        html += `<div style="margin-bottom:6px"><b style="font-size:13.5px;color:#7F1D1D">🚫 Documentos que ela NÃO vê (${(d.naoVe?.extratos || []).length + (d.naoVe?.arquivos || []).length})</b>
          <div style="margin-top:4px;font-size:12.5px;color:#6B7280">Extratos</div>${listaDocs(d.naoVe?.extratos || [], "Nenhum — ela vê todos os extratos.", true)}
          <div style="margin-top:8px;font-size:12.5px;color:#6B7280">Arquivos da empresa</div>${listaDocs(d.naoVe?.arquivos || [], "Nenhum — ela vê todos os arquivos.", true)}</div>`;
        html += `<p style="margin:14px 0 0;font-size:12px;color:#9CA3AF">Esta lista é gerada rodando, em cada documento, a mesma regra que a tela dela e o download usam. O que está como "não vê" também não abre por link direto. Para mudar módulos ou bancos, use <b>🔑 Acesso</b>; para esconder um documento específico, use o botão de acesso externo ao lado dele em Documentos Bancários / Documentos da Empresa.</p>`;
        (document.getElementById("bloqBody") as HTMLElement).innerHTML = html;
      } catch (e: any) {
        (document.getElementById("bloqBody") as HTMLElement).innerHTML = `<div class="alert alert-error">${escB(e?.message || "Erro")}</div>`;
      }
    }
    Object.assign(window, { abrirNovoForn, fecharForn, acaoForn, excluirForn, verAtividade, fecharAtiv, verBloqueados, fecharBloq, toggleBancos, abrirAcesso, fecharAcesso, salvarAcesso });
  </script>
</Admin>
