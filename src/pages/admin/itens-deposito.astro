---
import Admin from "../../layouts/Admin.astro";
import { verifyToken, type AdminClaims } from "../../lib/auth";
import { temPerfilFresco } from "../../lib/permissoes";

const token = Astro.cookies.get("admin_token")?.value;
if (!token) return Astro.redirect("/admin/login");
let claims: AdminClaims;
try { claims = await verifyToken<AdminClaims>(token); if (claims.tipo !== "admin") throw new Error(); }
catch { Astro.cookies.delete("admin_token", { path: "/" }); return Astro.redirect("/admin/login"); }
if (!(await temPerfilFresco(claims, ["admin"]))) return Astro.redirect("/admin");
---
<Admin title="Itens de Depósito" current="itens-deposito">
  <div class="toolbar">
    <span class="toolbar-title">📦 Itens de Depósito — links para credores</span>
  </div>

  <div id="resumo" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;margin-bottom:14px">
    <div class="card" style="padding:14px 16px;border-top:4px solid #C41E3A">
      <div style="font-size:12px;color:#6B7280;text-transform:uppercase;letter-spacing:.06em">Valor total em estoque</div>
      <div id="totalEstoque" style="font-size:28px;font-weight:800;font-variant-numeric:tabular-nums">R$ 0,00</div>
      <div style="font-size:12px;color:#6B7280">montante que pode ser negociado (itens ativos × quantidade)</div>
    </div>
    <div class="card" style="padding:14px 16px">
      <div style="font-size:12px;color:#6B7280;text-transform:uppercase;letter-spacing:.06em">Itens ativos</div>
      <div id="qtdAtivos" style="font-size:28px;font-weight:800">0</div>
      <div id="semValor" style="font-size:12px;color:#6B7280"></div>
    </div>
    <div class="card" style="padding:14px 16px">
      <div style="font-size:12px;color:#6B7280;text-transform:uppercase;letter-spacing:.06em">Já baixado</div>
      <div id="totalBaixado" style="font-size:28px;font-weight:800;font-variant-numeric:tabular-nums">R$ 0,00</div>
      <div id="qtdBaixados" style="font-size:12px;color:#6B7280"></div>
    </div>
  </div>

  <div class="card" style="padding:12px 16px;margin-bottom:14px;background:#FFFBEB;border:1px solid #FCD34D">
    <strong>Como funciona:</strong> cada link é <b>pessoal</b> (leva o nome do credor como marca d'água), vale <b>no máximo 24 horas</b> e só existe porque você o gerou aqui. Para o credor ver de novo, gere outro. O credor precisa <b>aceitar um aviso de confidencialidade</b> antes de ver a lista, e cada abertura fica registrada (data, hora, IP). Você pode <b>revogar</b> um link a qualquer momento.
  </div>

  <div class="card" style="padding:16px;margin-bottom:16px">
    <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end">
      <label style="flex:2 1 240px;font-size:13px">Nome do credor
        <input id="credor" class="input" style="width:100%" placeholder="Ex.: Leroy Merlin Ltda" maxlength="80" />
      </label>
      <label style="flex:0 0 140px;font-size:13px">Validade
        <select id="horas" class="input" style="width:100%">
          <option value="24" selected>24 horas</option>
          <option value="12">12 horas</option>
          <option value="6">6 horas</option>
          <option value="1">1 hora</option>
        </select>
      </label>
      <label style="flex:0 0 auto;font-size:13px;display:flex;align-items:center;gap:6px;padding-bottom:9px">
        <input type="checkbox" id="mostrarValor" checked /> Mostrar valores
      </label>
      <button class="btn btn-primary" id="btnGerar" onclick="gerar()">Gerar link</button>
    </div>
    <div id="novoLink" hidden style="margin-top:14px;padding:12px;background:#ECFDF5;border:1px solid #6EE7B7;border-radius:8px">
      <div style="font-size:13px;margin-bottom:6px"><b id="novoQuem"></b> — copie e envie. Ele não será mostrado de novo, mas você pode reemiti-lo na lista abaixo enquanto estiver válido.</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <input id="novoUrl" class="input" readonly style="flex:1 1 320px;min-width:0" onclick="this.select()" />
        <button class="btn" onclick="copiar('novoUrl')">Copiar</button>
      </div>
    </div>
  </div>

  <h3 style="margin:18px 0 8px">Links gerados</h3>
  <div class="card" style="overflow-x:auto">
    <table>
      <thead><tr><th>Credor</th><th>Gerado</th><th>Expira</th><th>Situação</th><th>Aceite</th><th>Aberturas</th><th>Último acesso</th><th></th></tr></thead>
      <tbody id="links"><tr><td colspan="8" style="padding:18px;color:#6B7280">Carregando…</td></tr></tbody>
    </table>
  </div>

  <input type="file" id="arqFoto" accept="image/*" hidden />
  <h3 style="margin:22px 0 8px">Itens do catálogo</h3>
  <div style="display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap">
    <button class="btn btn-primary" id="abaAtivos" onclick="mudarAba('ativos')">Ativos</button>
    <button class="btn" id="abaBaixados" onclick="mudarAba('baixados')">Baixados</button>
    <span id="resumoItens" style="align-self:center;font-size:13px;color:#6B7280"></span>
  </div>
  <div class="card" style="overflow-x:auto">
    <table>
      <thead><tr><th></th><th>#</th><th>Item</th><th>Qtd</th><th>Condição</th><th>Valor (R$)</th><th>Total (R$)</th><th>Ação</th></tr></thead>
      <tbody id="itens"></tbody>
    </table>
  </div>

  <script is:inline>
    var DADOS = { itens: [], links: [] };
    function esc(s){return String(s==null?"":s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
    function dt(s){return s?new Date(s).toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}):"—"}
    function post(corpo){return fetch("/api/admin/itens-deposito",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(corpo)}).then(function(r){return r.json().then(function(j){if(!r.ok)throw new Error(j.error||"Falha");return j})})}
    function copiar(id){var el=document.getElementById(id);el.select();try{navigator.clipboard.writeText(el.value)}catch(e){document.execCommand("copy")}}
    function carregar(){
      fetch("/api/admin/itens-deposito").then(function(r){return r.json()}).then(function(j){
        if(!j.ok)throw new Error(j.error||"Falha");DADOS=j;renderLinks();renderItens();
      }).catch(function(e){document.getElementById("links").innerHTML='<tr><td colspan="8" style="padding:18px;color:#B91C1C">'+esc(e.message)+'</td></tr>'});
    }
    function renderLinks(){
      var cor={ativo:"badge-green",expirado:"badge-gray",revogado:"badge-red"};
      var html=DADOS.links.map(function(l){
        var abriu=l.acessos.filter(function(a){return a.tipo==="abriu"});
        var ult=l.acessos.length?l.acessos[l.acessos.length-1]:null;
        var ips=l.acessos.slice(-5).reverse().map(function(a){return dt(a.em)+" · "+(a.tipo==="aceitou"?"aceitou":"abriu")+" · "+esc(a.ip||"?")}).join("<br>");
        var acoes=l.estado==="ativo"?'<button class="btn btn-sm" onclick="reemitir(\''+l.id+'\')">Copiar link</button> <button class="btn btn-sm" onclick="revogar(\''+l.id+'\')">Revogar</button>':"";
        return '<tr><td><b>'+esc(l.credor)+'</b>'+(l.mostrarValor?"":' <span class="badge badge-gray">sem valores</span>')+'</td><td>'+dt(l.criadoEm)+'</td><td>'+dt(l.expiraEm)+'</td><td><span class="badge '+cor[l.estado]+'">'+l.estado+'</span></td><td>'+(l.aceitouEm?dt(l.aceitouEm):"—")+'</td><td title="'+esc(ips.replace(/<br>/g,"\n"))+'">'+abriu.length+'</td><td>'+(ult?dt(ult.em)+'<br><small style="color:#6B7280">'+esc(ult.ip||"")+'</small>':"—")+'</td><td style="white-space:nowrap">'+acoes+'</td></tr>';
      }).join("");
      document.getElementById("links").innerHTML=html||'<tr><td colspan="8" style="padding:18px;color:#6B7280">Nenhum link gerado ainda.</td></tr>';
    }
    var aba="ativos";
    function moeda(v){return v.toLocaleString("pt-BR",{style:"currency",currency:"BRL"})}
    function soma(lista){return lista.reduce(function(a,i){return a+(i.valor!=null?i.valor*i.qtd:0)},0)}
    function mudarAba(a){
      aba=a;
      document.getElementById("abaAtivos").className="btn"+(a==="ativos"?" btn-primary":"");
      document.getElementById("abaBaixados").className="btn"+(a==="baixados"?" btn-primary":"");
      renderItens();
    }
    function renderItens(){
      var atv=DADOS.itens.filter(function(i){return i.status==="disponivel"});
      var bx=DADOS.itens.filter(function(i){return i.status!=="disponivel"});
      var sv=atv.filter(function(i){return i.valor==null}).length;
      document.getElementById("totalEstoque").textContent=moeda(soma(atv));
      document.getElementById("qtdAtivos").textContent=atv.length;
      document.getElementById("semValor").textContent=sv?sv+" sem valor (não entram no total)":"todos com valor";
      document.getElementById("totalBaixado").textContent=moeda(soma(bx));
      document.getElementById("qtdBaixados").textContent=bx.length+" itens";
      document.getElementById("abaAtivos").textContent="Ativos ("+atv.length+")";
      document.getElementById("abaBaixados").textContent="Baixados ("+bx.length+")";
      var lista=aba==="ativos"?atv:bx;
      var html=lista.map(function(i){
        var tot=i.valor!=null?moeda(i.valor*i.qtd):"—";
        var btn=i.status==="disponivel"
          ?'<button class="btn btn-sm" onclick="mudarStatus('+i.n+',\'baixado\')">Dar baixa</button>'
          :'<button class="btn btn-sm" onclick="mudarStatus('+i.n+',\'disponivel\')">Reativar</button>';
        return '<tr><td style="text-align:center">'+(i.foto?'<img src="/api/admin/itens-deposito/foto?n='+i.n+'&v='+encodeURIComponent(i.foto)+'" width="64" height="48" style="object-fit:cover;border-radius:4px;display:block;margin:0 auto 4px" loading="lazy">':"")+'<button class="btn btn-sm" onclick="trocarFoto('+i.n+')">Trocar foto</button></td><td>'+i.n+'</td><td style="min-width:220px">'+esc(i.nome)+(i.marca&&i.marca!=="-"?'<br><small style="color:#6B7280">'+esc(i.marca)+'</small>':"")+'</td><td style="white-space:nowrap"><input class="input" type="number" min="0" step="any" style="width:76px" id="q'+i.n+'" value="'+i.qtd+'"> '+esc(i.un)+(i.est?'<br><small style="color:#B45309">aproximada</small>':"")+'</td><td>'+esc(i.cond)+'</td><td><input class="input" style="width:100px" id="v'+i.n+'" value="'+(i.valor==null?"":i.valor)+'" placeholder="a combinar"> <button class="btn btn-sm" onclick="salvarItem('+i.n+')">Salvar</button></td><td style="white-space:nowrap;font-variant-numeric:tabular-nums">'+tot+'</td><td>'+btn+'</td></tr>';
      }).join("");
      document.getElementById("resumoItens").textContent=aba==="ativos"?"Itens que aparecem para os credores.":"Itens que saíram da página dos credores.";
      document.getElementById("itens").innerHTML=html||'<tr><td colspan="8" style="padding:18px;color:#6B7280">'+(aba==="ativos"?"Nenhum item ativo.":"Nenhum item baixado ainda.")+'</td></tr>';
    }
    function gerar(){
      var credor=document.getElementById("credor").value.trim();
      if(credor.length<2){alert("Informe o nome do credor.");return}
      var b=document.getElementById("btnGerar");b.disabled=true;
      post({acao:"gerar",credor:credor,horas:Number(document.getElementById("horas").value),mostrarValor:document.getElementById("mostrarValor").checked}).then(function(j){
        document.getElementById("novoUrl").value=j.url;
        document.getElementById("novoQuem").textContent="Link de "+j.link.credor+" (válido até "+dt(j.link.expiraEm)+")";
        document.getElementById("novoLink").hidden=false;document.getElementById("credor").value="";carregar();
      }).catch(function(e){alert(e.message)}).then(function(){b.disabled=false});
    }
    function reemitir(id){post({acao:"url",id:id}).then(function(j){document.getElementById("novoUrl").value=j.url;document.getElementById("novoQuem").textContent="Link reemitido";document.getElementById("novoLink").hidden=false;copiar("novoUrl");window.scrollTo(0,0)}).catch(function(e){alert(e.message)})}
    function revogar(id){if(!window.confirm("Revogar este link? O credor perde o acesso agora."))return;post({acao:"revogar",id:id}).then(carregar).catch(function(e){alert(e.message)})}
    function salvarItem(n){post({acao:"item",n:n,qtd:document.getElementById("q"+n).value.replace(",","."),valor:document.getElementById("v"+n).value.replace(",",".")}).then(carregar).catch(function(e){alert(e.message)})}
    var fotoAlvo=0;
    function trocarFoto(n){fotoAlvo=n;var i=document.getElementById("arqFoto");i.value="";i.click()}
    function reduzir(file,max){
      return new Promise(function(res,rej){
        var url=URL.createObjectURL(file);var img=new Image();
        img.onload=function(){var r=Math.min(1,max/Math.max(img.width,img.height));var c=document.createElement("canvas");c.width=Math.round(img.width*r);c.height=Math.round(img.height*r);c.getContext("2d").drawImage(img,0,0,c.width,c.height);URL.revokeObjectURL(url);c.toBlob(function(b){b?res(b):rej(new Error("Não consegui ler a imagem."))},"image/jpeg",0.86)};
        img.onerror=function(){rej(new Error("Imagem não suportada. Use JPG ou PNG."))};
        img.src=url;
      });
    }
    document.getElementById("arqFoto").addEventListener("change",function(e){
      var f=e.target.files[0];if(!f)return;var n=fotoAlvo;
      reduzir(f,1100).then(function(b){var fd=new FormData();fd.append("arquivo",b,"foto.jpg");return fetch("/api/admin/itens-deposito/foto?n="+n,{method:"POST",body:fd})})
        .then(function(r){return r.json().then(function(j){if(!r.ok)throw new Error(j.error||"Falha");return j})})
        .then(carregar).catch(function(err){alert(err.message)});
    });
    function mudarStatus(n,status){post({acao:"item",n:n,status:status}).then(carregar).catch(function(e){alert(e.message)})}
    Object.assign(window,{gerar:gerar,copiar:copiar,reemitir:reemitir,revogar:revogar,salvarItem:salvarItem,mudarStatus:mudarStatus,mudarAba:mudarAba,trocarFoto:trocarFoto});
    carregar();
  </script>
</Admin>
