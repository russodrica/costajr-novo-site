  // ── Enviar por WhatsApp (LINKS temporários — o WhatsApp não anexa arquivo) ──
  async function enviarWhatsBanc() {
    const chks = Array.from(document.querySelectorAll("#benvLista .benv-chk:checked")) as HTMLInputElement[];
    if (!chks.length) { alert("Selecione ao menos um documento."); return; }
    const items = chks.map((c) => ({ tipo: c.dataset.tipo, id: c.value }));
    const zap = ((document.getElementById("benvZap") as HTMLInputElement).value || "").replace(/\D/g, "");
    const btn = document.getElementById("btnEnviarZapBanc") as HTMLButtonElement; btn.disabled = true; const orig = btn.textContent; btn.textContent = "Gerando…";
    const box = document.getElementById("benvMsgBox") as HTMLElement;
    try {
      const res = await fetch("/api/admin/doc-empresa/bancarios-whatsapp", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ items }) });
      const d = await res.json();
      if (res.ok) {
        const url = "https://wa.me/" + (zap || "") + "?text=" + encodeURIComponent(d.message);
        let copiada = false;
        try { await (navigator as any).clipboard?.writeText(d.message); copiada = true; } catch {}
        const aviso = (d.pulados && d.pulados > 0) ? `<div style="color:#B45309;font-size:12px;margin-bottom:6px">⚠️ ${d.count} de ${d.pedidos} documento(s) incluídos (${d.pulados} sem arquivo).</div>` : "";
        box.innerHTML = `<div style="border:1.5px solid #25D366;background:#F0FFF4;border-radius:8px;padding:12px">
          ${aviso}<div style="font-weight:700;color:#128C4B;margin-bottom:4px">📲 Links prontos!${copiada ? " (mensagem copiada)" : ""}</div>
          <p style="font-size:12.5px;color:#555;margin:0 0 8px">Clique para abrir o WhatsApp${zap ? " no número informado" : " e escolher o contato"} e enviar. <b>Os links valem 3 dias — quem tiver o link acessa o documento.</b></p>
          <a href="${url}" target="_blank" rel="noopener" class="btn" style="background:#25D366;color:#fff;text-decoration:none;border-color:#25D366">Abrir WhatsApp ↗</a>
        </div>`;
      } else {
        box.innerHTML = `<div class="alert alert-error">${(d.error || "Erro ao gerar links").replace(/</g, "&lt;")}</div>`;
      }
    } catch (e: any) {
      box.innerHTML = `<div class="alert alert-error">${(e?.message || "Erro de rede").replace(/</g, "&lt;")}</div>`;
    }
    btn.disabled = false; btn.textContent = orig;
  }

