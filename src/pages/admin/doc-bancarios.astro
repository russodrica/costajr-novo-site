---
import Admin from "../../layouts/Admin.astro";
import { verifyToken, assertSessaoValida, type AdminClaims } from "../../lib/auth";
import { temPerfilFresco, perfisFrescos, ehFornecedorPerfis } from "../../lib/permissoes";
import { supabaseAdmin } from "../../lib/supabase";
import { bancosSigilosos, bancosRestritosExterno, externosPermitidos, bancoEhSigiloso, linhaEhSigilosa, linhaRestritaExterno, podeVerComoExterno } from "../../lib/sigilo";

const token = Astro.cookies.get("admin_token")?.value;
if (!token) return Astro.redirect("/admin/login");
let claims: AdminClaims;
try { claims = await verifyToken<AdminClaims>(token); if (claims.tipo !== "admin") throw new Error(); await assertSessaoValida(claims); }
catch { Astro.cookies.delete("admin_token", { path: "/" }); return Astro.redirect("/admin/login"); }
// perfis FRESCOS (multi-perfil): o token pode ter só o perfil principal
// FORNECEDOR (externo): entra SÓ para EXTRATOS, somente leitura — faturas de cartão e
// empréstimos NÃO são buscados nem embutidos no HTML (LGPD); envio por e-mail/WhatsApp some.
const perfisPg = await perfisFrescos(claims);
const ehForn = ehFornecedorPerfis(perfisPg);
if (!ehForn && !(await temPerfilFresco(claims, ["admin", "financeiro", "juridico"]))) return Astro.redirect("/admin");

const BANCOS = ["Banco do Brasil", "Caixa Econômica Federal", "Santander", "Sicoob", "Bradesco", "Itaú", "Nubank", "VillelaPay", "Banco Inter"];
// Contas criadas depois: só aparecem nos extratos A PARTIR do mês informado (evita "falta" retroativo).
const BANCO_DESDE: Record<string, string> = { "VillelaPay": "2026-06", "Banco Inter": "2024-01" };
const ymOf = (a: number, m: number) => `${a}-${String(m).padStart(2, "0")}`;
const bancosDoMes = (a: number, m: number) => BANCOS.filter((b) => !BANCO_DESDE[b] || ymOf(a, m) >= BANCO_DESDE[b]);
// Cartões de crédito com fatura MENSAL → slots fixos por mês (como os bancos dos extratos).
const CARTOES = ["Nubank", "Itaú"];
const MESES = ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];

const db = supabaseAdmin();
const [{ data: exRows }, { data: ftRows }, { data: empRows }, sigBancos, restBancos] = await Promise.all([
  db.from("doc_extratos_bancarios").select("*").order("ano", { ascending: false }).order("mes", { ascending: false }),
  ehForn ? Promise.resolve({ data: [] as any[] }) : db.from("doc_cartao_faturas").select("*").order("ano", { ascending: false }).order("mes", { ascending: false }),
  ehForn ? Promise.resolve({ data: [] as any[] }) : db.from("doc_emprestimos").select("*").order("status").order("data_contratacao", { ascending: false }),
  bancosSigilosos(db),
  bancosRestritosExterno(db),
]);
// 🔒 SIGILO: item marcado OU banco/cartão inteiro na lista → fica FORA do "Enviar documentos".
// Continua visível e baixável aqui na tela (quem tem acesso a esta página já tem acesso ao dado).
const sigEx = (r: any) => linhaEhSigilosa(r, sigBancos);
// 👤 RESTRIÇÃO A EXTERNOS: para o contador (fornecedor), o documento restrito nem
// chega à tela — é filtrado aqui, no servidor, antes de virar HTML. A rota de
// download faz a mesma checagem, então o link direto também não funciona.
const restEx = (r: any) => linhaRestritaExterno(r, restBancos);

// Para o EXTERNO: tira da lista tudo que é restrito, menos o que foi liberado
// para ele nome a nome. Para quem é de dentro, nada muda.
const todosEx: any[] = exRows || [];
const todasFt: any[] = ftRows || [];
const todosEmp: any[] = empRows || [];
let permExt: Record<string, string[]> = {};
if (ehForn) {
  const idsRestritos = [...todosEx, ...todasFt, ...todosEmp].filter(restEx).map((r: any) => String(r.id));
  permExt = await externosPermitidos(db, "doc_extratos_bancarios", idsRestritos);
}
const visivelExt = (r: any) => podeVerComoExterno(r, { ehExterno: ehForn, profileId: claims.sub, restritos: restBancos, permitidos: permExt[String(r.id)] || [] });
const extratos: any[] = ehForn ? todosEx.filter(visivelExt) : todosEx;
const faturas: any[] = ehForn ? todasFt.filter(visivelExt) : todasFt;
const emprestimos: any[] = ehForn ? todosEmp.filter(visivelExt) : todosEmp;

// Mapa extratos: ano -> mes -> banco -> [arq]
const mapaEx: Record<number, Record<number, Record<string, any[]>>> = {};
for (const e of extratos) { ((mapaEx[e.ano] ||= {})[e.mes] ||= {})[e.banco] ||= []; mapaEx[e.ano][e.mes][e.banco].push(e); }
// Mapa faturas: ano -> mes -> [faturas]
const mapaFt: Record<number, Record<number, any[]>> = {};
for (const f of faturas) ((mapaFt[f.ano] ||= {})[f.mes] ||= []).push(f);
// Faturas por CARTÃO (slots Nubank/Itaú) + "outros" (cartão fora da lista, p/ não sumir nada).
const normC = (s: string) => String(s || "").toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
const cartaoDe = (f: any) => CARTOES.find((c) => normC(f.cartao).includes(normC(c))) || null;
const mapaFtCartao: Record<number, Record<number, Record<string, any[]>>> = {};
const mapaFtOutros: Record<number, Record<number, any[]>> = {};
for (const f of faturas) { const c = cartaoDe(f); if (c) { (((mapaFtCartao[f.ano] ||= {})[f.mes] ||= {})[c] ||= []).push(f); } else { ((mapaFtOutros[f.ano] ||= {})[f.mes] ||= []).push(f); } }

const hoje = new Date();
const anoVigente = hoje.getFullYear();
const desde = Number(Astro.url.searchParams.get("desde")) || (anoVigente - 1);
function anosDe(mapa: Record<number, any>): number[] {
  const dataAnos = Object.keys(mapa).map(Number);
  const minAno = Math.min(desde, anoVigente - 1, ...(dataAnos.length ? dataAnos : [anoVigente]));
  const out: number[] = []; for (let a = anoVigente; a >= minAno; a--) out.push(a); return out;
}
const anosEx = anosDe(mapaEx);
const anosFt = anosDe(mapaFt);
const anoAnteriorBtn = Math.min(desde, anoVigente - 1) - 1;

function totalAnoEx(a: number) { return Object.values(mapaEx[a] || {}).reduce((s, m) => s + Object.values(m).reduce((x, arr) => x + arr.length, 0), 0); }
function bancosMes(a: number, m: number) { const mm = mapaEx[a]?.[m] || {}; return bancosDoMes(a, m).filter((b) => (mm[b] || []).length > 0).length; }
function totalAnoFt(a: number) { return Object.values(mapaFt[a] || {}).reduce((s, arr) => s + arr.length, 0); }
const fdata = (s: string) => (s ? String(s).split("T")[0].split("-").reverse().join("/") : "—");
const brl = (v: any) => (v != null && v !== "" ? "R$ " + Number(v).toLocaleString("pt-BR", { minimumFractionDigits: 2 }) : "—");
const TIPO_LABEL: Record<string, string> = { emprestimo: "Empréstimo", financiamento: "Financiamento" };
const STATUS_BADGE: Record<string, string> = { ativo: "badge-blue", quitado: "badge-green", renegociado: "badge-orange" };
const STATUS_LABEL: Record<string, string> = { ativo: "Ativo", quitado: "Quitado", renegociado: "Renegociado" };
const empAtivos = emprestimos.filter((e) => e.status === "ativo");
const totalDevendo = empAtivos.reduce((s, e) => s + (Number(e.valor_total) || 0), 0);

// Itens disponíveis para envio por e-mail (apenas os que têm arquivo).
// 🔒 Os SIGILOSOS nem entram nesta lista — não dá para selecionar o que não pode sair.
// (E se alguém forçar o pedido, a API recusa: ver src/lib/sigilo.ts.)
const bancItems = [
  ...extratos.filter((e: any) => !sigEx(e)).map((e: any) => ({ tipo: "extrato", id: e.id, label: `${e.banco} — ${MESES[e.mes - 1]}/${e.ano}`, aba: "extratos", mes: e.mes, ano: e.ano })),
  ...faturas.filter((f: any) => !sigEx(f)).map((f: any) => ({ tipo: "fatura", id: f.id, label: `${f.cartao} — ${MESES[f.mes - 1]}/${f.ano}`, aba: "faturas" })),
  ...emprestimos.filter((e: any) => e.storage_path && !sigEx(e)).map((e: any) => ({ tipo: "emprestimo", id: e.id, label: [e.banco, e.descricao].filter(Boolean).join(" — ") || "Contrato", aba: "emprestimos" })),
];
const bancItemsJson = JSON.stringify(bancItems).replace(/</g, "\\u003c");
const qtdSigilosos = extratos.filter(sigEx).length + faturas.filter(sigEx).length + emprestimos.filter((e: any) => e.storage_path && sigEx(e)).length;
// Bancos + cartões que podem ser marcados como sigilosos (união das duas listas)
const BANCOS_SIGILO = [...new Set([...BANCOS, ...CARTOES])];
const sigiloEstadoJson = JSON.stringify(BANCOS_SIGILO.map((b) => ({ banco: b, sigiloso: bancoEhSigiloso(b, sigBancos), restritoExt: bancoEhSigiloso(b, restBancos) }))).replace(/</g, "\\u003c");
---

<Admin title="Documentos Bancários" current="doc-bancarios">
  <div class="toolbar" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:6px">
    <span style="font-size:1.3rem;font-weight:800;color:var(--brand);text-transform:uppercase;letter-spacing:.02em">🏦 Documentos Bancários</span>
    <span style="flex:1"></span>
    {!ehForn && <button class="btn btn-secondary" onclick="abrirEnviarDocs()" title="Selecione documentos e envie num e-mail só">📨 Enviar documentos</button>}
    {!ehForn && <button class="btn btn-outline" onclick="abrirSigilo()" title="Escolher bancos/cartões que nunca podem ser compartilhados">🔒 Sigilo{qtdSigilosos > 0 ? ` (${qtdSigilosos})` : ''}</button>}
    {!ehForn && <a class="btn btn-outline btn-sm" href="/admin/doc-empresa">← Documentos da Empresa</a>}
  </div>
  <p style="margin:0 0 12px;color:var(--muted);font-size:13px">{ehForn ? "Extratos bancários — acesso de fornecedor (somente visualização e download)." : "Área sensível: extratos, faturas de cartão e empréstimos/financiamentos. Arquivos no cofre privado da empresa (link temporário). Acesso: admin, financeiro e jurídico."}</p>

  <div class="pills" id="bancPills" style="display:flex;gap:8px;flex-wrap:wrap;margin:0 0 16px">
    <button type="button" class="pill active" data-tab="extratos" onclick="setTab(this)">🏦 Extratos</button>
    {!ehForn && <button type="button" class="pill" data-tab="faturas" onclick="setTab(this)">💳 Faturas de Cartão</button>}
    {!ehForn && <button type="button" class="pill" data-tab="emprestimos" onclick="setTab(this)">🏛️ Empréstimos &amp; Financiamentos</button>}
  </div>

  <input type="file" id="fileExtrato" accept=".pdf,.jpg,.jpeg,.png,.webp,.xls,.xlsx,.csv,.ofx" style="display:none" />
  <input type="file" id="fileFatura" accept=".pdf,.jpg,.jpeg,.png,.webp,.xls,.xlsx,.csv,.ofx" style="display:none" />
  <input type="file" id="fileContrato" accept=".pdf,.jpg,.jpeg,.png,.webp,.xls,.xlsx,.csv" style="display:none" />

  <!-- ════════ EXTRATOS ════════ -->
  <section data-sec="extratos">
    <div style="display:flex;justify-content:flex-end;margin-bottom:10px">
      <button class="btn btn-primary" onclick="abrirAnexarExtrato()" data-requer-edicao>📎 Anexar extrato</button>
    </div>
    {anosEx.map((a) => (
      <details class="card ano-card" open={a === anoVigente} style="margin-bottom:12px;padding:0;overflow:hidden">
        <summary class="ano-sum"><span class="chev">▸</span><span style="flex:1">📅 {a}{a === anoVigente ? ' · ano vigente' : ''}</span><span class="badge badge-gray">{totalAnoEx(a)} extrato{totalAnoEx(a) === 1 ? '' : 's'}</span></summary>
        <div style="padding:10px 14px 16px">
          {MESES.map((nome, idx) => {
            const m = idx + 1; const preench = bancosMes(a, m);
            const futuro = a === anoVigente && m > (hoje.getMonth() + 1);
            return (
              <details class="mes-card" style={`margin:8px 0;border:1px solid var(--border);border-radius:10px;overflow:hidden;${futuro ? 'opacity:.55' : ''}`}>
                <summary class="mes-sum"><span class="chev">▸</span><span style="flex:1">{nome}</span><span class={`badge ${preench === bancosDoMes(a, m).length ? 'badge-green' : preench === 0 ? 'badge-gray' : 'badge-orange'}`}>{preench}/{bancosDoMes(a, m).length} bancos</span></summary>
                <div class="grid-cells">
                  {bancosDoMes(a, m).map((banco) => {
                    const arqs = mapaEx[a]?.[m]?.[banco] || [];
                    return (
                      <div class="cell" data-drop-ano={String(a)} data-drop-mes={String(m)} data-drop-banco={banco}>
                        <div class="cell-head"><b style="flex:1;font-size:13.5px">{banco}</b>{arqs.length > 0 ? <span class="badge badge-green" style="font-size:10.5px">✓ {arqs.length}</span> : <span class="badge badge-gray" style="font-size:10.5px">falta</span>}</div>
                        {arqs.map((x) => (
                          <div class="cell-file"><span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title={x.nome_arquivo || ''}>{sigEx(x) ? '🔒' : '📄'} {x.nome_arquivo || 'arquivo'}</span><a href={`/api/admin/doc-empresa/extratos/${x.id}`} target="_blank" rel="noopener" title="Ver" style="text-decoration:none">👁</a><button onclick={`abrirAcessoExt('extrato','${x.id}',${JSON.stringify(x.nome_arquivo || 'extrato')})`} title={restEx(x) ? 'Escondido do contador (externo). Clique para mudar.' : 'Escolher quem de fora pode ver'} data-requer-edicao class="lixo">{restEx(x) ? '🙈' : '👤'}</button><button onclick={`toggleSigilo('extrato','${x.id}',${x.nao_compartilhar ? 'true' : 'false'},${JSON.stringify(banco)},this)`} title={sigEx(x) ? 'Sigiloso — não sai por e-mail/WhatsApp. Clique para liberar.' : 'Marcar como sigiloso (não compartilhar)'} data-requer-edicao class="lixo">{sigEx(x) ? '🔒' : '🔓'}</button><button onclick={`excluirItem('extratos','${x.id}', this)`} title="Excluir" data-requer-edicao class="lixo">🗑️</button></div>
                        ))}
                        <button class="btn btn-outline btn-sm" style="width:100%;margin-top:7px" data-requer-edicao onclick={`anexarCelula(${a},${m},${JSON.stringify(banco)})`}>📎 Anexar</button>
                      </div>
                    );
                  })}
                </div>
              </details>
            );
          })}
        </div>
      </details>
    ))}
    {anoAnteriorBtn >= 2015 && <div style="text-align:center;margin-top:6px"><a class="btn btn-outline btn-sm" href={`?desde=${anoAnteriorBtn}`}>➕ Mostrar {anoAnteriorBtn}</a></div>}
  </section>

  <!-- ════════ FATURAS DE CARTÃO ════════ -->
  <section data-sec="faturas" style="display:none">
    <div style="display:flex;justify-content:flex-end;margin-bottom:10px">
      <button class="btn btn-primary" onclick="abrirAnexarFatura()" data-requer-edicao>📎 Anexar fatura</button>
    </div>
    {anosFt.map((a) => (
      <details class="card ano-card" open={a === anoVigente} style="margin-bottom:12px;padding:0;overflow:hidden">
        <summary class="ano-sum"><span class="chev">▸</span><span style="flex:1">📅 {a}{a === anoVigente ? ' · ano vigente' : ''}</span><span class="badge badge-gray">{totalAnoFt(a)} fatura{totalAnoFt(a) === 1 ? '' : 's'}</span></summary>
        <div style="padding:10px 14px 16px">
          {MESES.map((nome, idx) => {
            const m = idx + 1; const fts = mapaFt[a]?.[m] || [];
            const futuro = a === anoVigente && m > (hoje.getMonth() + 1);
            return (
              <details class="mes-card" open={fts.length > 0} style={`margin:8px 0;border:1px solid var(--border);border-radius:10px;overflow:hidden;${futuro ? 'opacity:.55' : ''}`}>
                <summary class="mes-sum"><span class="chev">▸</span><span style="flex:1">{nome}</span><span class={`badge ${fts.length ? 'badge-green' : 'badge-gray'}`}>{fts.length} fatura{fts.length === 1 ? '' : 's'}</span></summary>
                <div class="grid-cells" data-drop-ft-ano={String(a)} data-drop-ft-mes={String(m)}>
                  {CARTOES.map((cartao) => {
                    const cfts = mapaFtCartao[a]?.[m]?.[cartao] || [];
                    return (
                      <div class="cell">
                        <div class="cell-head"><b style="flex:1;font-size:13.5px">💳 {cartao}</b>{cfts.length > 0 ? <span class="badge badge-green" style="font-size:10.5px">✓ {cfts.length}</span> : <span class="badge badge-gray" style="font-size:10.5px">falta</span>}</div>
                        {cfts.map((f) => (
                          <div class="cell-file"><span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title={f.nome_arquivo || ''}>{sigEx(f) ? '🔒' : '📄'} {f.valor != null ? brl(f.valor) : (f.nome_arquivo || 'fatura')}{f.vencimento ? ` · vence ${fdata(f.vencimento)}` : ''}</span><a href={`/api/admin/doc-empresa/faturas/${f.id}`} target="_blank" rel="noopener" title="Ver" style="text-decoration:none">👁</a><button onclick={`abrirAcessoExt('fatura','${f.id}',${JSON.stringify(f.nome_arquivo || 'fatura')})`} title={restEx(f) ? 'Escondido do contador (externo). Clique para mudar.' : 'Escolher quem de fora pode ver'} data-requer-edicao class="lixo">{restEx(f) ? '🙈' : '👤'}</button><button onclick={`toggleSigilo('fatura','${f.id}',${f.nao_compartilhar ? 'true' : 'false'},${JSON.stringify(f.cartao || cartao)},this)`} title={sigEx(f) ? 'Sigiloso — não sai por e-mail/WhatsApp. Clique para liberar.' : 'Marcar como sigiloso (não compartilhar)'} data-requer-edicao class="lixo">{sigEx(f) ? '🔒' : '🔓'}</button><button onclick={`excluirItem('faturas','${f.id}', this)`} title="Excluir" data-requer-edicao class="lixo">🗑️</button></div>
                        ))}
                        <button class="btn btn-outline btn-sm" style="width:100%;margin-top:7px" data-requer-edicao onclick={`anexarFaturaCartao(${a},${m},${JSON.stringify(cartao)})`}>📎 Anexar</button>
                      </div>
                    );
                  })}
                </div>
                {(mapaFtOutros[a]?.[m] || []).length > 0 && (
                  <div style="padding:6px 14px 0">
                    <div style="font-size:11.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.03em;margin-bottom:4px">Outros cartões</div>
                    {(mapaFtOutros[a][m]).map((f) => (
                      <div class="cell-file" style="background:#fff;border:1px solid var(--border);border-radius:8px;padding:8px 10px;margin-bottom:6px"><span style="flex:1">{sigEx(f) ? '🔒 ' : ''}<b>{f.cartao}</b>{f.valor != null ? ` · ${brl(f.valor)}` : ''}{f.vencimento ? ` · vence ${fdata(f.vencimento)}` : ''} <span style="color:#9CA3AF;font-size:12px">{f.nome_arquivo || ''}</span></span><a href={`/api/admin/doc-empresa/faturas/${f.id}`} target="_blank" rel="noopener" title="Ver" style="text-decoration:none">👁</a><button onclick={`toggleSigilo('fatura','${f.id}',${f.nao_compartilhar ? 'true' : 'false'},${JSON.stringify(f.cartao || '')},this)`} title={sigEx(f) ? 'Sigiloso — não sai por e-mail/WhatsApp. Clique para liberar.' : 'Marcar como sigiloso (não compartilhar)'} data-requer-edicao class="lixo">{sigEx(f) ? '🔒' : '🔓'}</button><button onclick={`excluirItem('faturas','${f.id}', this)`} title="Excluir" data-requer-edicao class="lixo">🗑️</button></div>
                    ))}
                  </div>
                )}
                <div style="padding:6px 14px 10px"><button class="btn btn-outline btn-sm" data-requer-edicao onclick={`anexarFaturaMes(${a},${m})`}>📎 Outro cartão…</button></div>
              </details>
            );
          })}
        </div>
      </details>
    ))}
  </section>

  <!-- ════════ EMPRÉSTIMOS / FINANCIAMENTOS ════════ -->
  <section data-sec="emprestimos" style="display:none">
    <div class="card-grid" style="margin-bottom:12px">
      <div class="stat-card"><div class="stat-value">{empAtivos.length}</div><div class="stat-label">Ativos</div></div>
      <div class="stat-card"><div class="stat-value" style="font-size:1.4rem">{brl(totalDevendo)}</div><div class="stat-label">Valor contratado (ativos)</div></div>
      <div class="stat-card"><div class="stat-value">{emprestimos.length}</div><div class="stat-label">Total (incl. quitados)</div></div>
    </div>
    <div style="display:flex;justify-content:flex-end;margin-bottom:10px">
      <button class="btn btn-primary" onclick="abrirNovoEmp()" data-requer-edicao>+ Novo empréstimo/financiamento</button>
    </div>
    {emprestimos.length === 0 && <div class="card"><div class="empty-state" style="padding:36px"><strong>Nenhum empréstimo ou financiamento cadastrado</strong><p>Use o botão acima para cadastrar.</p></div></div>}
    {emprestimos.map((e) => (
      <div class="card" style="padding:16px 18px;margin-bottom:12px" data-emp-id={e.id} data-drop-emp={e.id}>
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
          <span style="font-size:1.3rem;font-weight:800;color:var(--brand);line-height:1.1">🏦 {e.banco || 'Banco não informado'}</span>
          <span class="badge badge-gray">{TIPO_LABEL[e.tipo] || e.tipo}</span>
          <span style="flex:1"></span>
          <span class={`badge ${STATUS_BADGE[e.status] || 'badge-gray'}`}>{STATUS_LABEL[e.status] || e.status}</span>
        </div>
        {e.descricao && <div style="font-size:13.5px;color:var(--ink-mid);margin:4px 0 12px">{e.descricao}</div>}
        <div class="emp-cols">
          {e.valor_total != null && <div><div class="emp-lbl">Valor total</div><div class="emp-v">{brl(e.valor_total)}</div></div>}
          {e.num_parcelas != null && <div><div class="emp-lbl">Parcelas</div><div class="emp-v">{e.num_parcelas}x</div></div>}
          {e.valor_parcela != null && <div><div class="emp-lbl">Valor da parcela</div><div class="emp-v">{brl(e.valor_parcela)}</div></div>}
          {e.numero_contrato && <div><div class="emp-lbl">Nº do contrato</div><div class="emp-v">{e.numero_contrato}</div></div>}
          {e.data_contratacao && <div><div class="emp-lbl">Contratação</div><div class="emp-v">{fdata(e.data_contratacao)}</div></div>}
          {e.data_primeira_parcela && <div><div class="emp-lbl">1ª parcela</div><div class="emp-v">{fdata(e.data_primeira_parcela)}</div></div>}
          {e.data_vencimento && <div><div class="emp-lbl">Encerramento</div><div class="emp-v" style={`color:${new Date(e.data_vencimento) < new Date() ? '#DC2626' : '#059669'}`}>{fdata(e.data_vencimento)}</div></div>}
        </div>
        {e.observacao && <div style="font-size:12.5px;color:#9CA3AF;margin-top:10px">{e.observacao}</div>}
        <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap">
          {e.storage_path
            ? <a class="btn btn-outline btn-sm" href={`/api/admin/doc-empresa/emprestimos/${e.id}`} target="_blank" rel="noopener">📄 Ver contrato</a>
            : <button class="btn btn-sm" style="background:#FEF3C7;color:#92400E;border:1.5px solid #FCD34D;border-radius:6px" data-requer-edicao onclick={`anexarContrato('${e.id}')`}>📎 Anexar contrato</button>}
          {e.storage_path && <button class="btn btn-outline btn-sm" data-requer-edicao onclick={`anexarContrato('${e.id}')`}>Trocar contrato</button>}
          {e.storage_path && <button class="btn btn-outline btn-sm" data-requer-edicao title={sigEx(e) ? 'Sigiloso — não sai por e-mail/WhatsApp. Clique para liberar.' : 'Marcar como sigiloso (não compartilhar)'} onclick={`toggleSigilo('emprestimo','${e.id}',${e.nao_compartilhar ? 'true' : 'false'},${JSON.stringify(e.banco || '')},this)`}>{sigEx(e) ? '🔒 Sigiloso' : '🔓 Compartilhável'}</button>}
          {e.storage_path && <button class="btn btn-outline btn-sm" data-requer-edicao title="Escolher quem de fora pode ver" onclick={`abrirAcessoExt('emprestimo','${e.id}',${JSON.stringify(e.descricao || 'contrato')})`}>{restEx(e) ? '🙈 Escondido do contador' : '👤 Acesso externo'}</button>}
          <button class="btn btn-secondary btn-sm" data-requer-edicao onclick={`editarEmp(${JSON.stringify(e)})`}>Editar</button>
          <button class="btn btn-danger btn-sm" data-requer-edicao onclick={`excluirItem('emprestimos','${e.id}', this)`}>Excluir</button>
        </div>
      </div>
    ))}
  </section>

  <!-- Modal: enviar documentos por e-mail -->
