<script type="application/json" id="bancItemsData" set:html={bancItemsJson} />
<script type="application/json" id="sigiloData" set:html={sigiloEstadoJson} />

<script>
  const BANC_ITEMS: any[] = JSON.parse((document.getElementById("bancItemsData") as HTMLElement)?.textContent || "[]");
  const SIGILO_BANCOS: any[] = JSON.parse((document.getElementById("sigiloData") as HTMLElement)?.textContent || "[]");
  let benvAbaAtiva = "";
  let sigiloMudou = false;

  // ── 🔒 SIGILO ────────────────────────────────────────────────────────────────
  // Marca documentos que NÃO podem ser enviados por e-mail/WhatsApp. Eles continuam
  // visíveis e baixáveis nesta tela — só saem da lista de "Enviar documentos".
  // O bloqueio de verdade é no servidor (src/lib/sigilo.ts): mesmo forjando o pedido, não vai.
  function abrirSigilo() { sigiloMudou = false; renderSigLista(); (document.getElementById("sigMsg") as HTMLElement).innerHTML = ""; abrirM("modalSigilo"); }
  function fecharSigilo() { fecharM("modalSigilo"); if (sigiloMudou) location.reload(); }
  function renderSigLista() {
    const html = `<div style="display:flex;gap:10px;padding:7px 12px;background:#FAFBFC;border-bottom:1px solid var(--border);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:var(--muted)">
        <span style="flex:1">Banco / cartão</span><span style="width:96px;text-align:center">Esconder<br/>do contador</span><span style="width:96px;text-align:center">Não enviar<br/>por e-mail</span>
      </div>` + SIGILO_BANCOS.map((b: any, i: number) => `
      <div style="display:flex;align-items:center;gap:10px;padding:9px 12px;border-bottom:1px solid var(--border-light);font-size:13.5px">
        <span style="flex:1">${b.restritoExt ? "🙈" : b.sigiloso ? "🔒" : "🏦"} <b>${String(b.banco).replace(/</g, "&lt;")}</b></span>
        <span style="width:96px;text-align:center"><input type="checkbox" data-rest-i="${i}" ${b.restritoExt ? "checked" : ""} onchange="salvarRestritoBanco(this)" style="width:auto" title="Esconder os documentos deste banco do contador (usuário externo)" /></span>
        <span style="width:96px;text-align:center"><input type="checkbox" data-sig-i="${i}" ${b.sigiloso ? "checked" : ""} onchange="salvarSigiloBanco(this)" style="width:auto" title="Impedir que saiam por e-mail/WhatsApp (vale para todo mundo)" /></span>
      </div>`).join("");
    (document.getElementById("sigLista") as HTMLElement).innerHTML = html;
  }
  async function salvarSigiloBanco(el: HTMLInputElement) {
    const i = Number(el.dataset.sigI);
    const item = SIGILO_BANCOS[i];
    if (!item) return;
    const novo = el.checked;
    el.disabled = true;
    const box = document.getElementById("sigMsg") as HTMLElement;
    try {
      const r = await fetch("/api/admin/doc-empresa/sigilo", {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ banco: item.banco, sigiloso: novo }),
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || "Não deu para salvar");
      item.sigiloso = novo;
      sigiloMudou = true;
      box.innerHTML = `<div style="background:#ECFDF5;border:1px solid #6EE7B7;border-radius:8px;padding:8px 11px;color:#065F46;font-size:12.5px">✓ ${String(item.banco).replace(/</g, "&lt;")} ${novo ? "não será mais compartilhado" : "voltou a poder ser compartilhado"}.</div>`;
      renderSigLista();
    } catch (e: any) {
      el.checked = !novo;
      box.innerHTML = `<div class="alert alert-error">${String(e?.message || "Erro").replace(/</g, "&lt;")}</div>`;
    } finally { el.disabled = false; }
  }
  // ── 👤 ACESSO EXTERNO (quem de fora enxerga o documento) ────────────────────
  // Só vale para o perfil "fornecedor" (o contador). Interno vê tudo sempre.
  let aeCtx: { tipo: string; id: string } | null = null;
  let aeExternos: any[] = [];
  async function abrirAcessoExt(tipo: string, id: string, nome: string) {
    aeCtx = { tipo, id };
    (document.getElementById("aeDoc") as HTMLElement).textContent = `📄 ${nome}`;
    (document.getElementById("aeMsg") as HTMLElement).innerHTML = "";
    (document.getElementById("aeLista") as HTMLElement).innerHTML = `<p style="padding:10px;color:#9CA3AF;font-size:13px">Carregando…</p>`;
    abrirM("modalAcessoExt");
    try {
      const r = await fetch(`/api/admin/doc-empresa/acesso-externo?tipo=${encodeURIComponent(tipo)}&id=${encodeURIComponent(id)}`);
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || "Não deu para carregar");
      aeExternos = d.externos || [];
      const modo = !d.restrito ? "todos" : (d.permitidos || []).length ? "alguns" : "ninguem";
      document.querySelectorAll<HTMLInputElement>('input[name="aeModo"]').forEach((el) => { el.checked = el.value === modo; });
      renderAeLista(d.permitidos || []);
      aeModoMudou();
    } catch (e: any) {
      (document.getElementById("aeMsg") as HTMLElement).innerHTML = `<div class="alert alert-error">${String(e?.message || "Erro").replace(/</g, "&lt;")}</div>`;
    }
  }
  function renderAeLista(marcados: string[]) {
    const box = document.getElementById("aeLista") as HTMLElement;
    if (!aeExternos.length) {
      box.innerHTML = `<p style="padding:10px;color:#9CA3AF;font-size:13px">Nenhum usuário externo cadastrado no Portal.</p>`;
      return;
    }
    box.innerHTML = aeExternos.map((p: any) => `
      <label style="display:flex;align-items:center;gap:9px;padding:9px 12px;border-bottom:1px solid var(--border-light);cursor:pointer;font-size:13.5px">
        <input type="checkbox" class="ae-chk" value="${p.id}" ${marcados.includes(p.id) ? "checked" : ""} style="width:auto" />
        <span style="flex:1">👤 <b>${String(p.nome).replace(/</g, "&lt;")}</b>${p.email ? ` <span style="color:#9CA3AF;font-size:12px">${String(p.email).replace(/</g, "&lt;")}</span>` : ""}</span>
      </label>`).join("");
  }
  function aeModoMudou() {
    const modo = (document.querySelector('input[name="aeModo"]:checked') as HTMLInputElement)?.value || "todos";
    (document.getElementById("aeLista") as HTMLElement).style.display = modo === "alguns" ? "" : "none";
  }
  async function salvarAcessoExt() {
    if (!aeCtx) return;
    const modo = (document.querySelector('input[name="aeModo"]:checked') as HTMLInputElement)?.value || "todos";
    const permitidos = modo === "alguns"
      ? Array.from(document.querySelectorAll<HTMLInputElement>("#aeLista .ae-chk:checked")).map((c) => c.value)
      : [];
    if (modo === "alguns" && !permitidos.length) {
      (document.getElementById("aeMsg") as HTMLElement).innerHTML = `<div class="alert alert-error">Marque ao menos uma pessoa, ou escolha "Ninguém de fora vê".</div>`;
      return;
    }
    const btn = document.getElementById("btnAeSalvar") as HTMLButtonElement;
    btn.disabled = true; const orig = btn.textContent; btn.textContent = "Salvando…";
    try {
      const r = await fetch("/api/admin/doc-empresa/acesso-externo", {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ tipo: aeCtx.tipo, id: aeCtx.id, restrito: modo !== "todos", permitidos }),
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || "Não deu para salvar");
      location.reload();
    } catch (e: any) {
      (document.getElementById("aeMsg") as HTMLElement).innerHTML = `<div class="alert alert-error">${String(e?.message || "Erro").replace(/</g, "&lt;")}</div>`;
      btn.disabled = false; btn.textContent = orig;
    }
  }

  // Esconder um BANCO inteiro do contador (usuário externo)
  async function salvarRestritoBanco(el: HTMLInputElement) {
    const i = Number(el.dataset.restI);
    const item = SIGILO_BANCOS[i];
    if (!item) return;
    const novo = el.checked;
    el.disabled = true;
    const box = document.getElementById("sigMsg") as HTMLElement;
    try {
      const r = await fetch("/api/admin/doc-empresa/acesso-externo", {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ banco: item.banco, restrito: novo }),
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || "Não deu para salvar");
      item.restritoExt = novo;
      sigiloMudou = true;
      box.innerHTML = `<div style="background:#ECFDF5;border:1px solid #6EE7B7;border-radius:8px;padding:8px 11px;color:#065F46;font-size:12.5px">✓ ${String(item.banco).replace(/</g, "&lt;")} ${novo ? "escondido do contador" : "voltou a aparecer para o contador"}.</div>`;
      renderSigLista();
    } catch (e: any) {
      el.checked = !novo;
      box.innerHTML = `<div class="alert alert-error">${String(e?.message || "Erro").replace(/</g, "&lt;")}</div>`;
    } finally { el.disabled = false; }
  }

  // Cadeado de UM documento (extrato/fatura/contrato)
  async function toggleSigilo(tipo: string, id: string, atual: boolean, banco: string, btn: HTMLButtonElement) {
    const bancoBloqueado = SIGILO_BANCOS.some((b: any) => b.sigiloso && String(b.banco).toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").trim() === String(banco || "").toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").trim());
    if (bancoBloqueado && atual === false) {
      alert(`Todos os documentos de "${banco}" já estão marcados como sigilosos.\n\nPara liberar, use o botão 🔒 Sigilo na barra do topo e desmarque o banco.`);
      return;
    }
    const novo = !atual;
    btn.disabled = true;
    try {
      const r = await fetch("/api/admin/doc-empresa/sigilo", {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ tipo, id, nao_compartilhar: novo }),
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || "Não deu para salvar");
      location.reload();
    } catch (e: any) {
      alert("Erro: " + (e?.message || "tente de novo"));
      btn.disabled = false;
    }
