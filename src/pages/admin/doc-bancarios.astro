  function renderBenvLista() {
    const busca = (document.getElementById("benvBusca") as HTMLInputElement)?.value.toLowerCase().trim() || "";
    const visivel = BANC_ITEMS.filter((i: any) => (!benvAbaAtiva || i.aba === benvAbaAtiva) && (!busca || i.label.toLowerCase().includes(busca)));
    const icons: Record<string, string> = { extrato: "🏦", fatura: "💳", emprestimo: "🏛️" };
    let html = "";
    for (const it of visivel) {
      html += `<label class="benv-item" style="display:flex;align-items:center;gap:8px;padding:5px 2px;font-size:13px;cursor:pointer">
        <input type="checkbox" class="benv-chk" value="${it.id}" data-tipo="${it.tipo}" onchange="benvCountUpd()" />
        <span>${icons[it.tipo] || "📄"} ${(it.label || "").replace(/</g, "&lt;")}</span></label>`;
    }
    (document.getElementById("benvLista") as HTMLElement).innerHTML = html || `<p style="color:#9CA3AF;padding:10px">Nenhum documento${benvAbaAtiva ? " nesta categoria" : ""} disponível.</p>`;
    benvCountUpd();
  }
  function benvCountUpd() {
    const n = document.querySelectorAll("#benvLista .benv-chk:checked").length;
    (document.getElementById("benvCount") as HTMLElement).textContent = `${n} selecionado(s)`;
  }
  function filtrarEnvBanc() { renderBenvLista(); }
  function popularMesesCompl() {
    const sel = document.getElementById("benvMesCompl") as HTMLSelectElement;
    const MNOMES = ["Janeiro","Fevereiro","Março","Abril","Maio","Junho","Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"];
    const vistos = new Set<string>();
    const combos: {mes: number; ano: number}[] = [];
    for (const it of BANC_ITEMS) {
      if (it.tipo === "extrato" && it.mes && it.ano) {
        const k = `${it.mes}/${it.ano}`;
        if (!vistos.has(k)) { vistos.add(k); combos.push({ mes: Number(it.mes), ano: Number(it.ano) }); }
      }
    }
    combos.sort((a, b) => b.ano !== a.ano ? b.ano - a.ano : b.mes - a.mes);
    sel.innerHTML = `<option value="">— escolha o mês —</option>` + combos.map((c) => `<option value="${c.mes}/${c.ano}">${MNOMES[c.mes - 1]} / ${c.ano}</option>`).join("");
  }
  function selecionarMesCompleto() {
    const sel = document.getElementById("benvMesCompl") as HTMLSelectElement;
    if (!sel.value) { alert("Selecione um mês antes de marcar."); return; }
    const [mes, ano] = sel.value.split("/").map(Number);
    const MNOMES = ["Janeiro","Fevereiro","Março","Abril","Maio","Junho","Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"];
    // Ativa aba Extratos e limpa busca
    benvAbaAtiva = "extratos";
    document.querySelectorAll("[data-benv-aba]").forEach((b) => b.classList.toggle("active", (b as HTMLElement).dataset.benvAba === "extratos"));
    (document.getElementById("benvBusca") as HTMLInputElement).value = "";
    renderBenvLista();
    // Marca apenas os extratos do mês escolhido
    let marcados = 0;
    document.querySelectorAll("#benvLista .benv-chk").forEach((c) => {
      const chk = c as HTMLInputElement;
      const item = BANC_ITEMS.find((i: any) => i.id === chk.value);
      const ok = item && item.tipo === "extrato" && Number(item.mes) === mes && Number(item.ano) === ano;
      chk.checked = !!ok;
      if (ok) marcados++;
    });
    benvCountUpd();
    if (!marcados) {
      alert(`Nenhum extrato de ${MNOMES[mes - 1]}/${ano} encontrado.`);
    } else {
      const subjEl = document.getElementById("benvSubject") as HTMLInputElement;
      if (!subjEl.value.trim()) subjEl.value = `Extratos Bancários — ${MNOMES[mes - 1]}/${ano} — Costa Júnior`;
    }
  }
