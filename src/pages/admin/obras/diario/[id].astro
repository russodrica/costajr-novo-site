---
// Relatório de Visita — edição e impressão.
//
// O relatório pertence a uma OBRA já cadastrada: quem cria é a ficha da obra
// (/admin/obras/<id>), esta tela só preenche e publica.
//
// A tela é um formulário só: ocorrências e checklist são listas que a pessoa
// monta na hora, e tudo vai para o servidor num salvamento único. Salvar por
// partes deixaria o relatório meio gravado se a conexão caísse no meio.
//
// O PDF sai pela impressão do navegador com folha de estilo própria (@media
// print): no celular e no computador, "Imprimir → Salvar como PDF". Sem
// depender de biblioteca de PDF, que é onde esse tipo de tela costuma quebrar.
import Admin from "../../../../layouts/Admin.astro";
import { verifyToken, type AdminClaims } from "../../../../lib/auth";
import { supabaseAdmin } from "../../../../lib/supabase";
import {
  CLIMA, CONDICAO, EMPRESAS, empresaDe, areaDe, statusLabel, statusBadge,
  fmtDataExtenso, fmtDataBr,
} from "../../../../lib/rdo";

const token = Astro.cookies.get("admin_token")?.value;
if (!token) return Astro.redirect("/admin/login");
try { const c = await verifyToken<AdminClaims>(token); if (c.tipo !== "admin") throw new Error(); }
catch { Astro.cookies.delete("admin_token", { path: "/" }); return Astro.redirect("/admin/login"); }

const db = supabaseAdmin();
const id = Astro.params.id!;
const { data: rdo } = await db.from("obras_rdo").select("*").eq("id", id).maybeSingle();
if (!rdo) return Astro.redirect("/admin/obras/diario");

// a obra vem da carteira da área: Obras & Projetos ou Fundação
const area = areaDe(rdo.area);
const { data: obra } = await db.from(area.tabela)
  .select("id, nome, codigo, cliente, endereco, cidade, uf, responsavel_nome")
  .eq("id", area.v === "fundacao" ? rdo.fundacao_id : rdo.obra_id).maybeSingle();
const voltarPara = obra
  ? (area.v === "fundacao" ? `/admin/obras/fundacao/${obra.id}` : `/admin/obras/${obra.id}`)
  : (area.v === "fundacao" ? "/admin/obras/fundacao" : "/admin/obras");
const { data: checklist } = await db.from("obras_rdo_checklist").select("*").eq("rdo_id", id).order("ordem");
const { data: fotos } = await db.from("obras_rdo_fotos").select("*").eq("rdo_id", id).order("ordem").order("created_at");
const { data: tiposOcor } = await db.from("obras_cat_ocorrencias").select("nome").eq("ativo", true).order("nome");
const { data: responsaveis } = await db.from("obras_cat_responsaveis")
  .select("nome, padrao").eq("ativo", true).order("padrao", { ascending: false }).order("nome");

// Fundação não usa checklist — a visita da consultoria é laudo, não conferência
// item a item. Em Obras o bloco continua.
const usaChecklist = area.v === "obras";

// Relatório trazido do app antigo: é histórico do que foi registrado em campo.
// Abre em SOMENTE LEITURA — dá para ver e imprimir, não para reescrever.
const importado = rdo.origem === "importado";

// Outros relatórios da MESMA obra na MESMA data: não é erro (pode haver duas
// visitas no dia), mas a pessoa precisa saber que existe outro, para não
// preencher em duplicidade sem perceber.
const { data: mesmoDia } = await db.from("obras_rdo")
  .select("id")
  .eq(area.v === "fundacao" ? "fundacao_id" : "obra_id", area.v === "fundacao" ? rdo.fundacao_id : rdo.obra_id)
  .eq("data", rdo.data).neq("id", id);
const outrosNoDia = (mesmoDia || []).length;
const respPadrao = (responsaveis || []).find((r: any) => r.padrao)?.nome || "";

// declarado ANTES de `dados`, que usa este valor no cabeçalho da folha impressa
const endereco = [obra?.endereco, [obra?.cidade, obra?.uf].filter(Boolean).join("/")]
  .filter(Boolean).join(" — ");

const dados = {
  id,
  ocorrencias: Array.isArray(rdo.ocorrencias_itens) ? rdo.ocorrencias_itens : [],
  checklist: (checklist || []).map((c: any) => ({ item: c.item, situacao: c.situacao, observacao: c.observacao || "" })),
  usaChecklist,
  importado,
  assinaturas: {
    visita: rdo.assinatura_visita || "",
    cliente: rdo.assinatura_cliente || "",
  },
  // cabeçalho e rodapé da folha impressa
  papel: {
    area: area.label,
    obra: obra?.nome || "",
    codigo: obra?.codigo || "",
    cliente: obra?.cliente || "",
    endereco,
    data: fmtDataBr(rdo.data),
    dataIso: String(rdo.data || "").slice(0, 10),   // AAAA-MM-DD para o nome do arquivo
    dataExtenso: fmtDataExtenso(rdo.data),
    numero: String(rdo.id).slice(0, 8).toUpperCase(),
  },
};
const listas = {
  tipos: (tiposOcor || []).map((t: any) => t.nome),
  responsaveis: (responsaveis || []).map((r: any) => r.nome),
  // logo/nome/CNPJ de cada empresa, para o cabeçalho impresso trocar sem recarregar
  empresas: EMPRESAS.map((e) => ({ v: e.v, nome: e.nome, cnpj: e.cnpj, logo: e.logo, cor: e.cor })),
};
const emp = empresaDe(rdo.empresa);
---
<Admin title={`Relatório de visita ${fmtDataBr(rdo.data)} — ${obra?.nome || "Obra"}`} current="obras-diario">
  <div class="toolbar nao-imprimir">
    <a class="btn btn-secondary btn-sm" href={voltarPara}>‹ Voltar</a>
    <span class="toolbar-title" style="margin-left:8px">
      {fmtDataBr(rdo.data)} · {obra?.nome || "Obra"}
      <span class="badge badge-gray" style="margin-left:6px">{area.icone} {area.label}</span>
      <span class={`badge ${statusBadge(rdo.status)}`} id="badgeStatus" style="margin-left:8px">{statusLabel(rdo.status)}</span>
    </span>
    <div style="margin-left:auto;display:flex;gap:8px">
      <button class="btn btn-secondary" id="btnImprimir">🖨️ Imprimir / PDF</button>
      {!importado && (
        <>
          <button class="btn btn-secondary" data-requer-edicao id="btnSalvar" onclick="salvar('rascunho')">Salvar rascunho</button>
          <button class="btn btn-primary" data-requer-edicao id="btnPublicar" onclick="salvar('publicado')">Publicar</button>
        </>
      )}
    </div>
  </div>

  <div id="msg" class="nao-imprimir"></div>

  {importado && (
    <div class="alert alert-info nao-imprimir" style="margin-bottom:14px">
      <strong>Relatório importado do Diário de Obra</strong> — histórico do que foi registrado em campo,
      aberto em somente leitura. Dá para ver e gerar o PDF.
      {rdo.numero_origem ? ` Nº de origem: ${rdo.numero_origem}.` : ""}
    </div>
  )}

  {outrosNoDia > 0 && (
    <div class="alert alert-info nao-imprimir" style="margin-bottom:14px">
      Existe{outrosNoDia > 1 ? "m" : ""} mais {outrosNoDia} relatório{outrosNoDia > 1 ? "s" : ""} desta obra
      na mesma data. <a href={`/admin/obras/diario?obra=${obra?.id || ""}`}>Ver todos desta obra</a>.
    </div>
  )}

  <!-- Tudo o que sai no PDF fica dentro de #folha. A impressão apaga o resto da
       tela pelo id, e não por classe do layout: assim nenhuma barra lateral
       nova quebra o relatório mais adiante. -->
  <div id="folha">

  <!-- ── cabeçalho que aparece no papel (a empresa emissora manda no logo) ── -->
  <div class="folha-topo so-imprimir" id="folhaTopo" style={`border-color:${emp.cor}`}>
    <div class="folha-marca">
      <!-- se o arquivo do logo ainda não estiver em /public, some em vez de virar
           ícone quebrado no meio do papel -->
      <img id="folhaLogo" src={emp.logo} alt="" onerror="this.style.display='none'" />
      <div>
        <strong style="font-size:15px">RELATÓRIO DE VISITA</strong>
        <div id="folhaEmpresa" style="font-size:11px;color:#555">{emp.nome}{emp.cnpj ? ` · CNPJ ${emp.cnpj}` : ""}</div>
      </div>
    </div>
    <div style="text-align:right;font-size:12px">
      <div><strong>{obra?.nome}{obra?.codigo ? ` (${obra.codigo})` : ""}</strong></div>
      <div style="font-size:11px;color:#555">{obra?.cliente ? `Cliente: ${obra.cliente}` : ""}{endereco ? ` · ${endereco}` : ""}</div>
      <div style="margin-top:3px"><strong>{fmtDataBr(rdo.data)}</strong>
        <span style="font-size:11px;color:#555;text-transform:capitalize"> — {fmtDataExtenso(rdo.data)}</span></div>
    </div>
  </div>

  <form id="f">
    <!-- ── emissão ── -->
    <div class="card nao-imprimir" style="margin-bottom:14px">
      <h3 style="margin:0 0 12px">Emissão</h3>
      <div class="form-row">
        <div class="form-group">
          <label>Relatório emitido por *</label>
          <select name="empresa" id="selEmpresa">
            {EMPRESAS.map((e) => (
              <option value={e.v} selected={(rdo.empresa || "engenharia") === e.v}>{e.nome}</option>
            ))}
          </select>
          <small style="color:var(--ink-light)">Define o logo e o CNPJ do cabeçalho quando o relatório for impresso ou salvo em PDF.</small>
        </div>
        <div class="form-group">
          <label>Obra ({area.label})</label>
          <input value={obra?.nome || ""} readonly style="background:var(--gray-50)" />
          <small style="color:var(--ink-light)">
            A obra vem do cadastro da área. <a href={voltarPara}>Abrir o cadastro</a>
          </small>
        </div>
      </div>
    </div>

    <!-- ── condições do dia ── -->
    <div class="card" style="margin-bottom:14px">
      <h3 style="margin:0 0 14px">Condições da visita</h3>
      <div class="form-row">
        <div class="form-group">
          <label>Clima pela manhã</label>
          <select name="clima_manha">
            <option value="">—</option>
            {CLIMA.map((c) => (<option value={c.v} selected={rdo.clima_manha === c.v}>{c.icone} {c.label}</option>))}
          </select>
        </div>
        <div class="form-group">
          <label>Clima à tarde</label>
          <select name="clima_tarde">
            <option value="">—</option>
            {CLIMA.map((c) => (<option value={c.v} selected={rdo.clima_tarde === c.v}>{c.icone} {c.label}</option>))}
          </select>
        </div>
        <div class="form-group">
          <label>Condição de trabalho</label>
          <select name="condicao">
            <option value="">—</option>
            {CONDICAO.map((c) => (<option value={c.v} selected={rdo.condicao === c.v}>{c.label}</option>))}
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Início da visita</label><input type="time" name="inicio_jornada" value={rdo.inicio_jornada || ""} /></div>
        <div class="form-group"><label>Fim da visita</label><input type="time" name="fim_jornada" value={rdo.fim_jornada || ""} /></div>
        <div class="form-group">
          <label>Responsável pela visita</label>
          <input name="responsavel" list="listaResp" autocomplete="off"
                 value={rdo.responsavel || respPadrao || obra?.responsavel_nome || ""} />
          <datalist id="listaResp">
            {(responsaveis || []).map((r: any) => (<option value={r.nome}></option>))}
          </datalist>
          <small style="color:var(--ink-light)">Clique para escolher da lista ou digite um nome novo — ele é guardado para as próximas visitas.</small>
        </div>
      </div>
    </div>

    <!-- ── serviços verificados ── -->
    <div class="card" style="margin-bottom:14px">
      <div class="bloco-cab">
        <h3>Serviços verificados <span style="color:#B91C1C">*</span></h3>
        <button type="button" class="btn btn-secondary btn-sm nao-imprimir" id="btnModelo">Usar modelo de texto</button>
      </div>
      <p class="nao-imprimir dica">
        É o corpo do relatório: o que estava em execução, em qual frente, e o que foi constatado.
        Sem isso o relatório não publica.
      </p>
      <textarea name="atividades" id="taAtividades" rows="10" class="campo-grande"
        placeholder="Ex.: Frente 1 — execução de estacas hélice contínua no eixo A; concretagem conforme projeto, cota de arrase conferida.">{rdo.atividades || ""}</textarea>
      <div class="nao-imprimir contador"><span id="contAtiv"></span></div>
    </div>

    <!-- ── ocorrências ── -->
    <div class="card" style="margin-bottom:14px">
      <div class="bloco-cab">
        <h3>Ocorrências</h3>
        <span style="display:flex;gap:8px" class="nao-imprimir">
          <button type="button" class="btn btn-secondary btn-sm" id="btnSemOcor">Nenhuma ocorrência</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="addLinha('ocor')">+ Adicionar</button>
        </span>
      </div>
      <p class="nao-imprimir dica">
        Chuva, acidente, falta de material, área não liberada, visita técnica. Se o dia correu sem nada
        a registrar, clique em <strong>Nenhuma ocorrência</strong> — o relatório sai dizendo isso.
      </p>
      <table class="tabela-itens"><thead><tr><th style="width:30%">Tipo</th><th>Descrição</th><th style="width:120px">Horas paradas</th><th class="nao-imprimir" style="width:40px"></th></tr></thead>
        <tbody id="tbOcor"></tbody></table>
    </div>

    <!-- ── checklist (só na área de Obras) ── -->
    {usaChecklist && (
    <div class="card" style="margin-bottom:14px">
      <div class="bloco-cab">
        <h3>Checklist</h3>
        <button type="button" class="btn btn-secondary btn-sm nao-imprimir" onclick="addLinha('check')">+ Item</button>
      </div>
      <table class="tabela-itens"><thead><tr><th style="width:45%">Item</th><th style="width:20%">Situação</th><th>Observação</th><th class="nao-imprimir" style="width:40px"></th></tr></thead>
        <tbody id="tbCheck"></tbody></table>
    </div>
    )}

    <!-- ── observações ── -->
    <div class="card" style="margin-bottom:14px">
      <h3 style="margin:0 0 6px">Observações e recomendações</h3>
      <p class="nao-imprimir dica">
        O que a obra precisa fazer até a próxima visita: recomendações técnicas, decisões tomadas e pendências.
      </p>
      <textarea name="observacoes" rows="6" class="campo-grande"
        placeholder="Ex.: Recomenda-se refazer o nivelamento do eixo B antes da próxima concretagem.">{rdo.observacoes || ""}</textarea>
    </div>
  </form>

  <!-- ── fotos ── -->
  <div class="card">
    <div class="bloco-cab">
      <h3>Fotos da visita <span class="badge badge-gray" id="qtdFotos">{(fotos || []).length}</span></h3>
      <label class="btn btn-secondary btn-sm nao-imprimir" style="cursor:pointer;margin:0">
        + Adicionar fotos
        <input type="file" id="inpFotos" accept="image/*" multiple style="display:none" />
      </label>
    </div>
    <p class="nao-imprimir" style="font-size:12.5px;color:var(--ink-mid);margin:0 0 12px">
      Pelo celular, o botão abre a câmera. A legenda salva sozinha ao sair do campo.
    </p>
    <div id="galeria" class="galeria">
      {(fotos || []).map((f: any) => (
        <figure class="foto" data-id={f.id}>
          <img src={`/api/admin/obras/diario/fotos/${f.id}`} alt={f.legenda || ""} loading="lazy" />
          <figcaption>
            <input class="legenda" value={f.legenda || ""} placeholder="Legenda da foto" data-id={f.id} />
            <button type="button" class="btn-remover nao-imprimir" data-id={f.id} title="Remover">✕</button>
          </figcaption>
        </figure>
      ))}
    </div>
    <p id="semFotos" class="nao-imprimir" style="display:none;color:var(--ink-light);font-size:13px;margin:8px 0 0">Nenhuma foto ainda.</p>
  </div>

  <!-- ── assinaturas: traçadas com o dedo, ainda na obra ── -->
  <div class="card assinaturas">
    <div class="bloco-cab">
      <h3>Assinaturas</h3>
      <span class="nao-imprimir" style="font-size:12px;color:var(--ink-light)" id="statusAssin"></span>
    </div>
    <p class="nao-imprimir dica">
      Assine com o dedo pelo celular ou com o mouse pelo computador. A assinatura entra no PDF.
    </p>
    <div class="assin-grade">
      <div class="assin">
        <canvas id="assinVisita" width="900" height="260" data-campo="visita"></canvas>
        <img id="imgAssinVisita" class="assin-img" alt="" />
        <input class="assin-nome" name="assinatura_visita_nome" placeholder="Nome de quem assina"
               value={rdo.assinatura_visita_nome || rdo.responsavel || ""} />
        <div class="assin-rot">Responsável pela visita</div>
        <button type="button" class="btn btn-secondary btn-sm nao-imprimir" data-limpar="visita">Limpar</button>
      </div>
      <div class="assin">
        <canvas id="assinCliente" width="900" height="260" data-campo="cliente"></canvas>
        <img id="imgAssinCliente" class="assin-img" alt="" />
        <input class="assin-nome" name="assinatura_cliente_nome" placeholder="Nome de quem assina"
               value={rdo.assinatura_cliente_nome || ""} />
        <div class="assin-rot">Responsável pela obra / Cliente</div>
        <button type="button" class="btn btn-secondary btn-sm nao-imprimir" data-limpar="cliente">Limpar</button>
      </div>
    </div>
  </div>

  </div><!-- /#folha -->

  <!-- montado por JS na hora de imprimir -->
  <div id="folhaPrint" aria-hidden="true"></div>

  <script type="application/json" id="dadosRDO" set:html={JSON.stringify(dados)}></script>
  <script type="application/json" id="listasRDO" set:html={JSON.stringify(listas)}></script>

  <style>
    /* textarea fora de .form-group não herda a largura do portal — sem isto o
       campo nasce do tamanho padrão do navegador (aquele quadradinho) */
    .campo-grande { width:100%; display:block; font-family:inherit; font-size:.92rem; line-height:1.5;
                    padding:12px 14px; border:1.5px solid var(--border); border-radius:10px;
                    background:var(--surface); color:var(--ink); resize:vertical; min-height:120px; }
    .campo-grande:focus { outline:none; border-color:#2563EB; box-shadow:0 0 0 3px rgba(37,99,235,.12); }
    .dica { font-size:12.5px; color:var(--ink-mid); margin:0 0 10px; }
    .contador { font-size:11.5px; color:var(--ink-light); text-align:right; margin-top:5px; }
    .bloco-cab { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; }
    .bloco-cab h3 { margin:0; font-size:1rem; }
    .tabela-itens { width:100%; border-collapse:collapse; }
    .tabela-itens th { text-align:left; font-size:11.5px; text-transform:uppercase; letter-spacing:.04em;
                       color:var(--ink-light); padding:6px 8px; border-bottom:1px solid var(--border); }


    .folha-topo, .so-imprimir { display:none; }
    .folha-marca { display:flex; align-items:center; gap:12px; }
    .folha-marca img { height:38px; width:auto; object-fit:contain; }

    .assin-grade { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
    .assin { display:flex; flex-direction:column; gap:7px; align-items:stretch; }
    .assin canvas { width:100%; height:130px; border:1.5px dashed var(--border); border-radius:10px;
                    background:#fff; touch-action:none; cursor:crosshair; }
    .assin-img { display:none; width:100%; height:130px; object-fit:contain; }
    .assin-nome { font-size:.88rem; }
    .assin-rot { font-size:11px; color:var(--ink-light); text-align:center;
                 border-top:1px solid var(--border); padding-top:5px; }
    @media (max-width:640px) { .assin-grade { grid-template-columns:1fr; } }

  </style>

  <!--
    Impressão em folha de estilo GLOBAL de propósito.
    O <style> comum do Astro é escopado: ele reescreve `.sidebar` para
    `.sidebar[data-astro-cid-...]`, que NÃO casa com a barra lateral do layout —
    era por isso que o menu e o cabeçalho saíam no PDF. Aqui a regra apaga tudo
    e reacende só o que está dentro de #folha, independente das classes do
    layout.
  -->
  <!--
    A folha do PDF é MONTADA na hora de imprimir (#folhaPrint), não é a tela
    espremida. Imprimir o formulário trazia caixa de seleção, seta de dropdown,
    texto de ajuda e campo vazio ocupando meia página. Aqui cada valor vira
    texto, e o que está em branco simplesmente não entra.

    O estilo é GLOBAL de propósito: o <style> comum do Astro é escopado e não
    alcança a barra lateral nem o cabeçalho do portal — era por isso que o menu
    saía no PDF.
  -->
  <!--
    ATENÇÃO: o <style> comum do Astro é ESCOPADO — ele carimba cada seletor com
    um atributo que só existe no HTML gerado no servidor. A foto recém-anexada é
    criada por JavaScript, sem esse carimbo: as regras não a alcançavam e ela
    aparecia em tamanho original, ocupando a tela inteira. Por isso as regras da
    galeria e das linhas de tabela ficam aqui, num bloco global preso ao id do
    contêiner (que existe no HTML) — assim valem para o que o JS criar e não
    vazam para as outras telas do portal.
  -->
  <style is:global>
    #folhaPrint { display: none; }

    #galeria { display:grid; grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); gap:14px; }
    #galeria .foto { margin:0; border:1px solid var(--border); border-radius:10px;
                     overflow:hidden; background:var(--surface); }
    #galeria .foto img { width:100%; height:150px; object-fit:cover; display:block; }
    #galeria .foto figcaption { display:flex; gap:6px; align-items:center; padding:8px; }
    #galeria .foto .legenda { flex:1; font-size:12.5px; padding:6px 8px; min-width:0; }
    #galeria .btn-remover { background:none; border:0; color:#B91C1C; cursor:pointer;
                            font-size:13px; padding:4px 6px; }

    #f .tabela-itens td { padding:5px 6px; vertical-align:middle; }
    #f .tabela-itens input, #f .tabela-itens select { width:100%; padding:7px 9px; font-size:.9rem; }
    #f .tabela-itens .lixo { background:none; border:0; color:#B91C1C; cursor:pointer;
                             font-size:15px; padding:4px 6px; }

    @media print {
      /* A folha é movida para filha direta do <body> antes de imprimir, e todo
         o resto do body some. Nada de position:absolute aqui: elemento fora do
         fluxo ignora a margem da página e o texto sai cortado na borda. */
      body > *:not(#folhaPrint) { display: none !important; }
      #folhaPrint {
        display: flex !important; flex-direction: column;
        min-height: 100vh;   /* uma página inteira: joga a assinatura para o pé */
        font-family: "Open Sans", Arial, sans-serif; color: #1A1D24; font-size: 12pt;
      }
      html, body { background: #fff !important; margin: 0 !important; padding: 0 !important;
                   height: auto !important; overflow: visible !important; }

      /* cabeçalho */
      #folhaPrint .pf-topo { display: flex; justify-content: space-between; align-items: center;
                             gap: 16px; min-height: 92px; padding-bottom: 14px; margin-bottom: 4px; }
      #folhaPrint .pf-marca { display: flex; align-items: center; gap: 64px; flex: 1; }
      /* O TÍTULO fica no centro exato da faixa, na mesma linha do meio do logo.
         O nome da empresa sai do fluxo (absoluto) para não empurrar o título
         para cima — era isso que deixava o conjunto parecendo desalinhado. */
      #folhaPrint .pf-marca > div { position: relative; display: flex; align-items: center;
                                    align-self: center; }
      #folhaPrint .pf-emp { position: absolute; top: calc(100% + 3px); left: 0;
                            white-space: nowrap; margin: 0; }
      #folhaPrint .pf-logo { height: 82px; width: auto; object-fit: contain; }
      #folhaPrint .pf-titulo { font-size: 18pt; font-weight: 800; letter-spacing: .05em;
                               line-height: 1.1; margin: 0; }
      #folhaPrint .pf-emp { font-size: 9.5pt; color: #555; }
      #folhaPrint .pf-ident { text-align: right; font-size: 10pt; line-height: 1.45;
                              max-width: 46%; word-break: break-word; }
      #folhaPrint .pf-ident strong { font-size: 12pt; }
      #folhaPrint .pf-regua { height: 4px; margin-bottom: 14px; }

      /* seções */
      #folhaPrint .pf-sec { break-inside: avoid; margin-bottom: 14px; }
      #folhaPrint .pf-sec > h2 { font-size: 10pt; text-transform: uppercase; letter-spacing: .08em;
                                 color: #fff; background: #4B5563; padding: 4px 9px; margin: 0 0 8px;
                                 border-radius: 3px; }
      #folhaPrint .pf-grade { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px 18px;
                              padding-bottom: 12px; border-bottom: 1.5px solid #9CA3AF; }
      #folhaPrint .pf-campo { font-size: 11.5pt;
        font-family: "Open Sans", Arial, "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif; }
      #folhaPrint .pf-campo span { display: block; font-size: 8.5pt; text-transform: uppercase;
                                   letter-spacing: .05em; color: #6B7280; }
      #folhaPrint .pf-texto { white-space: pre-wrap; font-size: 11.5pt; line-height: 1.6;
                              text-align: justify; margin: 0; }
      #folhaPrint table { width: 100%; border-collapse: collapse; font-size: 11pt; }
      #folhaPrint th { text-align: left; background: #F3F4F6; border: 1px solid #D1D5DB;
                       padding: 6px 9px; font-size: 9pt; text-transform: uppercase; letter-spacing: .04em; }
      #folhaPrint td { border: 1px solid #D1D5DB; padding: 7px 9px; vertical-align: top; }

      /* fotos */
      #folhaPrint .pf-fotos { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
      #folhaPrint .pf-foto { break-inside: avoid; border: 1px solid #D1D5DB; border-radius: 4px;
                             overflow: hidden; }
      #folhaPrint .pf-foto img { width: 100%; height: 68mm; object-fit: cover; display: block; }
      #folhaPrint .pf-foto figcaption { font-size: 9.5pt; padding: 6px 8px; color: #374151;
                                        border-top: 1px solid #E5E7EB; }

      /* assinaturas */
      #folhaPrint .pf-assin { display: grid; grid-template-columns: 1fr 1fr; gap: 40px;
                              margin-top: auto; padding-top: 26px; break-inside: avoid; }
      #folhaPrint .pf-assin div { text-align: center; }
      #folhaPrint .pf-assin img { height: 68px; object-fit: contain; display: block; margin: 0 auto 2px; }
      #folhaPrint .pf-assin .linha { border-top: 1px solid #333; padding-top: 4px; }
      #folhaPrint .pf-assin .nome { font-size: 11pt; font-weight: 700; }
      #folhaPrint .pf-assin .rot { font-size: 9pt; color: #6B7280; }

      #folhaPrint .pf-rodape { margin-top: 14px; padding-top: 7px; border-top: 1px solid #D1D5DB;
                               font-size: 8.5pt; color: #6B7280; display: flex;
                               justify-content: space-between; gap: 12px; }
      #folhaPrint .pf-rodape span { max-width: 48%; }

      /* margem de segurança: se a caixa de impressão vier com "sem margens",
         o texto ainda não encosta na borda do papel */
      #folhaPrint { padding: 14mm 12mm !important; box-sizing: border-box; }

      @page { margin: 16mm 14mm; }
    }
  </style>

  <script>
    const RDO = JSON.parse((document.getElementById("dadosRDO") as HTMLElement).textContent || "{}");
    const LISTAS = JSON.parse((document.getElementById("listasRDO") as HTMLElement).textContent || "{}");
    const msg = document.getElementById("msg") as HTMLElement;

    const esc = (s: any) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
    const opcoes = (lista: string[], atual: string) =>
      `<option value=""></option>` + lista.map((n) => `<option${n === atual ? " selected" : ""}>${esc(n)}</option>`).join("");

    function linhaOcor(i: any = {}) {
      return `<tr>
        <td><select name="tipo">${opcoes(LISTAS.tipos || [], i.tipo || "")}</select></td>
        <td><input name="descricao" value="${esc(i.descricao)}" placeholder="O que aconteceu e o efeito na obra"></td>
        <td><input name="horas" type="number" min="0" step="0.5" placeholder="—" value="${esc(i.horas ?? "")}"></td>
        <td class="nao-imprimir"><button type="button" class="lixo" onclick="this.closest('tr').remove()">🗑</button></td></tr>`;
    }
    function linhaCheck(i: any = {}) {
      const sits = ["ok", "nao", "na", "pendente"];
      const rot: Record<string, string> = { ok: "Conforme", nao: "Não conforme", na: "Não se aplica", pendente: "Pendente" };
      return `<tr>
        <td><input name="item" value="${esc(i.item)}" placeholder="Item verificado"></td>
        <td><select name="situacao">${sits.map((s) => `<option value="${s}"${(i.situacao || "pendente") === s ? " selected" : ""}>${rot[s]}</option>`).join("")}</select></td>
        <td><input name="observacao" value="${esc(i.observacao)}"></td>
        <td class="nao-imprimir"><button type="button" class="lixo" onclick="this.closest('tr').remove()">🗑</button></td></tr>`;
    }

    const CORPOS: Record<string, { el: string; fn: (i?: any) => string; dados: any[] }> = {
      ocor:  { el: "tbOcor",  fn: linhaOcor,  dados: RDO.ocorrencias || [] },
      check: { el: "tbCheck", fn: linhaCheck, dados: RDO.checklist || [] },
    };

    // "Nenhuma ocorrência": troca a lista por uma linha só, já preenchida —
    // dia tranquilo também é informação no relatório que vai ao cliente.
    document.getElementById("btnSemOcor")?.addEventListener("click", () => {
      document.getElementById("tbOcor")!.innerHTML = linhaOcor({ tipo: "Sem ocorrência", descricao: "Nada a registrar." });
    });

    // contador do campo principal, para quem escreve pelo celular saber que cabe texto
    const taAtiv = document.getElementById("taAtividades") as HTMLTextAreaElement | null;
    function contar() {
      const n = (taAtiv?.value || "").trim().length;
      document.getElementById("contAtiv")!.textContent = n ? `${n} caractere${n > 1 ? "s" : ""}` : "campo obrigatório para publicar";
    }
    taAtiv?.addEventListener("input", contar);

    // modelo de texto: ajuda quem trava na folha em branco
    const MODELO = [
      "Frentes em execução:",
      "- ",
      "",
      "Constatações:",
      "- ",
      "",
      "Providências solicitadas:",
      "- ",
    ].join("\n");
    document.getElementById("btnModelo")?.addEventListener("click", () => {
      if (!taAtiv) return;
      if (taAtiv.value.trim() && !confirm("Substituir o texto que já está escrito pelo modelo?")) return;
      taAtiv.value = MODELO;
      taAtiv.focus();
      contar();
    });

    function addLinha(qual: string) {
      const c = CORPOS[qual];
      document.getElementById(c.el)!.insertAdjacentHTML("beforeend", c.fn());
    }

    function ler(corpoId: string, campos: string[]) {
      return [...document.querySelectorAll(`#${corpoId} tr`)].map((tr) => {
        const o: Record<string, string> = {};
        for (const c of campos) {
          const el = tr.querySelector(`[name="${c}"]`) as HTMLInputElement | null;
          o[c] = el ? el.value : "";
        }
        return o;
      });
    }

    // trocar a empresa emissora já troca o cabeçalho de impressão, sem recarregar
    const selEmpresa = document.getElementById("selEmpresa") as HTMLSelectElement;
    function pintarCabecalho() {
      const e = (LISTAS.empresas || []).find((x: any) => x.v === selEmpresa.value);
      if (!e) return;
      (document.getElementById("folhaLogo") as HTMLImageElement).src = e.logo;
      document.getElementById("folhaEmpresa")!.textContent = e.cnpj ? `${e.nome} · CNPJ ${e.cnpj}` : e.nome;
      (document.getElementById("folhaTopo") as HTMLElement).style.borderColor = e.cor;
    }
    selEmpresa?.addEventListener("change", pintarCabecalho);

    // ── assinatura no dedo ────────────────────────────────────────────────
    // Um canvas por assinatura. O traço é guardado como PNG (data URL) e sai
    // no PDF como imagem; na tela, o canvas continua editável.
    const ASSIN: Record<string, { canvas: HTMLCanvasElement; img: HTMLImageElement; dados: string }> = {};

    function prepararAssinatura(campo: string, canvasId: string, imgId: string, inicial: string) {
      const canvas = document.getElementById(canvasId) as HTMLCanvasElement | null;
      const img = document.getElementById(imgId) as HTMLImageElement | null;
      if (!canvas || !img) return;
      const ctx = canvas.getContext("2d")!;
      ctx.lineWidth = 3.2; ctx.lineCap = "round"; ctx.lineJoin = "round"; ctx.strokeStyle = "#111827";
      ASSIN[campo] = { canvas, img, dados: inicial || "" };

      if (inicial) {
        const antiga = new Image();
        antiga.onload = () => ctx.drawImage(antiga, 0, 0, canvas.width, canvas.height);
        antiga.src = inicial;
        img.src = inicial;
      }

      let desenhando = false;
      const ponto = (ev: PointerEvent) => {
        const r = canvas.getBoundingClientRect();
        return { x: (ev.clientX - r.left) * (canvas.width / r.width),
                 y: (ev.clientY - r.top) * (canvas.height / r.height) };
      };
      canvas.addEventListener("pointerdown", (ev) => {
        ev.preventDefault();
        desenhando = true; canvas.setPointerCapture(ev.pointerId);
        const p = ponto(ev); ctx.beginPath(); ctx.moveTo(p.x, p.y);
      });
      canvas.addEventListener("pointermove", (ev) => {
        if (!desenhando) return;
        ev.preventDefault();
        const p = ponto(ev); ctx.lineTo(p.x, p.y); ctx.stroke();
      });
      const soltar = () => {
        if (!desenhando) return;
        desenhando = false;
        ASSIN[campo].dados = canvas.toDataURL("image/png");
        img.src = ASSIN[campo].dados;
        marcarAssinaturas();
      };
      canvas.addEventListener("pointerup", soltar);
      canvas.addEventListener("pointerleave", soltar);
      canvas.addEventListener("pointercancel", soltar);
    }

    function marcarAssinaturas() {
      const n = Object.values(ASSIN).filter((a) => a.dados).length;
      const el = document.getElementById("statusAssin");
      if (el) el.textContent = n ? `${n} de 2 assinada(s) — lembre de salvar` : "";
    }

    document.querySelectorAll("[data-limpar]").forEach((b) =>
      b.addEventListener("click", () => {
        const campo = (b as HTMLElement).dataset.limpar!;
        const a = ASSIN[campo]; if (!a) return;
        a.canvas.getContext("2d")!.clearRect(0, 0, a.canvas.width, a.canvas.height);
        a.dados = ""; a.img.removeAttribute("src");
        marcarAssinaturas();
      }));

    prepararAssinatura("visita", "assinVisita", "imgAssinVisita", RDO.assinaturas?.visita || "");
    prepararAssinatura("cliente", "assinCliente", "imgAssinCliente", RDO.assinaturas?.cliente || "");
    marcarAssinaturas();

    async function salvar(status: string) {
      const f = document.getElementById("f") as HTMLFormElement;
      const corpo: Record<string, unknown> = { status };
      for (const [k, v] of new FormData(f).entries()) corpo[k] = v;
      corpo.ocorrencias_itens = ler("tbOcor", ["tipo", "descricao", "horas"]);
      corpo.assinatura_visita = ASSIN.visita?.dados || "";
      corpo.assinatura_cliente = ASSIN.cliente?.dados || "";
      if (document.getElementById("tbCheck")) corpo.checklist = ler("tbCheck", ["item", "situacao", "observacao"]);

      const btns = [document.getElementById("btnSalvar"), document.getElementById("btnPublicar")] as HTMLButtonElement[];
      btns.forEach((b) => b && (b.disabled = true));
      try {
        const r = await fetch(`/api/admin/obras/diario/${RDO.id}`, {
          method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify(corpo),
        });
        const j = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(j?.error || "Não deu para salvar.");
        const b = document.getElementById("badgeStatus")!;
        b.textContent = status === "publicado" ? "Publicado" : "Rascunho";
        b.className = `badge ${status === "publicado" ? "badge-green" : "badge-yellow"}`;
        msg.innerHTML = `<div class="alert alert-success">Relatório salvo${status === "publicado" ? " e publicado" : ""}.</div>`;
        setTimeout(() => { msg.innerHTML = ""; }, 4000);
      } catch (e: any) {
        msg.innerHTML = `<div class="alert alert-error">${e.message}</div>`;
      } finally {
        btns.forEach((b) => b && (b.disabled = false));
      }
    }

    // ── fotos: URL assinada → PUT direto no bucket → registra no banco ──
    async function subirFoto(arq: File) {
      const r1 = await fetch("/api/admin/obras/diario/fotos/upload-url", {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ rdo_id: RDO.id, nome: arq.name }),
      });
      const d1 = await r1.json();
      if (!r1.ok) throw new Error(d1?.error || "Não deu para preparar o envio.");
      const r2 = await fetch(d1.signed_url, { method: "PUT", headers: { "content-type": arq.type || "image/jpeg" }, body: arq });
      if (!r2.ok) throw new Error("Falha ao enviar a foto.");
      const r3 = await fetch("/api/admin/obras/diario/fotos", {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ rdo_id: RDO.id, storage_path: d1.path, nome_arquivo: d1.nome_original, content_type: arq.type, tamanho: arq.size }),
      });
      const d3 = await r3.json();
      if (!r3.ok) throw new Error(d3?.error || "Não deu para registrar a foto.");
      return d3;
    }

    // O cartão da foto nasce com as medidas NO PRÓPRIO ELEMENTO.
    // Só CSS não bastava: a folha de estilo da página é escopada pelo Astro e
    // não alcança o que o JavaScript cria, e a foto entrava do tamanho original
    // — ocupando a tela inteira até recarregar a página.
    function cartaoFoto(id: string, legenda = "") {
      const fig = document.createElement("figure");
      fig.className = "foto";
      fig.dataset.id = id;
      fig.style.cssText = "margin:0;border:1px solid #E5E7EB;border-radius:10px;overflow:hidden;background:#fff;min-width:0";

      const img = document.createElement("img");
      img.src = `/api/admin/obras/diario/fotos/${id}`;
      img.alt = legenda;
      img.style.cssText = "width:100%;height:150px;object-fit:cover;display:block";

      const cap = document.createElement("figcaption");
      cap.style.cssText = "display:flex;gap:6px;align-items:center;padding:8px";

      const inp = document.createElement("input");
      inp.className = "legenda";
      inp.value = legenda;
      inp.placeholder = "Legenda da foto";
      inp.dataset.id = id;
      inp.style.cssText = "flex:1;min-width:0;font-size:12.5px;padding:6px 8px";

      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "btn-remover nao-imprimir";
      btn.dataset.id = id;
      btn.title = "Remover";
      btn.textContent = "✕";
      btn.style.cssText = "background:none;border:0;color:#B91C1C;cursor:pointer;font-size:13px;padding:4px 6px";

      cap.append(inp, btn);
      fig.append(img, cap);
      return fig;
    }

    // Enquanto um envio está em andamento, o próximo é ignorado: dois toques
    // seguidos no botão registravam a MESMA foto duas vezes no relatório.
    let enviando = false;

    (document.getElementById("inpFotos") as HTMLInputElement).addEventListener("change", async (ev) => {
      const alvo = ev.target as HTMLInputElement;
      const arqs = [...(alvo.files || [])];
      if (!arqs.length) return;
      if (enviando) { alvo.value = ""; return; }
      enviando = true;
      msg.innerHTML = `<div class="alert alert-info">Enviando ${arqs.length} foto(s)…</div>`;
      const falhas: string[] = [];
      for (const a of arqs) {
        try {
          const nova = await subirFoto(a);
          if (document.querySelector(`#galeria .foto[data-id="${nova.id}"]`)) continue;
          document.getElementById("galeria")!.appendChild(cartaoFoto(nova.id));
        } catch (e: any) {
          // a mensagem real aparece na tela: sem isso um envio que falha vira
          // "não subiu" e ninguém sabe o motivo
          falhas.push(`${a.name}: ${e?.message || e}`);
          console.error("[foto]", a.name, e);
        }
      }
      alvo.value = "";
      const q = document.querySelectorAll("#galeria .foto").length;
      document.getElementById("qtdFotos")!.textContent = String(q);
      if (falhas.length) {
        msg.innerHTML = `<div class="alert alert-error"><strong>${falhas.length} foto(s) não subiram.</strong>` +
          `<div style="font-size:12px;margin-top:6px">${falhas.map((t) => esc(t)).join("<br>")}</div></div>`;
      } else {
        msg.innerHTML = `<div class="alert alert-success">Foto(s) enviada(s).</div>`;
        setTimeout(() => { msg.innerHTML = ""; }, 4000);
      }
      enviando = false;
    });

    // legenda salva ao sair do campo; remover pede confirmação
    document.addEventListener("change", async (ev) => {
      const el = (ev.target as HTMLElement)?.closest?.(".legenda") as HTMLInputElement | null;
      if (!el) return;
      await fetch(`/api/admin/obras/diario/fotos/${el.dataset.id}`, {
        method: "PATCH", headers: { "content-type": "application/json" },
        body: JSON.stringify({ legenda: el.value }),
      });
      el.style.borderColor = "#16A34A";
      setTimeout(() => { el.style.borderColor = ""; }, 1200);
    });

    document.addEventListener("click", async (ev) => {
      const b = (ev.target as HTMLElement)?.closest?.(".btn-remover") as HTMLElement | null;
      if (!b) return;
      if (!confirm("Remover esta foto do relatório?")) return;
      const r = await fetch(`/api/admin/obras/diario/fotos/${b.dataset.id}`, {
        method: "DELETE", headers: { "content-type": "application/json" },
      });
      if (r.ok) {
        b.closest(".foto")!.remove();
        document.getElementById("qtdFotos")!.textContent = String(document.querySelectorAll("#galeria .foto").length);
      }
    });

    // desenha as listas ao abrir; começa com uma linha em branco quando vazio
    for (const [, c] of Object.entries(CORPOS)) {
      const corpo = document.getElementById(c.el);
      if (!corpo) continue;   // checklist não existe na área de Fundação
      corpo.innerHTML = (c.dados.length ? c.dados : [{}]).map((i: any) => c.fn(i)).join("");
    }
    pintarCabecalho();
    contar();

    // somente leitura: trava tudo o que é campo, some o que é ação de edição
    if (RDO.importado) {
      document.querySelectorAll("#folha input, #folha select, #folha textarea").forEach((el) => {
        (el as HTMLInputElement).readOnly = true;
        (el as HTMLInputElement).disabled = el instanceof HTMLSelectElement;
        (el as HTMLElement).style.pointerEvents = "none";
        (el as HTMLElement).style.background = "transparent";
      });
      document.querySelectorAll(".lixo, .btn-remover, #btnModelo, #btnSemOcor, [onclick*='addLinha'], #inpFotos")
        .forEach((el) => ((el as HTMLElement).closest("label, button") || el as HTMLElement).remove?.());
      document.querySelectorAll(".assin canvas, [data-limpar]").forEach((el) => (el as HTMLElement).remove());
    }

    // ── nome do arquivo do PDF ─────────────────────────────────────────────
    // O Chrome (e o Edge) sugerem o TÍTULO DA PÁGINA como nome do arquivo em
    // "Salvar como PDF". Trocamos o título antes de imprimir e devolvemos
    // depois, para a aba não ficar com nome de arquivo.
    function limpo(t: string) {
      return String(t || "")
        .replace(/[\\/:*?"<>|]/g, "-")   // proibidos em nome de arquivo
        .replace(/\s+/g, " ")
        .trim();
    }

    function nomeDoArquivo() {
      // AAMMDD: nome curto e que ordena sozinho por data na pasta
      const iso = String(P.dataIso || "");
      const data = iso.length === 10 ? iso.slice(2).replace(/-/g, "") : iso;
      const partes = [data, "RV", limpo(P.cliente), limpo(P.obra)].filter(Boolean);
      return partes.join("_");
    }

    const tituloDaAba = document.title;
    window.addEventListener("afterprint", () => { document.title = tituloDaAba; });

    // ── folha do PDF montada na hora ───────────────────────────────────────
    // Cada valor da tela vira texto na folha. Campo vazio não entra: é isso que
    // tira as páginas em branco e a caixa de formulário do documento que vai
    // para o cliente.
    const P = RDO.papel || {};

    // As fotos ficam num depósito privado e chegam por link assinado. Numa folha
    // nova o navegador precisaria buscar cada uma de novo — e a caixa de
    // impressão abre antes de elas chegarem, que é o motivo de saírem em branco.
    // Aqui elas são baixadas UMA vez e embutidas na própria folha.
    const CACHE_FOTO: Record<string, string> = {};

    async function embutirFotos() {
      const imgs = [...document.querySelectorAll("#galeria .foto img")] as HTMLImageElement[];
      await Promise.all(imgs.map(async (img) => {
        if (CACHE_FOTO[img.src]) return;
        try {
          // ?bytes=1: a imagem vem do próprio portal (mesma origem). Buscar o
          // link do depósito direto é bloqueado pelo navegador.
          const url = img.src + (img.src.includes("?") ? "&" : "?") + "bytes=1";
          const r = await fetch(url, { credentials: "same-origin" });
          if (!r.ok) return;
          const blob = await r.blob();
          CACHE_FOTO[img.src] = await new Promise<string>((ok, falhou) => {
            const fr = new FileReader();
            fr.onload = () => ok(String(fr.result));
            fr.onerror = falhou;
            fr.readAsDataURL(blob);
          });
        } catch { /* segue com o link normal — melhor foto tardia que nenhuma */ }
      }));
    }

    const valDe = (n: string) => {
      const el = document.querySelector(`[name="${n}"]`) as HTMLInputElement | HTMLSelectElement | null;
      if (!el) return "";
      if (el instanceof HTMLSelectElement) return (el.selectedOptions[0]?.textContent || "").trim();
      return (el.value || "").trim();
    };

    const campo = (rot: string, v: string) =>
      v ? `<div class="pf-campo"><span>${esc(rot)}</span>${esc(v)}</div>` : "";

    const secao = (titulo: string, corpo: string) =>
      corpo ? `<section class="pf-sec"><h2>${esc(titulo)}</h2>${corpo}</section>` : "";

    function montarFolha() {
      // filha direta do body: é o que permite esconder todo o resto sem
      // depender das classes do layout
      const folha = document.getElementById("folhaPrint")!;
      if (folha.parentElement !== document.body) document.body.appendChild(folha);

      const empSel = (LISTAS.empresas || []).find((e: any) => e.v === selEmpresa.value) || {};
      const cor = empSel.cor || "#C41E3A";

      const cond = [
        // o ícone vem junto ("☀️ Sol"): dá leitura imediata no papel
        campo("Clima pela manhã", valDe("clima_manha")),
        campo("Clima à tarde", valDe("clima_tarde")),
        campo("Condição de trabalho", valDe("condicao")),
        campo("Início da visita", valDe("inicio_jornada")),
        campo("Fim da visita", valDe("fim_jornada")),
        campo("Responsável pela visita", valDe("responsavel")),
      ].join("");

      const ocor = ler("tbOcor", ["tipo", "descricao", "horas"]).filter((o) => o.tipo || o.descricao);
      const tabOcor = ocor.length
        ? `<table><thead><tr><th style="width:28%">Tipo</th><th>Descrição</th><th style="width:15%">Horas paradas</th></tr></thead>
           <tbody>${ocor.map((o) => `<tr><td>${esc(o.tipo)}</td><td>${esc(o.descricao)}</td><td>${esc(o.horas || "—")}</td></tr>`).join("")}</tbody></table>`
        : "";

      const check = document.getElementById("tbCheck")
        ? ler("tbCheck", ["item", "situacao", "observacao"]).filter((c) => c.item) : [];
      const rotSit: Record<string, string> = { ok: "Conforme", nao: "Não conforme", na: "Não se aplica", pendente: "Pendente" };
      const tabCheck = check.length
        ? `<table><thead><tr><th style="width:45%">Item</th><th style="width:18%">Situação</th><th>Observação</th></tr></thead>
           <tbody>${check.map((c) => `<tr><td>${esc(c.item)}</td><td>${esc(rotSit[c.situacao] || c.situacao)}</td><td>${esc(c.observacao)}</td></tr>`).join("")}</tbody></table>`
        : "";

      const fotos = [...document.querySelectorAll("#galeria .foto")].map((f) => {
        const img = f.querySelector("img") as HTMLImageElement;
        const leg = (f.querySelector(".legenda") as HTMLInputElement)?.value || "";
        const src = CACHE_FOTO[img.src] || img.src;
        return `<figure class="pf-foto"><img src="${src}" loading="eager">${leg ? `<figcaption>${esc(leg)}</figcaption>` : ""}</figure>`;
      });

      const assinatura = (chave: string, rot: string, nomeCampo: string) => {
        const dados = ASSIN[chave]?.dados || "";
        const nome = valDe(nomeCampo);
        return `<div>
          ${dados ? `<img src="${dados}">` : `<div style="height:60px"></div>`}
          <div class="linha"><div class="nome">${nome ? esc(nome) : "&nbsp;"}</div><div class="rot">${esc(rot)}</div></div>
        </div>`;
      };

      const atividades = valDe("atividades");
      const observacoes = valDe("observacoes");

      document.getElementById("folhaPrint")!.innerHTML = `
        <div class="pf-topo" style="border-bottom:2px solid ${cor}">
          <div class="pf-marca" style="display:flex;align-items:center;gap:64px">
            ${empSel.logo ? `<img class="pf-logo" src="${empSel.logo}" onerror="this.style.display='none'">` : ""}
            <div>
              <h1 class="pf-titulo" style="color:${cor}">RELATÓRIO DE VISITA</h1>
              <div class="pf-emp">${esc(empSel.nome || "")}${empSel.cnpj ? ` · CNPJ ${esc(empSel.cnpj)}` : ""}</div>
            </div>
          </div>
          <div class="pf-ident">
            <strong>${esc(P.obra || "")}</strong>${P.codigo ? ` (${esc(P.codigo)})` : ""}<br>
            ${P.cliente ? `Cliente: ${esc(P.cliente)}<br>` : ""}
            ${P.endereco ? `${esc(P.endereco)}<br>` : ""}
            <strong>${esc(P.data || "")}</strong> — ${esc(P.dataExtenso || "")}
          </div>
        </div>
        <div class="pf-regua" style="background:${cor}"></div>

        ${secao("Condições da visita", cond ? `<div class="pf-grade">${cond}</div>` : "")}
        ${secao("Serviços verificados", atividades ? `<p class="pf-texto">${esc(atividades)}</p>` : "")}
        ${secao("Ocorrências", tabOcor)}
        ${secao("Checklist", tabCheck)}
        ${secao("Observações e recomendações", observacoes ? `<p class="pf-texto">${esc(observacoes)}</p>` : "")}
        ${secao(`Registro fotográfico (${fotos.length})`, fotos.length ? `<div class="pf-fotos">${fotos.join("")}</div>` : "")}

        <div class="pf-assin">
          ${assinatura("visita", "Responsável pela visita", "assinatura_visita_nome")}
          ${assinatura("cliente", "Responsável pela obra / Cliente", "assinatura_cliente_nome")}
        </div>

        <div class="pf-rodape">
          <span>${esc(empSel.nome || "")}</span>
          <span>${esc(P.area || "")} · Relatório ${esc(P.numero || "")} · ${esc(P.data || "")}</span>
        </div>`;
    }

    document.getElementById("btnImprimir")!.addEventListener("click", async (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      const rotulo = btn.textContent;
      btn.disabled = true; btn.textContent = "Preparando…";
      try {
        await embutirFotos();
        montarFolha();
        document.title = nomeDoArquivo();
        // um respiro para o navegador desenhar antes de abrir a caixa
        await new Promise((r) => setTimeout(r, 150));
        window.print();
      } finally {
        btn.disabled = false; btn.textContent = rotulo;
      }
    });
    // Ctrl+P: monta com o que já estiver em cache (sem esperar rede)
    window.addEventListener("beforeprint", () => {
      montarFolha();
      document.title = nomeDoArquivo();
    });

    Object.assign(window, { addLinha, salvar, montarFolha });
  </script>
</Admin>
