---
// Casca compartilhada das páginas públicas da CR (home + os três formulários).
//
// Existe para que fonte, cor, cabeçalho e rodapé venham de UM lugar só: quando
// a Adriana pedir um ajuste de identidade, muda aqui e as quatro páginas mudam
// juntas. Nada de layout do admin entra aqui — estas páginas são vistas por
// gente de fora e não podem arrastar menu, sessão nem scripts internos.
//
// Identidade: claro e sofisticado. Serifada de display (Cormorant) para os
// títulos, sem-serifa neutra (Inter) para o resto, dourado só como acento e
// muito espaço em branco. NENHUMA menção à Costa Júnior.
import { INTERMEDIARIO, CONTATO_EMAIL, CONTATO_TELEFONE } from "../lib/termoVenda";

interface Props {
  titulo: string;
  descricao?: string;
  /** true na home: o cabeçalho some e o logo aparece grande dentro da capa */
  capa?: boolean;
  noindex?: boolean;
}
const { titulo, descricao = "Intermediação de venda de terrenos e empreendimentos, busca de imóveis e oportunidades para investidores.", capa = false, noindex = false } = Astro.props;
const WHATS = CONTATO_TELEFONE.replace(/\D/g, "");
const ANO = new Date().getFullYear();
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <link rel="canonical" href="https://crintermediacao.com.br/" />
  <link rel="icon" href="/cr-monograma.svg" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  <meta property="og:image" content="https://crintermediacao.com.br/logo-cr-transp.png" />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --areia:#FBF9F7; --papel:#FFFFFF; --tinta:#26222B; --tinta-md:#5C5563; --tinta-cl:#8E8695;
      --ouro:#A8842A; --ouro-cl:#D9B95F; --ouro-pale:#F3EBD8;
      --linha:#EAE4EC; --lilas:#6F6280;
      --serif:'Cormorant Garamond',Georgia,serif; --sans:'Inter',system-ui,Arial,sans-serif;
      --raio:14px;
    }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { margin:0; background:var(--areia); color:var(--tinta); font-family:var(--sans);
           font-size:16px; line-height:1.65; -webkit-font-smoothing:antialiased; }
    a { color:inherit; }
    img { max-width:100%; }
    .wrap { max-width:1080px; margin:0 auto; padding:0 24px; }
    .estreito { max-width:760px; margin:0 auto; padding:0 24px; }

    /* ── tipografia ── */
    h1,h2,h3 { font-family:var(--serif); font-weight:500; letter-spacing:-.01em; margin:0; }
    h1 { font-size:clamp(2.1rem,5vw,3.4rem); line-height:1.12; }
    h2 { font-size:clamp(1.7rem,3.4vw,2.4rem); line-height:1.2; }
    h3 { font-size:1.18rem; }
    p { margin:0 0 1rem; }
    .rotulo { font-family:var(--sans); font-size:.7rem; font-weight:600; letter-spacing:.22em;
              text-transform:uppercase; color:var(--ouro); margin:0 0 14px; }
    .lead { font-size:1.06rem; color:var(--tinta-md); }
    .centro { text-align:center; }

    /* ── cabeçalho ── */
    .topo { position:sticky; top:0; z-index:30; background:rgba(255,254,252,.94);
            backdrop-filter:blur(12px); border-bottom:1px solid var(--linha);
            box-shadow:0 1px 0 rgba(168,132,42,.16), 0 6px 22px rgba(30,24,38,.05); }
    .topo .wrap { display:flex; align-items:center; gap:16px; height:78px; }
    .topo .marca { display:flex; align-items:center; gap:13px; text-decoration:none; }
    .topo .marca img { width:52px; height:52px; }
    .topo .marca b { font-family:var(--serif); font-size:1.3rem; font-weight:600; letter-spacing:.02em; line-height:1.1; }
    .topo .marca span { display:block; font-size:.56rem; letter-spacing:.22em; text-transform:uppercase;
                        color:var(--tinta-cl); font-family:var(--sans); font-weight:500; }
    .navlinks { margin-left:auto; display:flex; gap:26px; align-items:center; font-size:.88rem; }
    .navlinks a { text-decoration:none; color:var(--tinta-md); }
    .navlinks a:hover { color:var(--ouro); }
    @media (max-width:900px) { .navlinks { display:none; } .topo .marca img { width:44px; height:44px; } }

    /* ── botões ── */
    .btn { display:inline-flex; align-items:center; justify-content:center; gap:8px;
           padding:13px 26px; border-radius:999px; text-decoration:none; border:1px solid transparent;
           font-size:.92rem; font-weight:500; cursor:pointer; font-family:var(--sans);
           transition:transform .15s ease, box-shadow .15s ease, background .15s ease; }
    .btn-ouro { background:linear-gradient(135deg,#C9A63F,#A8842A); color:#fff;
                box-shadow:0 6px 20px rgba(168,132,42,.24); }
    .btn-ouro:hover { transform:translateY(-1px); box-shadow:0 10px 26px rgba(168,132,42,.3); }
    .btn-linha { border-color:var(--linha); background:var(--papel); color:var(--tinta); }
    .btn-linha:hover { border-color:var(--ouro-cl); color:var(--ouro); }
    .btn[disabled] { opacity:.5; cursor:not-allowed; transform:none; }

    /* ── blocos ── */
    section { padding:86px 0; }
    .cartao { background:var(--papel); border:1px solid var(--linha); border-radius:var(--raio);
              padding:30px; }
    .filete { width:44px; height:1px; background:var(--ouro-cl); margin:18px auto 26px; }

    /* ── revelar ao rolar ── */
    .rev { opacity:0; transform:translateY(16px); transition:opacity .7s ease, transform .7s ease; }
    .rev.on { opacity:1; transform:none; }
    @media (prefers-reduced-motion:reduce) { .rev { opacity:1; transform:none; transition:none; } }

    /* ── formulários (usados pelas 3 páginas de cadastro) ── */
    label { display:block; font-size:.82rem; font-weight:500; color:var(--tinta-md); margin:0 0 6px; }
    input, select, textarea { width:100%; padding:12px 14px; border:1px solid var(--linha);
      border-radius:10px; font-size:.95rem; font-family:inherit; background:var(--papel);
      color:var(--tinta); outline:none; transition:border-color .15s ease, box-shadow .15s ease; }
    input:focus, select:focus, textarea:focus { border-color:var(--ouro-cl); box-shadow:0 0 0 4px rgba(168,132,42,.1); }
    .linha-campos { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:14px; margin-bottom:14px; }
    .campo { margin-bottom:14px; }
    .obr::after { content:" *"; color:var(--ouro); }
    .aviso { padding:13px 16px; border-radius:10px; margin:16px 0; font-size:.92rem; display:none; }
    .erro { background:#FDECEC; color:#8E1F1F; border:1px solid #F6CFCF; }
    .ok   { background:#E9F7EE; color:#1C5E33; border:1px solid #C4E8D2; }
    .lgpd { font-size:.79rem; color:var(--tinta-cl); }

    /* ── rodapé ── */
    .rodape { border-top:1px solid var(--linha); padding:44px 0 54px; background:var(--papel); }
    .rodape .wrap { display:flex; flex-wrap:wrap; gap:24px; align-items:center; justify-content:space-between; }
    .rodape a { text-decoration:none; color:var(--tinta-md); }
    .rodape a:hover { color:var(--ouro); }
    .mini { font-size:.8rem; color:var(--tinta-cl); }
  </style>
</head>
<body>
  <header class="topo">
      <div class="wrap">
        <a class="marca" href="/">
          <img src="/logo-cr-transp.png" alt="" />
          <b>CR<span>Intermediações Imobiliárias</span></b>
        </a>
        <nav class="navlinks">
          <a href="/#linhas">O que fazemos</a>
          <a href="/cr">Vender meu imóvel</a>
          <a href="/investidor">Investir</a>
          <a href="/procuro">Procuro imóvel</a>
          <a class="btn btn-linha" style="padding:9px 18px" href={`https://wa.me/${WHATS}`} target="_blank" rel="noopener">WhatsApp</a>
        </nav>
      </div>
  </header>

  <slot />

  <footer class="rodape">
    <div class="wrap">
      <div>
        <strong style="font-family:var(--serif);font-size:1.1rem">{INTERMEDIARIO}</strong>
        <div class="mini">Terrenos · Empreendimentos · Busca de imóveis · Investidores</div>
      </div>
      <div class="mini" style="text-align:right">
        <div><a href={`https://wa.me/${WHATS}`} target="_blank" rel="noopener">{CONTATO_TELEFONE}</a></div>
        <div><a href={`mailto:${CONTATO_EMAIL}`}>{CONTATO_EMAIL}</a></div>
        <div style="margin-top:6px">© {ANO}</div>
      </div>
    </div>
  </footer>

  <script>
    // revelar seções ao rolar — puro enfeite; se o navegador não suportar,
    // o CSS de prefers-reduced-motion já deixa tudo visível
    const alvos = document.querySelectorAll(".rev");
    if ("IntersectionObserver" in window && alvos.length) {
      const io = new IntersectionObserver((ents) => {
        for (const e of ents) if (e.isIntersecting) { e.target.classList.add("on"); io.unobserve(e.target); }
      }, { rootMargin: "0px 0px -12% 0px" });
      alvos.forEach((el) => io.observe(el));
    } else {
      alvos.forEach((el) => el.classList.add("on"));
    }
  </script>
</body>
</html>
